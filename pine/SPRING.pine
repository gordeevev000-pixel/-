//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SPRING · движок отскоков — всё в одном индикаторе, исполнение под 1 минуту
//
//  Score = 100 · gain · G · ( 0.20·S + 0.22·P + 0.28·R + 0.13·I + 0.17·N )
//
//    S — растяжение от средней, одновременно в σ и в ATR
//    P — истощение: климакс объёма + затухание импульса + хвост свечи
//    R — возврат: свип уровня и реклейм  ← ТРИГГЕР, считается строго по текущему бару
//    I — дивергенция: RSI + дельта объёма (CVD) + коррелирующий инструмент
//    N — уровни: конфлюэнс в допуске 0.28 ATR
//    G — режим: множитель 0…1, гасит сетапы против сильного тренда и в разгоне волы
//
//  Контекст копится на экстремуме, триггер приходит позже, поэтому S/P/I/N берутся
//  как максимум за окно контекста, а R — только по текущему бару. Если требовать
//  совпадения всего на одном баре, сигналов не будет вообще.
//
//  Состояния: FLAT → WATCH → ARMED → TRIGGER.
//  ARMED означает «контекст готов, идеальный возврат прямо сейчас дал бы вход».
//
//  Бывшая стратегия SPRING S встроена сюда: лонги/шорты по отдельности, вход по рынку
//  или лимиткой на ретесте, размер от депозита и риска, стоп, T1, T2, тайм-стоп.
//  Для 1 минуты добавлены фильтр сессии, пропуск открытия, выход в конце сессии
//  и фильтр издержек — на коротком стопе комиссия и проскальзывание съедают R.
//
//  Сделки ведут два независимых симулятора. Боевой берёт только сигналы от порога
//  входа — из него стрелки, план, алерты и отчёт. Калибровочный берёт всё от нижнего
//  порога и нужен только для таблицы калибровки, поэтому боевые сигналы не глушит.
//
//  Порог входа 70 — не из головы: см. таблицу калибровки. Прогоните её на своём
//  инструменте. Если винрейт и средний R не растут вместе со скором — на этом
//  инструменте модель не работает, какой бы стройной она ни была.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("SPRING · движок отскоков", "SPRING", overlay = false, max_labels_count = 50)

// ── входные параметры ──────────────────────────────────────────────────────────
gCore = "Ядро"
meanLen   = input.int(20, "Средняя, к которой возвращается цена", minval = 3, group = gCore)
meanType  = input.string("EMA", "Тип средней", options = ["EMA", "SMA", "VWMA"], group = gCore)
atrLen    = input.int(14, "ATR", minval = 2, group = gCore)
ctxLen    = input.int(12, "Окно контекста (максимум S/P/I/N)", minval = 1, group = gCore)
gain      = input.float(1.22, "gain — нормировка скора", minval = 0.5, maxval = 3.0, step = 0.01, group = gCore)
thrEntry  = input.float(70.0, "Порог входа", minval = 1, maxval = 100, step = 0.5, group = gCore)
thrWatch  = input.float(55.0, "Порог наблюдения", minval = 1, maxval = 100, step = 0.5, group = gCore)
confirmed = input.bool(true, "Сигналы только по закрытым барам", group = gCore,
     tooltip = "Выключить — сигнал появится внутри формирующегося бара и может исчезнуть. На 1 минуте лучше не выключать.")

gExe = "Исполнение"
useLong     = input.bool(true, "Лонги", group = gExe, inline = "side")
useShort    = input.bool(true, "Шорты", group = gExe, inline = "side")
useRetest   = input.bool(false, "Входить лимиткой на ретесте, а не по рынку", group = gExe,
     tooltip = "Лимитка ставится на уровень «стоп ∓ 0.3 ATR» и живёт заданное число баров. На 1 минуте риск такой сделки — пара тиков, её часто отсекает фильтр издержек.")
retestLife  = input.int(3, "Время жизни лимитки, баров", minval = 1, group = gExe)
deposit     = input.float(100000, "Депозит, в валюте инструмента", minval = 1, group = gExe)
riskPct     = input.float(0.5, "Риск на сделку, % депозита", minval = 0.01, step = 0.05, group = gExe,
     tooltip = "Размер позиции считается от расстояния до стопа, а не фиксированным лотом.")
scaleBySize = input.bool(true, "Масштабировать размер скором (скор / риск в ATR)", group = gExe)
lotStep     = input.float(1.0, "Шаг лота (он же минимум)", minval = 0.00000001, step = 0.001, group = gExe,
     tooltip = "Фьючерсы — 1 контракт. Крипта — шаг биржи, например 0.001. Если расчётный размер меньше шага, берётся один шаг, и реальный риск в плане будет больше заданного.")

gCost = "Издержки"
costTicks = input.float(2.0, "Комиссия и проскальзывание, тиков на сделку", minval = 0, step = 0.5, group = gCost)
commPct   = input.float(0.0, "Комиссия, % от цены за круг", minval = 0, step = 0.01, group = gCost,
     tooltip = "Для крипты и акций с процентной комиссией: вход + выход. Тейкер 0.04% за сторону — это 0.08.")
maxCost   = input.float(0.25, "Не входить, если издержки больше доли риска", minval = 0, maxval = 1, step = 0.05, group = gCost,
     tooltip = "На 1 минуте стоп — несколько тиков, и издержки съедают заметную часть R. 0.25 — сделка пропускается, если комиссия и проскальзывание больше четверти риска. 0 — фильтр выключен.")

gSess = "Сессия"
useSess  = input.bool(false, "Входить только в торговую сессию", group = gSess)
sessStr  = input.session("0930-1600", "Сессия", group = gSess)
sessTz   = input.string("America/New_York", "Часовой пояс сессии", group = gSess,
     tooltip = "Индексы и акции США — 0930-1600, America/New_York. MOEX — 1000-1850, Europe/Moscow. Крипте фильтр обычно не нужен.")
skipOpen = input.int(0, "Пропустить первые N баров сессии", minval = 0, group = gSess,
     tooltip = "Первые минуты после открытия — разгон объёма и волатильности, P и G там врут. На 1 минуте разумно 3–5. Без фильтра сессии отсчёт идёт от начала торгового дня.")
flatEnd  = input.bool(true, "Закрывать позицию при выходе из сессии", group = gSess)

gPlan = "План сделки"
stopLen    = input.int(5, "Окно свинга для стопа", minval = 1, group = gPlan)
stopATR    = input.float(0.50, "Запас за свинг, ATR", minval = 0, step = 0.05, group = gPlan)
t2R        = input.float(2.60, "Цель T2, в R", minval = 0.2, step = 0.1, group = gPlan)
retestATR  = input.float(0.30, "Лимитка на ретесте: от стопа, ATR", minval = 0, step = 0.05, group = gPlan)
minRR      = input.float(0.50, "Минимальный R:R до T1", minval = 0, step = 0.05, group = gPlan)
maxBars    = input.int(12, "Тайм-стоп, баров", minval = 1, group = gPlan)
cooldown   = input.int(3, "Пауза после сделки, баров", minval = 0, group = gPlan)
useT2      = input.bool(false, "Половина на T1, остаток на T2 (стоп в безубыток)", group = gPlan)

gW = "Веса компонентов"
wS = input.float(0.20, "S · растяжение", minval = 0, maxval = 1, step = 0.01, group = gW)
wP = input.float(0.22, "P · истощение",  minval = 0, maxval = 1, step = 0.01, group = gW)
wR = input.float(0.28, "R · возврат",    minval = 0, maxval = 1, step = 0.01, group = gW)
wI = input.float(0.13, "I · дивергенция",minval = 0, maxval = 1, step = 0.01, group = gW)
wN = input.float(0.17, "N · уровни",     minval = 0, maxval = 1, step = 0.01, group = gW)

gS = "S · растяжение"
sFullZ = input.float(2.5, "Полное растяжение, σ",   minval = 0.2, step = 0.1, group = gS)
sFullA = input.float(2.5, "Полное растяжение, ATR", minval = 0.2, step = 0.1, group = gS)

gP = "P · истощение"
volLen   = input.int(20, "Окно среднего объёма", minval = 2, group = gP)
volFull  = input.float(2.5, "Климакс объёма, × среднего", minval = 1.1, step = 0.1, group = gP)
fadeLen  = input.int(8, "Окно затухания импульса", minval = 2, group = gP)
pwVol    = input.float(0.42, "Вес климакса объёма", minval = 0, maxval = 1, step = 0.01, group = gP)
pwFade   = input.float(0.30, "Вес затухания",       minval = 0, maxval = 1, step = 0.01, group = gP)
pwWick   = input.float(0.28, "Вес хвоста",          minval = 0, maxval = 1, step = 0.01, group = gP)

gR = "R · возврат (триггер)"
sweepLen   = input.int(10, "Окно свипа ликвидности", minval = 2, group = gR)
pierceATR  = input.float(0.5, "Полный прокол уровня, ATR", minval = 0.05, step = 0.05, group = gR)

gI = "I · дивергенция"
rsiLen   = input.int(14, "RSI", minval = 2, group = gI)
divLen   = input.int(20, "Окно дивергенции", minval = 3, group = gI)
divRsi   = input.float(8.0, "Полная дивергенция RSI, пунктов", minval = 1, step = 0.5, group = gI)
divVol   = input.float(3.0, "Полная дивергенция CVD, × среднего объёма", minval = 0.2, step = 0.1, group = gI)
useCorr  = input.bool(false, "Учитывать коррелирующий инструмент", group = gI)
corrSym  = input.string("", "Коррелирующий инструмент (тикер целиком)", group = gI,
     tooltip = "Например NQ1! для ES1!. Пусто — коррелят не учитывается.")
divCorr  = input.float(0.5, "Полная дивергенция коррелята, %", minval = 0.01, step = 0.01, group = gI)

gN = "N · уровни"
tolATR    = input.float(0.28, "Допуск конфлюэнса, ATR", minval = 0.02, step = 0.01, group = gN)
levEmaLen = input.int(200, "Медленная EMA", minval = 10, group = gN)
swingLen  = input.int(60, "Окно свинга для фибо", minval = 5, group = gN)
fibRatio  = input.float(0.786, "Уровень фибо", minval = 0.1, maxval = 0.99, step = 0.001, group = gN)
roundStep = input.float(0.0, "Шаг круглых уровней (0 = авто)", minval = 0, group = gN)
wEma      = input.float(0.30, "Вес EMA",            minval = 0, maxval = 1, step = 0.01, group = gN)
wVwap     = input.float(0.27, "Вес VWAP сессии",    minval = 0, maxval = 1, step = 0.01, group = gN)
wPd       = input.float(0.25, "Вес хай/лоу дня",    minval = 0, maxval = 1, step = 0.01, group = gN)
wRound    = input.float(0.20, "Вес круглого числа", minval = 0, maxval = 1, step = 0.01, group = gN)
wFib      = input.float(0.23, "Вес фибо",           minval = 0, maxval = 1, step = 0.01, group = gN)
nFull     = input.float(0.90, "Полный конфлюэнс, сумма весов", minval = 0.1, step = 0.05, group = gN)

gG = "G · режим"
erLen     = input.int(20, "Окно эффективности хода", minval = 3, group = gG)
erLo      = input.float(0.20, "Тренда ещё нет, ER", minval = 0, maxval = 1, step = 0.01, group = gG)
erHi      = input.float(0.60, "Тренд в полную силу, ER", minval = 0.05, maxval = 1, step = 0.01, group = gG)
slopeLen  = input.int(10, "Окно наклона EMA", minval = 1, group = gG)
volRegLen = input.int(50, "Окно нормы волатильности", minval = 5, group = gG)
volCalm   = input.float(1.5, "Спокойная вола, ATR/норма", minval = 0.5, step = 0.1, group = gG)
volWild   = input.float(3.0, "Разгон волы, ATR/норма",    minval = 0.6, step = 0.1, group = gG)
gMin      = input.float(0.35, "Минимум множителя", minval = 0.0, maxval = 1, step = 0.05, group = gG)

gCal = "Калибровка"
calibOn   = input.bool(true, "Считать таблицу калибровки", group = gCal)
calThr    = input.float(50.0, "Нижний порог для калибровки", minval = 1, maxval = 100, step = 1, group = gCal,
     tooltip = "Отдельный симулятор берёт все сделки от этого скора, чтобы было видно, с какого диапазона начинается эдж. На боевые сигналы, алерты и отчёт он не влияет.")

gView = "Вид"
showPlan  = input.bool(true, "Сделки и план на графике", group = gView)
showBg    = input.bool(true, "Подсветка ARMED / TRIGGER на графике", group = gView)
showComps = input.bool(true, "Таблица компонентов", group = gView)
showRep   = input.bool(true, "Отчёт по сигналам", group = gView)
showCal   = input.bool(true, "Таблица калибровки", group = gView)
cLong     = input.color(#0B7A69, "Лонг",  group = gView, inline = "c")
cShort    = input.color(#B8412F, "Шорт",  group = gView, inline = "c")
cBrass    = input.color(#A9701C, "Акцент", group = gView, inline = "c")

// ── утилиты ────────────────────────────────────────────────────────────────────
f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_01(float x) => f_clamp(x, 0.0, 1.0)
f_hit(float lvl, float probe, float tol) => na(lvl) ? 0.0 : math.abs(probe - lvl) <= tol ? 1.0 : 0.0

// ── общие ряды ─────────────────────────────────────────────────────────────────
rng    = math.max(high - low, syminfo.mintick)
vol    = nz(volume, 0.0)
volMa  = ta.sma(vol, volLen)
hasVol = volMa > 0

atr   = ta.atr(atrLen)
bEma  = ta.ema(close, meanLen)
bSma  = ta.sma(close, meanLen)
bVwma = ta.vwma(close, meanLen)
basis = meanType == "SMA" ? bSma : meanType == "VWMA" ? bVwma : bEma
sd = ta.stdev(close, meanLen)

imp   = math.abs(close - close[1])
impPk = ta.highest(imp, fadeLen)

refL = ta.lowest(low, sweepLen)[1]
refH = ta.highest(high, sweepLen)[1]

rsi   = ta.rsi(close, rsiLen)
delta = vol * ((close - low) - (high - close)) / rng
cvd   = ta.cum(delta)

loW    = ta.lowest(low, divLen)[1]
hiW    = ta.highest(high, divLen)[1]
rsiLoW = ta.lowest(rsi, divLen)[1]
rsiHiW = ta.highest(rsi, divLen)[1]
cvdLoW = ta.lowest(cvd, divLen)[1]
cvdHiW = ta.highest(cvd, divLen)[1]

corrTicker = corrSym == "" ? syminfo.tickerid : corrSym
corrP      = request.security(corrTicker, timeframe.period, close, lookahead = barmerge.lookahead_off)
corrLoW    = ta.lowest(corrP, divLen)[1]
corrHiW    = ta.highest(corrP, divLen)[1]

// уровни
emaLvl = ta.ema(close, levEmaLen)

// VWAP сессии считаем руками — ta.vwap падает на инструментах без объёма
var float cumPV = 0.0
var float cumV  = 0.0
dayNew = timeframe.change("D")

if dayNew
    cumPV := 0.0
    cumV  := 0.0
cumPV += hlc3 * vol
cumV  += vol
avwap = cumV > 0 ? cumPV / cumV : na

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

swHi     = ta.highest(high, swingLen)
swLo     = ta.lowest(low, swingLen)
fibLong  = swHi - (swHi - swLo) * fibRatio
fibShort = swLo + (swHi - swLo) * fibRatio
rstep    = roundStep > 0 ? roundStep : math.pow(10, math.floor(math.log10(math.max(close, 1.0))) - 2) * 5

// режим
er       = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(close - close[1]), erLen), 1e-9)
trendDir = close > emaLvl and emaLvl > emaLvl[slopeLen] ? 1 : close < emaLvl and emaLvl < emaLvl[slopeLen] ? -1 : 0
volRat   = atr / math.max(ta.sma(atr, volRegLen), 1e-9)

// свинги для стопа
swStopLo = ta.lowest(low, stopLen)
swStopHi = ta.highest(high, stopLen)

// сессия: вне её новых входов нет; первые skipOpen баров после открытия тоже пропускаем
tSess   = time(timeframe.period, sessStr, sessTz)
inSess  = not useSess or not na(tSess)
sessNew = useSess ? (inSess and not inSess[1]) : dayNew
var int sessBar = 0
sessBar := sessNew ? 0 : sessBar + 1
sessOk  = inSess and sessBar >= skipOpen

var int nDays = 1
if dayNew and bar_index > 0
    nDays += 1

// ── компоненты для одной стороны ───────────────────────────────────────────────
f_dir(int d) =>
    // S · растяжение: считается только «в свою сторону» — лонг ждёт цену под средней
    devZ = sd  > 0 ? (close - basis) / sd  : 0.0
    devA = atr > 0 ? (close - basis) / atr : 0.0
    sZ   = d == 1 ? math.max(0.0, -devZ) : math.max(0.0, devZ)
    sA   = d == 1 ? math.max(0.0, -devA) : math.max(0.0, devA)
    S    = f_01(math.min(sZ / sFullZ, sA / sFullA))

    // P · истощение
    pV = hasVol ? f_01((vol / volMa - 1.0) / math.max(volFull - 1.0, 0.1)) : 0.5
    pF = impPk > 0 ? f_01(1.0 - imp / impPk) : 0.0
    pW = f_01((d == 1 ? close - low : high - close) / rng)
    P  = f_01(pwVol * pV + pwFade * pF + pwWick * pW)

    // R · возврат — только текущий бар
    ref    = d == 1 ? refL : refH
    pierce = d == 1 ? math.max(0.0, refL - low) : math.max(0.0, high - refH)
    pN     = atr > 0 ? f_01(pierce / (pierceATR * atr)) : 0.0
    back   = d == 1 ? close > ref : close < ref
    cpos   = f_01((d == 1 ? close - low : high - close) / rng)
    R      = back ? f_01(0.55 * cpos + 0.45 * pN) : 0.0

    // I · дивергенция — только на новом экстремуме
    newExt = d == 1 ? low < loW : high > hiW
    iR = d == 1 ? f_01((rsi - rsiLoW) / divRsi) : f_01((rsiHiW - rsi) / divRsi)
    iC = not hasVol ? 0.0 :
       d == 1 ? f_01((cvd - cvdLoW) / math.max(volMa * divVol, 1e-9))
              : f_01((cvdHiW - cvd) / math.max(volMa * divVol, 1e-9))
    iX = not useCorr ? 0.0 :
       d == 1 ? f_01((corrP - corrLoW) / math.max(math.abs(corrLoW) * divCorr / 100.0, 1e-9))
              : f_01((corrHiW - corrP) / math.max(math.abs(corrHiW) * divCorr / 100.0, 1e-9))
    iBase = hasVol ? 0.6 * iR + 0.4 * iC : iR
    I     = newExt ? f_01(useCorr ? 0.75 * iBase + 0.25 * iX : iBase) : 0.0

    // N · конфлюэнс уровней вокруг экстремума бара
    probe = d == 1 ? low : high
    tol   = tolATR * atr
    rnd   = rstep > 0 ? math.round(probe / rstep) * rstep : na
    fib   = d == 1 ? fibLong : fibShort
    wsum  = f_hit(emaLvl, probe, tol) * wEma
          + f_hit(avwap, probe, tol) * wVwap
          + math.max(f_hit(pdh, probe, tol), f_hit(pdl, probe, tol)) * wPd
          + f_hit(rnd, probe, tol) * wRound
          + f_hit(fib, probe, tol) * wFib
    N = f_01(wsum / nFull)

    // G · режим: против сильного тренда и в разгоне волы скор душится
    against = (d == 1 and trendDir < 0) or (d == -1 and trendDir > 0)
    gTr = against ? f_clamp(1.0 - (er - erLo) / math.max(erHi - erLo, 1e-9), gMin, 1.0) : 1.0
    gVo = f_clamp(1.0 - (volRat - volCalm) / math.max(volWild - volCalm, 1e-9), gMin, 1.0)
    G   = f_clamp(math.min(gTr, gVo), gMin, 1.0)

    [S, P, R, I, N, G]

[Sl0, Pl0, Rl, Il0, Nl0, Gl] = f_dir(1)
[Ss0, Ps0, Rs, Is0, Ns0, Gs] = f_dir(-1)

// контекст: S/P/I/N — максимум за окно, R — строго текущий бар
Sl = ta.highest(Sl0, ctxLen)
Pl = ta.highest(Pl0, ctxLen)
Il = ta.highest(Il0, ctxLen)
Nl = ta.highest(Nl0, ctxLen)
Ss = ta.highest(Ss0, ctxLen)
Ps = ta.highest(Ps0, ctxLen)
Is = ta.highest(Is0, ctxLen)
Ns = ta.highest(Ns0, ctxLen)

f_score(float S, float P, float R, float I, float N, float G) =>
    100.0 * gain * G * (wS * S + wP * P + wR * R + wI * I + wN * N)

scL  = f_score(Sl, Pl, Rl, Il, Nl, Gl)
scS  = f_score(Ss, Ps, Rs, Is, Ns, Gs)
potL = f_score(Sl, Pl, 1.0, Il, Nl, Gl)
potS = f_score(Ss, Ps, 1.0, Is, Ns, Gs)

side  = scL >= scS ? 1 : -1
score = math.max(scL, scS)
pot   = side == 1 ? potL : potS

cS = side == 1 ? Sl : Ss
cP = side == 1 ? Pl : Ps
cR = side == 1 ? Rl : Rs
cI = side == 1 ? Il : Is
cN = side == 1 ? Nl : Ns
cG = side == 1 ? Gl : Gs

state = score >= thrEntry ? "TRIGGER" : pot >= thrEntry ? "ARMED" : pot >= thrWatch ? "WATCH" : "FLAT"
withTrend = (side == 1 and trendDir > 0) or (side == -1 and trendDir < 0)
playbook  = withTrend ? "TREND_DIP" : er < erLo ? "RANGE_FADE" : "COUNTER_CLIMAX"

// ── план сделки по текущему бару ───────────────────────────────────────────────
planStop   = side == 1 ? swStopLo - stopATR * atr : swStopHi + stopATR * atr
planRetest = side == 1 ? planStop + retestATR * atr : planStop - retestATR * atr
planEntry  = useRetest ? planRetest : close
planRisk   = math.max(math.abs(planEntry - planStop), syminfo.mintick)
planT1     = basis
planT2     = side == 1 ? planEntry + t2R * planRisk : planEntry - t2R * planRisk
planRR     = (side == 1 ? planT1 - planEntry : planEntry - planT1) / planRisk
planCost   = (costTicks * syminfo.mintick + commPct / 100.0 * planEntry) / planRisk

// размер: риск в деньгах / риск в пунктах, при желании взвешенный скором
sizeMult   = scaleBySize ? f_clamp(score / math.max(planRisk / atr, 0.1) / 100.0, 0.1, 1.0) : 1.0
qtyRaw     = deposit * riskPct / 100.0 * sizeMult / math.max(planRisk * syminfo.pointvalue, 1e-9)
planQty    = math.max(math.floor(qtyRaw / lotStep + 1e-9) * lotStep, lotStep)
planRiskM  = planQty * planRisk * syminfo.pointvalue

// фильтры входа — общие для боевого и калибровочного симулятора
sideOk  = side == 1 ? useLong : useShort
barsOk  = not confirmed or barstate.isconfirmed
costOk  = maxCost <= 0 or planCost <= maxCost
gateOk  = sideOk and sessOk and barsOk and planRR >= minRR and costOk and not na(atr)
gateTxt = not sideOk ? "сторона выкл." : not sessOk ? "вне сессии" : planRR < minRR ? "мал R:R" : not costOk ? "издержки" : "ок"

// ── симулятор сделок ───────────────────────────────────────────────────────────
// Считает по барам: при касании стопа и цели на одном баре засчитывает стоп,
// гэп через стоп исполняет по открытию, частичных исполнений не знает.
type Trade
    int   side     = 0
    float entry
    float stop
    float t1
    float t2
    float risk
    float cost     = 0.0
    float qty
    float score
    int   bar
    bool  t1done   = false
    bool  filled   = false
    int   pSide    = 0
    float pPrice
    float pStop
    float pT1
    float pT2
    float pQty
    float pScore
    int   pBar
    int   lastExit = -100000
    int   xSide    = 0
    int   xBars    = 0
    float xPx

type Stats
    int   n     = 0
    int   win   = 0
    int   nL    = 0
    int   nS    = 0
    int   bars  = 0
    float sumR  = 0.0
    float pos   = 0.0
    float neg   = 0.0
    float cumR  = 0.0
    float peakR = 0.0
    float ddR   = 0.0
    float cumM  = 0.0
    float peakM = 0.0
    float ddM   = 0.0

method enter(Trade t, int dir, float px, float stp, float tp1, float tp2, float q, float sc) =>
    t.side   := dir
    t.entry  := px
    t.stop   := stp
    t.t1     := tp1
    t.t2     := tp2
    t.risk   := math.max(math.abs(px - stp), syminfo.mintick)
    t.cost   := (costTicks * syminfo.mintick + commPct / 100.0 * px) / t.risk
    t.qty    := q
    t.score  := sc
    t.bar    := bar_index
    t.t1done := false
    t

method place(Trade t, int dir, float px, float stp, float tp1, float tp2, float q, float sc) =>
    t.pSide  := dir
    t.pPrice := px
    t.pStop  := stp
    t.pT1    := tp1
    t.pT2    := tp2
    t.pQty   := q
    t.pScore := sc
    t.pBar   := bar_index
    t

// один бар жизни сделки: лимитка, стоп, цели, тайм-стоп, конец сессии.
// Возвращает результат закрытой на этом баре сделки в R за вычетом издержек, иначе na.
method advance(Trade t, bool flat) =>
    float res = na
    t.filled := false
    // отложенная лимитка на ретесте
    if t.pSide != 0 and bar_index > t.pBar
        bool broken = t.pSide == 1 ? open <= t.pStop  : open >= t.pStop
        bool touch  = t.pSide == 1 ? low  <= t.pPrice : high >= t.pPrice
        if flat or broken
            t.pSide := 0
        else if touch
            t.enter(t.pSide, t.pSide == 1 ? math.min(open, t.pPrice) : math.max(open, t.pPrice),
                 t.pStop, t.pT1, t.pT2, t.pQty, t.pScore)
            t.pSide  := 0
            t.filled := true
        else if bar_index - t.pBar >= retestLife
            t.pSide := 0
    // открытая позиция; на баре исполнения лимитки проверяется только стоп
    if t.side != 0 and (bar_index > t.bar or t.filled)
        float rr1    = math.abs(t.t1 - t.entry) / t.risk
        float rr2    = math.abs(t.t2 - t.entry) / t.risk
        float stopPx = t.side == 1 ? math.min(open, t.stop) : math.max(open, t.stop)
        float stopR  = (stopPx - t.entry) * t.side / t.risk
        bool stopHit = t.side == 1 ? low <= t.stop : high >= t.stop
        bool t1Hit   = not t.filled and (t.side == 1 ? high >= t.t1 : low <= t.t1)
        bool t2Hit   = not t.filled and (t.side == 1 ? high >= t.t2 : low <= t.t2)
        float px     = na
        if flat
            float mkt = (open - t.entry) * t.side / t.risk
            res := t.t1done ? 0.5 * rr1 + 0.5 * mkt : mkt
            px  := open
        else if stopHit
            res := t.t1done ? 0.5 * rr1 + 0.5 * stopR : stopR
            px  := stopPx
        else if not useT2 and t1Hit
            res := rr1
            px  := t.t1
        else if useT2 and t1Hit and not t.t1done
            t.t1done := true
            t.stop   := t.entry
            if t2Hit
                res := 0.5 * rr1 + 0.5 * rr2
                px  := t.t2
        else if useT2 and t.t1done and t2Hit
            res := 0.5 * rr1 + 0.5 * rr2
            px  := t.t2
        else if bar_index - t.bar >= maxBars
            float mkt = (close - t.entry) * t.side / t.risk
            res := t.t1done ? 0.5 * rr1 + 0.5 * mkt : mkt
            px  := close
        if not na(res)
            res        -= t.cost
            t.xSide    := t.side
            t.xBars    := bar_index - t.bar
            t.xPx      := px
            t.side     := 0
            t.t1done   := false
            t.lastExit := bar_index
    res

method record(Stats s, float r, int bars, int dir, float money) =>
    s.n     := s.n + 1
    s.bars  := s.bars + bars
    s.sumR  := s.sumR + r
    s.win   := s.win + (r > 0 ? 1 : 0)
    s.pos   := s.pos + math.max(r, 0.0)
    s.neg   := s.neg + math.max(-r, 0.0)
    s.nL    := s.nL + (dir == 1 ? 1 : 0)
    s.nS    := s.nS + (dir == -1 ? 1 : 0)
    s.cumR  := s.cumR + r
    s.peakR := math.max(s.peakR, s.cumR)
    s.ddR   := math.min(s.ddR, s.cumR - s.peakR)
    s.cumM  := s.cumM + money
    s.peakM := math.max(s.peakM, s.cumM)
    s.ddM   := math.min(s.ddM, s.cumM - s.peakM)
    s

f_bucket(float sc) => sc < 50 ? 0 : sc < 58 ? 1 : sc < 66 ? 2 : sc < 74 ? 3 : sc < 82 ? 4 : 5

var Trade live = Trade.new()   // боевой: только от порога входа
var Trade cal  = Trade.new()   // калибровочный: всё от нижнего порога
var Stats rep  = Stats.new()
var array<Stats> calB = array.new<Stats>()
if barstate.isfirst
    for i = 0 to 5
        calB.push(Stats.new())

forceOut = useSess and flatEnd and not inSess

float liveRes = live.advance(forceOut)
if not na(liveRes)
    rep.record(liveRes, live.xBars, live.xSide, liveRes * live.risk * syminfo.pointvalue * live.qty)

float calRes = na
if calibOn
    calRes := cal.advance(forceOut)
if not na(calRes)
    Stats sb = array.get(calB, f_bucket(cal.score))
    sb.record(calRes, cal.xBars, cal.xSide, 0.0)

liveCan = live.side == 0 and live.pSide == 0 and na(liveRes) and bar_index - live.lastExit >= cooldown and gateOk and score >= thrEntry
calCan  = calibOn and cal.side == 0 and cal.pSide == 0 and na(calRes) and bar_index - cal.lastExit >= cooldown and gateOk and score >= calThr

if liveCan
    if useRetest
        live.place(side, planEntry, planStop, planT1, planT2, planQty, score)
    else
        live.enter(side, planEntry, planStop, planT1, planT2, planQty, score)
if calCan
    if useRetest
        cal.place(side, planEntry, planStop, planT1, planT2, planQty, score)
    else
        cal.enter(side, planEntry, planStop, planT1, planT2, planQty, score)

fired     = liveCan
liveLong  = fired and side == 1
liveShort = fired and side == -1
armedNow  = state == "ARMED" and state[1] != "ARMED" and sideOk and sessOk

// ── панель скора ───────────────────────────────────────────────────────────────
scCol = state == "TRIGGER" ? (side == 1 ? cLong : cShort) : state == "ARMED" ? cBrass : color.new(cBrass, 45)
plot(score, "Скор (заливка)", color = color.new(cBrass, 84), style = plot.style_area, linewidth = 1)
plot(score, "Скор", color = scCol, linewidth = 2)
plot(pot, "Потенциал", color = color.new(cBrass, 60), linewidth = 1, display = display.pane)
hline(thrEntry, "Порог входа", color = #B8412F, linestyle = hline.style_dashed)
hline(thrWatch, "Порог наблюдения", color = color.new(color.gray, 40), linestyle = hline.style_dotted)
hline(0, "0", color = color.new(color.gray, 70))
plotshape(fired ? score : na, "Триггер", shape.circle, location.absolute,
     color = side == 1 ? cLong : cShort, size = size.tiny)

// ── сигналы, сделки и план на графике ──────────────────────────────────────────
plotshape(liveLong, "Сигнал LONG", shape.triangleup, location.belowbar,
     color = cLong, size = size.small, force_overlay = true)
plotshape(liveShort, "Сигнал SHORT", shape.triangledown, location.abovebar,
     color = cShort, size = size.small, force_overlay = true)
plot(basis, "Средняя", color = color.new(color.gray, 25), linewidth = 1,
     style = plot.style_line, force_overlay = true)

// уровни каждой сделки остаются на истории — видно, как отработал каждый сигнал
lvOn = showPlan and (live.side != 0 or not na(liveRes))
plot(lvOn ? live.entry : na, "Вход", color = color.new(chart.fg_color, 35),
     style = plot.style_linebr, force_overlay = true)
plot(lvOn ? live.stop : na, "Стоп", color = cShort, style = plot.style_linebr, force_overlay = true)
plot(lvOn ? live.t1 : na, "T1", color = cLong, style = plot.style_linebr, force_overlay = true)
plot(lvOn and useT2 ? live.t2 : na, "T2", color = color.new(cLong, 45),
     style = plot.style_linebr, force_overlay = true)
plot(showPlan and live.pSide != 0 ? live.pPrice : na, "Лимитка на ретесте", color = cBrass,
     style = plot.style_circles, linewidth = 2, force_overlay = true)
plotshape(showPlan and live.filled ? live.entry : na, "Лимитка исполнена", shape.diamond,
     location.absolute, color = cBrass, size = size.tiny, force_overlay = true)
plotshape(showPlan and not na(liveRes) ? live.xPx : na, "Выход", shape.xcross,
     location.absolute, color = liveRes > 0 ? cLong : cShort, size = size.tiny, force_overlay = true)

bgcolor(showBg and state == "TRIGGER" ? color.new(side == 1 ? cLong : cShort, 88) :
     showBg and state == "ARMED" ? color.new(cBrass, 93) : na, title = "Состояние", force_overlay = true)

var label lbl = na
if showPlan and fired
    label.delete(lbl)
    lbl := label.new(bar_index, side == 1 ? low : high,
         text = str.format("{0} · {1} · скор {2,number,#.#}\n{3} {4}   стоп {5}\nT1 {6}   T2 {7}   R:R {8,number,#.##}\nразмер {9} · риск {10,number,#} {11} · издержки {12,number,#}% R",
             side == 1 ? "LONG" : "SHORT", playbook, score,
             useRetest ? "лимитка" : "вход", str.tostring(planEntry, format.mintick), str.tostring(planStop, format.mintick),
             str.tostring(planT1, format.mintick), str.tostring(planT2, format.mintick), planRR,
             str.tostring(planQty, "#.########"), planRiskM, syminfo.currency, planCost * 100),
         style = side == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(side == 1 ? cLong : cShort, 88), textcolor = chart.fg_color, size = size.small,
         textalign = text.align_left, force_overlay = true)

// ── таблица компонентов ────────────────────────────────────────────────────────
var table tC = table.new(position.top_right, 4, 14, border_width = 1)

f_row(table t, int r, string k, string v, string w, string c, color bg) =>
    table.cell(t, 0, r, k, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, v, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 2, r, w, text_color = color.gray,     text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 3, r, c, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

if showComps and barstate.islast
    bgH = color.new(color.gray, 85)
    f_row(tC, 0, "КОМПОНЕНТ", "ЗНАЧ", "ВЕС", "ВКЛАД", bgH)
    f_row(tC, 1, "S растяжение",  str.tostring(cS, "#.00"), str.tostring(wS, "#.00"), str.tostring(wS * cS, "#.000"), na)
    f_row(tC, 2, "P истощение",   str.tostring(cP, "#.00"), str.tostring(wP, "#.00"), str.tostring(wP * cP, "#.000"), na)
    f_row(tC, 3, "R возврат",     str.tostring(cR, "#.00"), str.tostring(wR, "#.00"), str.tostring(wR * cR, "#.000"), color.new(cBrass, 88))
    f_row(tC, 4, "I дивергенция", str.tostring(cI, "#.00"), str.tostring(wI, "#.00"), str.tostring(wI * cI, "#.000"), na)
    f_row(tC, 5, "N уровни",      str.tostring(cN, "#.00"), str.tostring(wN, "#.00"), str.tostring(wN * cN, "#.000"), na)
    f_row(tC, 6, "Σ вкладов", "", "",
         str.tostring(wS * cS + wP * cP + wR * cR + wI * cI + wN * cN, "#.000"), bgH)
    f_row(tC, 7, "G режим", str.tostring(cG, "#.00"), "×", "", na)
    f_row(tC, 8, "gain", str.tostring(gain, "#.00"), "×", "", na)
    f_row(tC, 9, "СКОР", str.tostring(score, "#.0"), "", state, color.new(state == "TRIGGER" ? (side == 1 ? cLong : cShort) : cBrass, 80))
    f_row(tC, 10, "Сторона / плейбук", side == 1 ? "LONG" : "SHORT", "", playbook, na)
    f_row(tC, 11, "Потенциал", str.tostring(pot, "#.0"), "", pot >= thrEntry ? "готов" : "—", na)
    f_row(tC, 12, "R:R · издержки", str.tostring(planRR, "#.00"), str.tostring(planCost * 100, "#") + "% R", gateTxt,
         gateTxt != "ок" ? color.new(cShort, 85) : na)
    f_row(tC, 13, "Позиция",
         live.side != 0 ? (live.side == 1 ? "LONG" : "SHORT") : live.pSide != 0 ? "лимитка" : "—",
         live.side != 0 ? str.tostring(live.qty, "#.########") : "",
         live.side != 0 ? str.tostring(bar_index - live.bar) + " бар" : live.pSide != 0 ? str.tostring(live.pPrice, format.mintick) : "", na)

// ── отчёт по боевым сигналам ───────────────────────────────────────────────────
var table tR = table.new(position.bottom_left, 2, 10, border_width = 1)

f_rrow(table t, int r, string k, string v, color bg) =>
    table.cell(t, 0, r, k, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, v, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

if showRep and barstate.islast
    bgH = color.new(color.gray, 85)
    float pf = rep.neg > 0 ? rep.pos / rep.neg : na
    f_rrow(tR, 0, "ОТЧЁТ · скор ≥ " + str.tostring(thrEntry, "#.#"), useRetest ? "лимитка" : "по рынку", bgH)
    f_rrow(tR, 1, "Сделок · лонг / шорт", str.tostring(rep.n) + " · " + str.tostring(rep.nL) + " / " + str.tostring(rep.nS), na)
    f_rrow(tR, 2, "Винрейт", rep.n > 0 ? str.tostring(100.0 * rep.win / rep.n, "#.0") + "%" : "—", na)
    f_rrow(tR, 3, "Профит-фактор", na(pf) ? "—" : str.tostring(pf, "#.00"), na)
    f_rrow(tR, 4, "Средний R", rep.n > 0 ? str.tostring(rep.sumR / rep.n, "#.000") : "—", na)
    f_rrow(tR, 5, "Итого R", str.tostring(rep.cumR, "#.0"), na)
    f_rrow(tR, 6, "Итого, " + syminfo.currency, str.tostring(rep.cumM, "#"), na)
    f_rrow(tR, 7, "Макс. просадка", str.tostring(rep.ddR, "#.0") + "R · " + str.tostring(rep.ddM, "#"), na)
    f_rrow(tR, 8, "Сделок в день", str.tostring(rep.n * 1.0 / nDays, "#.0"), na)
    f_rrow(tR, 9, "Баров в сделке", rep.n > 0 ? str.tostring(rep.bars * 1.0 / rep.n, "#.0") : "—", na)

// ── таблица калибровки ─────────────────────────────────────────────────────────
var table tK = table.new(position.bottom_right, 6, 8, border_width = 1)

f_krow(table t, int r, string a, string b, string c, string d, string e, string f, color bg) =>
    table.cell(t, 0, r, a, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, b, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 2, r, c, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 3, r, d, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 4, r, e, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 5, r, f, text_color = color.gray,     text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

if calibOn and showCal and barstate.islast
    bgH = color.new(color.gray, 85)
    f_krow(tK, 0, "ДИАПАЗОН", "СДЕЛОК", "ВИНРЕЙТ", "ПФ", "СРЕДНИЙ R", "БАРОВ", bgH)
    names = array.from("< 50", "50-57", "58-65", "66-73", "74-81", "82-100")
    float bestR = -1e9
    for i = 0 to 5
        Stats b = array.get(calB, i)
        if b.n > 0
            bestR := math.max(bestR, b.sumR / b.n)
    int   totN    = 0
    int   totW    = 0
    int   totBars = 0
    float totR    = 0.0
    float totPos  = 0.0
    float totNeg  = 0.0
    for i = 0 to 5
        Stats b = array.get(calB, i)
        int n = b.n
        float r  = n > 0 ? b.sumR / n : na
        float pf = b.neg > 0 ? b.pos / b.neg : na
        bool hot = n > 0 and math.abs(r - bestR) < 1e-9
        f_krow(tK, i + 1, array.get(names, i), str.tostring(n),
             n > 0 ? str.tostring(100.0 * b.win / n, "#.0") + "%" : "—",
             na(pf) ? "—" : str.tostring(pf, "#.00"),
             n > 0 ? str.tostring(r, "#.000") : "—",
             n > 0 ? str.tostring(b.bars * 1.0 / n, "#.0") : "—",
             hot ? color.new(cBrass, 82) : na)
        totN    += n
        totW    += b.win
        totBars += b.bars
        totR    += b.sumR
        totPos  += b.pos
        totNeg  += b.neg
    f_krow(tK, 7, "всего от " + str.tostring(calThr, "#"), str.tostring(totN),
         totN > 0 ? str.tostring(100.0 * totW / totN, "#.0") + "%" : "—",
         totNeg > 0 ? str.tostring(totPos / totNeg, "#.00") : "—",
         totN > 0 ? str.tostring(totR / totN, "#.000") : "—",
         totN > 0 ? str.tostring(totBars * 1.0 / totN, "#.0") : "—", bgH)

// ── алерты ─────────────────────────────────────────────────────────────────────
alertcondition(liveLong,  "SPRING · LONG",  "SPRING: сигнал LONG")
alertcondition(liveShort, "SPRING · SHORT", "SPRING: сигнал SHORT")
alertcondition(fired, "SPRING · любой сигнал", "SPRING: сигнал на вход")
alertcondition(armedNow, "SPRING · ARMED", "SPRING: контекст готов, идеальный возврат дал бы вход")

if fired
    alert(str.format("SPRING {0} {1} · {2} · скор {3,number,#.#} | {4} {5} стоп {6} T1 {7} T2 {8} | R:R {9,number,#.##} | размер {10}, риск {11,number,#} {12}",
         syminfo.ticker, timeframe.period, side == 1 ? "LONG" : "SHORT", score,
         useRetest ? "лимитка" : "вход", str.tostring(planEntry, format.mintick), str.tostring(planStop, format.mintick),
         str.tostring(planT1, format.mintick), str.tostring(planT2, format.mintick),
         planRR, str.tostring(planQty, "#.########"), planRiskM, syminfo.currency),
         confirmed ? alert.freq_once_per_bar_close : alert.freq_once_per_bar)
