//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  COMPASS · куда смотреть прямо сейчас — лонг, шорт или никуда
//
//  Минутка не прощает двух вещей: торговли против старшего ТФ и торговли в пиле.
//  Поэтому движок считает не один скор, а два — и смешивает их по режиму рынка:
//
//      Trend = 100 · ( wH·H + wT·T + wM·M + wV·V + wI·I + wD·D )   — идти за ходом
//      Fade  = 100 · F                                             — ловить возврат
//      Score = τ · Trend + (1 − τ) · Fade
//
//    H — старший контекст: 5m / 15m / 60m, стек EMA + положение + наклон
//    T — локальный тренд: стек EMA 9/21/50 и наклон, нормированный на ATR
//    M — структура: слом уровня (BOS) + качество свингов HH/HL против LH/LL
//    V — VWAP: сторона, наклон, растяжение в σ (перелёт штрафуется)
//    I — импульс: гистограмма MACD, её ускорение, RSI, ROC на ATR
//    D — давление: дельта объёма (CVD-прокси) + перевес растущих баров
//    F — фейд: растяжение от VWAP, RSI на краю, свип с реклеймом, дивергенция, истощение
//    τ — сила тренда 0…1 из трёх независимых мер: ADX, эффективность хода, Choppiness
//
//  Главное следствие смешивания: на переходе (τ ≈ 0.5) тренд и фейд смотрят в разные
//  стороны, сумма схлопывается к нулю и движок честно говорит ЖДАТЬ. Это не баг —
//  ради этого всё и затевалось. Сигнал есть только там, где обе логики не спорят.
//
//  Поверх скора стоят фильтры-вето: мёртвая вола, пустой объём, пила, шпилька,
//  время вне сессии. Они не двигают скор, они запрещают вердикт — и говорят почему.
//
//  Скор — не предсказание. Таблица калибровки внизу считает, что реально случилось
//  после каждого вердикта на вашем инструменте. Если винрейт и средний R не растут
//  вместе с уверенностью — на этом инструменте движок не работает. Проверяйте.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("COMPASS · лонг или шорт", "COMPASS", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     max_bars_back = 1000)

// ── ядро ───────────────────────────────────────────────────────────────────────
gCore = "Ядро"
thrEnter  = input.float(32.0, "Порог смещения", minval = 5, maxval = 95, step = 1, group = gCore,
     tooltip = "Скор идёт от −100 до +100. Выше порога — ЛОНГ, ниже минус порога — ШОРТ.")
thrExit   = input.float(16.0, "Порог сброса в нейтраль", minval = 0, maxval = 90, step = 1, group = gCore,
     tooltip = "Гистерезис. Смещение держится, пока скор не провалится ниже этого значения. Без него вердикт мигает каждый бар.")
atrLen    = input.int(14, "ATR", minval = 2, group = gCore)
smoothLen = input.int(2, "Сглаживание скора, баров", minval = 1, maxval = 10, group = gCore,
     tooltip = "1 — без сглаживания. На минутке 2–3 убирают дрожь, не съедая реакцию.")
confirmed = input.bool(true, "Алерты только по закрытым барам", group = gCore,
     tooltip = "Выключить — вердикт полетит внутри формирующегося бара и может исчезнуть.")

gW = "Веса компонентов тренда"
wH = input.float(0.24, "H · старший контекст", minval = 0, maxval = 1, step = 0.01, group = gW)
wT = input.float(0.17, "T · локальный тренд",  minval = 0, maxval = 1, step = 0.01, group = gW)
wM = input.float(0.19, "M · структура",        minval = 0, maxval = 1, step = 0.01, group = gW)
wV = input.float(0.13, "V · VWAP",             minval = 0, maxval = 1, step = 0.01, group = gW)
wI = input.float(0.15, "I · импульс",          minval = 0, maxval = 1, step = 0.01, group = gW)
wD = input.float(0.12, "D · давление объёма",  minval = 0, maxval = 1, step = 0.01, group = gW)

gH = "H · старший контекст"
useHTF   = input.bool(true, "Учитывать старшие ТФ", group = gH)
tfA      = input.timeframe("5",  "ТФ №1", group = gH, inline = "tf")
tfB      = input.timeframe("15", "ТФ №2", group = gH, inline = "tf")
tfC      = input.timeframe("60", "ТФ №3", group = gH, inline = "tf")
kA       = input.float(0.45, "Вес ТФ №1", minval = 0, maxval = 1, step = 0.01, group = gH, inline = "kw")
kB       = input.float(0.33, "№2",        minval = 0, maxval = 1, step = 0.01, group = gH, inline = "kw")
kC       = input.float(0.22, "№3",        minval = 0, maxval = 1, step = 0.01, group = gH, inline = "kw")
hFast    = input.int(21, "Быстрая EMA старшего ТФ", minval = 2, group = gH)
hSlow    = input.int(50, "Медленная EMA старшего ТФ", minval = 3, group = gH)
hSlopeLn = input.int(3, "Окно наклона на старшем ТФ", minval = 1, group = gH)
nonRepaint = input.bool(true, "Без перерисовки (только закрытые бары старшего ТФ)", group = gH,
     tooltip = "Включено — контекст берётся с предыдущего закрытого бара старшего ТФ. Запаздывает, зато история совпадает с реальным временем. Выключено — старший ТФ обновляется внутри бара: быстрее, но прошлые сигналы на графике будут красивее, чем были на самом деле.")
htfVeto  = input.float(0.55, "Сильный старший тренд, |H| от", minval = 0, maxval = 1, step = 0.05, group = gH)
htfMul   = input.float(0.45, "Множитель фейда против него", minval = 0, maxval = 1, step = 0.05, group = gH,
     tooltip = "Контртрендовый сетап против сильного старшего тренда режется этим множителем. Это самая дорогая ошибка на минутке.")

gT = "T · локальный тренд"
emaF = input.int(9,  "EMA быстрая", minval = 2, group = gT, inline = "e")
emaM = input.int(21, "средняя",     minval = 3, group = gT, inline = "e")
emaS = input.int(50, "медленная",   minval = 5, group = gT, inline = "e")
tSlopeLn = input.int(3, "Окно наклона средней EMA", minval = 1, group = gT)
tSlopeFull = input.float(0.35, "Полный наклон, ATR за окно", minval = 0.02, step = 0.01, group = gT)

gM = "M · структура"
pivL     = input.int(3, "Свинг, баров слева", minval = 1, group = gM, inline = "p")
pivR     = input.int(3, "справа",             minval = 1, group = gM, inline = "p")
bosFresh = input.int(12, "Слом считается свежим, баров", minval = 1, group = gM)
bosFade  = input.float(0.60, "Вес выдохшегося слома", minval = 0, maxval = 1, step = 0.05, group = gM)

gV = "V · VWAP"
vwAnchor  = input.string("D", "Якорь VWAP", options = ["D", "W", "M"], group = gV)
vwSlopeLn = input.int(5, "Окно наклона VWAP", minval = 1, group = gV)
vwSlopeFull = input.float(0.30, "Полный наклон VWAP, ATR за окно", minval = 0.02, step = 0.01, group = gV)
vwStretch = input.float(3.0, "Перелёт, σ", minval = 0.5, step = 0.1, group = gV,
     tooltip = "На сколько σ от VWAP цена считается перетянутой. Дальше этого тренд-скор начинает штрафоваться: догонять поздно.")

gI = "I · импульс"
macdF  = input.int(8,  "MACD быстрый", minval = 2, group = gI, inline = "m")
macdSl = input.int(21, "медленный",    minval = 3, group = gI, inline = "m")
macdSg = input.int(5,  "сигнальный",   minval = 1, group = gI, inline = "m")
histFull = input.float(0.55, "Полная гистограмма, ATR", minval = 0.05, step = 0.05, group = gI)
rsiLen = input.int(14, "RSI", minval = 2, group = gI)
rsiFull = input.float(20.0, "Полный уход RSI от 50, пунктов", minval = 2, step = 1, group = gI)
rocLen = input.int(5, "Окно ROC", minval = 1, group = gI)
rocFull = input.float(1.0, "Полный ROC, ATR·√окна", minval = 0.1, step = 0.1, group = gI)

gD = "D · давление объёма"
dLen   = input.int(20, "Окно дельты", minval = 2, group = gD)
volLen = input.int(50, "Окно среднего объёма", minval = 5, group = gD)

gF = "F · фейд (режим диапазона)"
fadeZ    = input.float(2.0, "Полное растяжение от VWAP, σ", minval = 0.3, step = 0.1, group = gF)
fadeRsi  = input.float(22.0, "Полный уход RSI от 50, пунктов", minval = 2, step = 1, group = gF)
sweepLen = input.int(12, "Окно свипа ликвидности", minval = 2, group = gF)
sweepHold= input.int(4, "Свип живёт, баров", minval = 1, group = gF)
divLen   = input.int(20, "Окно дивергенции", minval = 3, group = gF)
divFull  = input.float(8.0, "Полная дивергенция RSI, пунктов", minval = 1, step = 0.5, group = gF)
climaxLo = input.float(1.5, "Климакс объёма начинается с, × среднего", minval = 1.0, step = 0.1, group = gF)
climaxHi = input.float(3.0, "Полный климакс, × среднего", minval = 1.1, step = 0.1, group = gF)
fwZ = input.float(0.34, "Вес растяжения", minval = 0, maxval = 1, step = 0.01, group = gF, inline = "fw")
fwR = input.float(0.16, "RSI",            minval = 0, maxval = 1, step = 0.01, group = gF, inline = "fw")
fwS = input.float(0.26, "свип",           minval = 0, maxval = 1, step = 0.01, group = gF, inline = "fw2")
fwD = input.float(0.14, "дивергенция",    minval = 0, maxval = 1, step = 0.01, group = gF, inline = "fw2")
fwE = input.float(0.10, "истощение",      minval = 0, maxval = 1, step = 0.01, group = gF, inline = "fw2")

gR = "τ · режим рынка"
diLen  = input.int(14, "DI", minval = 2, group = gR, inline = "a")
adxLen = input.int(14, "сглаживание ADX", minval = 1, group = gR, inline = "a")
adxLo  = input.float(15.0, "Тренда нет, ADX", minval = 1, step = 1, group = gR, inline = "al")
adxHi  = input.float(30.0, "тренд в силе",    minval = 2, step = 1, group = gR, inline = "al")
erLen  = input.int(20, "Окно эффективности хода", minval = 3, group = gR)
erLo   = input.float(0.20, "Тренда нет, ER", minval = 0, maxval = 1, step = 0.01, group = gR, inline = "el")
erHi   = input.float(0.55, "тренд в силе",   minval = 0.05, maxval = 1, step = 0.01, group = gR, inline = "el")
chopLen= input.int(14, "Окно Choppiness", minval = 3, group = gR)
rwAdx  = input.float(0.45, "Вес ADX", minval = 0, maxval = 1, step = 0.05, group = gR, inline = "rw")
rwEr   = input.float(0.35, "ER",      minval = 0, maxval = 1, step = 0.05, group = gR, inline = "rw")
rwChop = input.float(0.20, "Chop",    minval = 0, maxval = 1, step = 0.05, group = gR, inline = "rw")

gG = "Фильтры-вето"
useVolFlt = input.bool(true, "Фильтр мёртвой волатильности", group = gG)
atrRankMin= input.float(25.0, "Минимальный перцентиль ATR", minval = 0, maxval = 99, step = 5, group = gG,
     tooltip = "ATR сравнивается сам с собой за окно нормы. Ниже этого перцентиля минутка не платит за риск: спред и комиссия съедают ход.")
volRegLen = input.int(200, "Окно нормы волатильности", minval = 20, group = gG)
useRvolFlt= input.bool(true, "Фильтр пустого объёма", group = gG)
rvolMin   = input.float(0.65, "Минимальный RVOL", minval = 0, step = 0.05, group = gG)
useChopFlt= input.bool(true, "Фильтр пилы", group = gG)
chopMax   = input.float(61.8, "Пила начинается с Choppiness", minval = 20, maxval = 100, step = 0.5, group = gG)
chopPass  = input.float(55.0, "…но скор выше этого пилу перебивает", minval = 10, maxval = 100, step = 5, group = gG)
useSpike  = input.bool(true, "Фильтр шпильки (новость, прокол)", group = gG)
spikeATR  = input.float(3.0, "Шпилька: диапазон бара, ATR", minval = 1.2, step = 0.1, group = gG)
spikeCool = input.int(3, "Пауза после шпильки, баров", minval = 0, group = gG)
useSess   = input.bool(false, "Фильтр сессии", group = gG)
sessStr   = input.session("0900-2350", "Торговые часы", group = gG)

gPlan = "План сделки"
stopLen    = input.int(5, "Окно свинга для стопа", minval = 1, group = gPlan)
stopATR    = input.float(0.35, "Запас за свинг, ATR", minval = 0, step = 0.05, group = gPlan)
minStopATR = input.float(0.60, "Минимальный стоп, ATR", minval = 0.1, step = 0.05, group = gPlan)
maxStopATR = input.float(2.20, "Максимальный стоп, ATR", minval = 0.3, step = 0.1, group = gPlan)
t1R        = input.float(1.20, "Цель T1, в R", minval = 0.2, step = 0.1, group = gPlan)
t2R        = input.float(2.20, "Цель T2, в R", minval = 0.3, step = 0.1, group = gPlan)
pbTol      = input.float(0.35, "Зона отката: допуск, ATR", minval = 0.05, step = 0.05, group = gPlan)
costTicks  = input.float(2.0, "Издержки, тиков на сделку", minval = 0, step = 0.5, group = gPlan,
     tooltip = "Спред + комиссия + проскальзывание в тиках. На минутке это главный фильтр: если стоп меньше 8–10 издержек, торговать нечего.")

gCal = "Калибровка"
calibOn = input.bool(true, "Считать калибровку", group = gCal)
calBars = input.int(20, "Тайм-стоп симуляции, баров", minval = 2, group = gCal)
calCool = input.int(5, "Пауза между сделками, баров", minval = 0, group = gCal)

gVis = "Вид"
showPanel = input.bool(true, "Панель вердикта", group = gVis)
showCal   = input.bool(true, "Таблица калибровки", group = gVis)
showPlan  = input.bool(true, "План сделки на графике", group = gVis)
showZone  = input.bool(true, "Зона отката", group = gVis)
showEma   = input.bool(true, "EMA и VWAP", group = gVis)
paintBars = input.bool(false, "Красить свечи по вердикту", group = gVis)
paintBg   = input.bool(true, "Фон по вердикту", group = gVis)
posPanel  = input.string("Справа сверху", "Панель", options = ["Справа сверху", "Справа снизу", "Слева сверху", "Слева снизу"], group = gVis)
cLong  = input.color(#0B7A69, "Лонг",   group = gVis, inline = "c")
cShort = input.color(#B8412F, "Шорт",   group = gVis, inline = "c")
cWait  = input.color(#A9701C, "Акцент", group = gVis, inline = "c")

// ── утилиты ────────────────────────────────────────────────────────────────────
f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_01(float x)  => f_clamp(nz(x), 0.0, 1.0)
f_c1(float x)  => f_clamp(nz(x), -1.0, 1.0)
f_ramp(float x, float lo, float hi) => hi <= lo ? 0.0 : f_01((x - lo) / (hi - lo))
f_rep(string s, int n) => n > 0 ? str.repeat(s, n) : ""
f_sig(float v, string fmt) => (nz(v) > 0 ? "+" : "") + str.tostring(v, fmt)

// шкала от −100 до +100 символами: слева шорт, справа лонг
f_gauge(float v) =>
    int n = int(math.round(f_01(math.abs(nz(v)) / 100.0) * 8))
    string l = v < 0 ? f_rep("·", 8 - n) + f_rep("█", n) : f_rep("·", 8)
    string r = v > 0 ? f_rep("█", n) + f_rep("·", 8 - n) : f_rep("·", 8)
    l + "┃" + r

// мини-шкала компонента от −1 до +1
f_mini(float v) =>
    int n = int(math.round(f_01(math.abs(nz(v))) * 4))
    (v < 0 ? f_rep("·", 4 - n) + f_rep("▄", n) : f_rep("·", 4)) + "│" +
     (v > 0 ? f_rep("▄", n) + f_rep("·", 4 - n) : f_rep("·", 4))

// ── общие ряды ─────────────────────────────────────────────────────────────────
rng    = math.max(high - low, syminfo.mintick)
vol    = nz(volume, 0.0)
wgt    = vol > 0 ? vol : 1.0              // VWAP должен жить и на инструментах без объёма
volMa  = ta.sma(vol, volLen)
hasVol = volMa > 0
rvol   = hasVol ? vol / volMa : 1.0
rvolS  = ta.sma(rvol, 3)

atr    = ta.atr(atrLen)
atrOk  = not na(atr) and atr > 0
rsiV   = ta.rsi(close, rsiLen)

// ── H · старший контекст ───────────────────────────────────────────────────────
htfOff = nonRepaint ? 1 : 0

f_htfPack(int off) =>
    ef = ta.ema(close, hFast)
    es = ta.ema(close, hSlow)
    sl = ef - ef[hSlopeLn]
    aa = ta.atr(14)
    [close[off], ef[off], es[off], sl[off], aa[off]]

[cA, fA, sA, kAa, aA] = request.security(syminfo.tickerid, tfA, f_htfPack(htfOff), lookahead = barmerge.lookahead_off)
[cB, fB, sB, kBb, aB] = request.security(syminfo.tickerid, tfB, f_htfPack(htfOff), lookahead = barmerge.lookahead_off)
[cC, fC, sC, kCc, aC] = request.security(syminfo.tickerid, tfC, f_htfPack(htfOff), lookahead = barmerge.lookahead_off)

f_htfOne(float c, float ef, float es, float sl, float aa) =>
    na(c) or na(ef) or na(es) ? 0.0 :
     f_c1((c > ef ? 0.35 : -0.35) + (ef > es ? 0.35 : -0.35) +
          f_clamp(na(aa) or aa <= 0 ? 0.0 : sl / aa * 4.0, -0.30, 0.30))

hA = f_htfOne(cA, fA, sA, kAa, aA)
hB = f_htfOne(cB, fB, sB, kBb, aB)
hC = f_htfOne(cC, fC, sC, kCc, aC)
kSum = math.max(kA + kB + kC, 1e-9)
cH   = useHTF ? f_c1((hA * kA + hB * kB + hC * kC) / kSum) : 0.0

// ── T · локальный тренд ────────────────────────────────────────────────────────
e1 = ta.ema(close, emaF)
e2 = ta.ema(close, emaM)
e3 = ta.ema(close, emaS)
tStack = (e1 > e2 ? 0.30 : -0.30) + (e2 > e3 ? 0.30 : -0.30) + (close > e2 ? 0.20 : -0.20)
tSlope = atrOk ? (e2 - e2[tSlopeLn]) / (atr * tSlopeFull) : 0.0
cT = f_c1(tStack + f_clamp(tSlope * 0.20, -0.20, 0.20))

// ── M · структура ──────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low, pivL, pivR)

var float ph1 = na
var float ph2 = na
var float pl1 = na
var float pl2 = na
if not na(ph)
    ph2 := ph1
    ph1 := ph
if not na(pl)
    pl2 := pl1
    pl1 := pl

// Слом — это переход состояния, а не «пробили именно этим баром»: свинг
// подтверждается через pivR баров и вполне может подтвердиться уже под ценой.
aboveH = not na(ph1) and close > ph1
belowL = not na(pl1) and close < pl1
bosUp = aboveH and not aboveH[1]
bosDn = belowL and not belowL[1]

var int structDir = 0
if bosUp
    structDir := 1
if bosDn
    structDir := -1

var int sinceBos = 9999
sinceBos := bosUp or bosDn ? 0 : math.min(sinceBos + 1, 9999)
bosWeight = sinceBos <= bosFresh ? 1.0 : bosFade

swQual = (not na(ph2) and ph1 > ph2 ? 0.5 : 0.0) + (not na(pl2) and pl1 > pl2 ? 0.5 : 0.0) -
         (not na(ph2) and ph1 < ph2 ? 0.5 : 0.0) - (not na(pl2) and pl1 < pl2 ? 0.5 : 0.0)
cM = f_c1(structDir * 0.55 * bosWeight + swQual * 0.45)

// ── V · VWAP с полосами σ ──────────────────────────────────────────────────────
var float cumW  = 0.0
var float cumPW = 0.0
var float cumP2 = 0.0
if timeframe.change(vwAnchor) or bar_index == 0
    cumW  := 0.0
    cumPW := 0.0
    cumP2 := 0.0
cumW  += wgt
cumPW += hlc3 * wgt
cumP2 += hlc3 * hlc3 * wgt
vwapV = cumW > 0 ? cumPW / cumW : na
vwapSd = cumW > 0 ? math.sqrt(math.max(cumP2 / cumW - vwapV * vwapV, 0.0)) : na
sdUse = na(vwapSd) or vwapSd <= 0 ? (atrOk ? atr : syminfo.mintick) : vwapSd
zV = na(vwapV) ? 0.0 : (close - vwapV) / sdUse
vwSlope = na(vwapV) or not atrOk ? 0.0 : (vwapV - vwapV[vwSlopeLn]) / (atr * vwSlopeFull)
cV = na(vwapV) ? 0.0 :
     f_c1((close > vwapV ? 0.45 : -0.45) + f_clamp(vwSlope * 0.35, -0.35, 0.35) +
          f_clamp(-zV / vwStretch * 0.20, -0.20, 0.20))

// ── I · импульс ────────────────────────────────────────────────────────────────
[mLine, mSig, mHist] = ta.macd(close, macdF, macdSl, macdSg)
iHist = atrOk ? f_c1(mHist / (atr * histFull)) : 0.0
iAcc  = atrOk ? f_c1((mHist - mHist[1]) / (atr * histFull * 0.5)) : 0.0
iRsi  = f_c1((rsiV - 50.0) / rsiFull)
iRoc  = atrOk ? f_c1((close - close[rocLen]) / (atr * rocFull * math.sqrt(rocLen))) : 0.0
cI = f_c1(iHist * 0.35 + iAcc * 0.15 + iRsi * 0.25 + iRoc * 0.25)

// ── D · давление объёма ────────────────────────────────────────────────────────
delta = wgt * ((close - low) - (high - close)) / rng
dSum  = math.sum(delta, dLen)
wSum2 = math.sum(wgt, dLen)
dNorm = wSum2 > 0 ? dSum / wSum2 : 0.0
upW   = math.sum(close > close[1] ? wgt : 0.0, dLen)
dnW   = math.sum(close < close[1] ? wgt : 0.0, dLen)
uds   = upW + dnW > 0 ? (upW - dnW) / (upW + dnW) : 0.0
cD = f_c1(dNorm * 0.55 + uds * 0.45)

// ── F · фейд ───────────────────────────────────────────────────────────────────
refL = ta.lowest(low, sweepLen)[1]
refH = ta.highest(high, sweepLen)[1]
swBull = not na(refL) and low < refL and close > refL and close > open
swBear = not na(refH) and high > refH and close < refH and close < open

var int sinceSwB = 9999
var int sinceSwS = 9999
sinceSwB := swBull ? 0 : math.min(sinceSwB + 1, 9999)
sinceSwS := swBear ? 0 : math.min(sinceSwS + 1, 9999)
swScore = (sinceSwB <= sweepHold ? 1.0 - sinceSwB / (sweepHold + 1.0) : 0.0) -
          (sinceSwS <= sweepHold ? 1.0 - sinceSwS / (sweepHold + 1.0) : 0.0)

loW    = ta.lowest(low, divLen)[1]
hiW    = ta.highest(high, divLen)[1]
rsiLoW = ta.lowest(rsiV, divLen)[1]
rsiHiW = ta.highest(rsiV, divLen)[1]
divBull = not na(loW) and low < loW and rsiV > rsiLoW ? f_01((rsiV - rsiLoW) / divFull) : 0.0
divBear = not na(hiW) and high > hiW and rsiV < rsiHiW ? f_01((rsiHiW - rsiV) / divFull) : 0.0
divScore = divBull - divBear

climax = f_ramp(rvol, climaxLo, climaxHi)
wickUp = (high - math.max(open, close)) / rng
wickDn = (math.min(open, close) - low) / rng
exhaust = climax * f_c1((wickDn - wickUp) * 2.0)

fSum = math.max(fwZ + fwR + fwS + fwD + fwE, 1e-9)
cF = f_c1((f_c1(-zV / fadeZ) * fwZ + f_c1(-(rsiV - 50.0) / fadeRsi) * fwR +
           swScore * fwS + divScore * fwD + exhaust * fwE) / fSum)

// ── τ · режим рынка ────────────────────────────────────────────────────────────
[diP, diM, adxV] = ta.dmi(diLen, adxLen)
er = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(close - close[1]), erLen), 1e-9)
chopRng = math.max(ta.highest(high, chopLen) - ta.lowest(low, chopLen), syminfo.mintick)
chop = 100.0 * math.log10(math.max(math.sum(ta.tr(true), chopLen) / chopRng, 1e-9)) / math.log10(chopLen)

rSum = math.max(rwAdx + rwEr + rwChop, 1e-9)
tau = f_01((f_ramp(nz(adxV), adxLo, adxHi) * rwAdx +
             f_ramp(er, erLo, erHi) * rwEr +
             f_ramp(chopMax - chop, 0.0, 20.0) * rwChop) / rSum)

// ── скор ───────────────────────────────────────────────────────────────────────
wHe  = useHTF ? wH : 0.0
wSum = math.max(wHe + wT + wM + wV + wI + wD, 1e-9)
trendRaw = 100.0 * (wHe * cH + wT * cT + wM * cM + wV * cV + wI * cI + wD * cD) / wSum
fadeRaw  = 100.0 * cF
// контртренд против сильного старшего ТФ — самая дорогая ошибка на минутке
fadeCut  = math.abs(cH) >= htfVeto and fadeRaw * cH < 0
fadeAdj  = fadeCut ? fadeRaw * htfMul : fadeRaw
// на переходе (τ≈0.5) тренд и фейд спорят, сумма схлопывается к нулю — и это правильно
scoreRaw = tau * trendRaw + (1.0 - tau) * fadeAdj
score    = ta.ema(scoreRaw, smoothLen)

sgn = score > 0 ? 1 : score < 0 ? -1 : 0
f_vote(float v) => v > 0.15 ? 1 : v < -0.15 ? -1 : 0
vH = f_vote(cH)
vT = f_vote(cT)
vM = f_vote(cM)
vV = f_vote(cV)
vI = f_vote(cI)
vD = f_vote(cD)
agreeN = sgn == 0 ? 0 :
         (vH == sgn ? 1 : 0) + (vT == sgn ? 1 : 0) + (vM == sgn ? 1 : 0) +
         (vV == sgn ? 1 : 0) + (vI == sgn ? 1 : 0) + (vD == sgn ? 1 : 0)
conf = f_01(math.abs(score) / 70.0) * 60.0 + agreeN / 6.0 * 40.0

// ── фильтры-вето ───────────────────────────────────────────────────────────────
atrRank = ta.percentrank(atr, volRegLen)
gVola = not useVolFlt or na(atrRank) or atrRank >= atrRankMin
gRvol = not useRvolFlt or not hasVol or nz(rvolS, 1.0) >= rvolMin
gChop = not useChopFlt or chop <= chopMax or math.abs(score) >= chopPass

spike = atrOk and high - low > atr * spikeATR
var int sinceSpike = 9999
sinceSpike := spike ? 0 : math.min(sinceSpike + 1, 9999)
gSpike = not useSpike or sinceSpike > spikeCool
gSess  = not useSess or not na(time(timeframe.period, sessStr))
gAll   = gVola and gRvol and gChop and gSpike and gSess and atrOk

reason = gAll ? "" :
         (not atrOk  ? "нет ATR · " : "") +
         (not gVola  ? "вола ниже нормы · " : "") +
         (not gRvol  ? "пустой объём · " : "") +
         (not gChop  ? "пила · " : "") +
         (not gSpike ? "шпилька, пауза · " : "") +
         (not gSess  ? "вне сессии · " : "")

// ── вердикт с гистерезисом ─────────────────────────────────────────────────────
var int biasRaw = 0
if score >= thrEnter
    biasRaw := 1
else if score <= -thrEnter
    biasRaw := -1
else if math.abs(score) < thrExit
    biasRaw := 0
verdict = gAll ? biasRaw : 0

// ── плейбук: что именно делать ─────────────────────────────────────────────────
nearE2 = atrOk and math.abs(close - e2) <= atr * pbTol
nearVW = atrOk and not na(vwapV) and math.abs(close - vwapV) <= atr * pbTol
pullback = nearE2 or nearVW
playbook = verdict == 0 ? (biasRaw == 0 ? "—" : "смещение есть, но вход запрещён") :
           tau >= 0.60 ? (sinceBos <= bosFresh ? "продолжение после слома" :
                          pullback ? "откат в тренде — зона входа здесь" : "тренд есть, ждать отката") :
           tau <= 0.35 ? (math.abs(swScore) > 0.30 ? "свип и реклейм" : "фейд от края диапазона") :
           "переход режима — половина размера"

regimeTxt = tau >= 0.60 ? "ТРЕНД" : tau <= 0.35 ? "ДИАПАЗОН" : "ПЕРЕХОД"

// ── план сделки ────────────────────────────────────────────────────────────────
swLo = ta.lowest(low, stopLen)
swHi = ta.highest(high, stopLen)
side = verdict != 0 ? verdict : sgn != 0 ? sgn : 1
planEntry = close
rawStop = side == 1 ? swLo - atr * stopATR : swHi + atr * stopATR
dist = atrOk ? f_clamp(math.abs(planEntry - rawStop), atr * minStopATR, atr * maxStopATR)
             : math.abs(planEntry - rawStop)
planStop = side == 1 ? planEntry - dist : planEntry + dist
planT1   = side == 1 ? planEntry + dist * t1R : planEntry - dist * t1R
planT2   = side == 1 ? planEntry + dist * t2R : planEntry - dist * t2R
riskPct  = close > 0 ? dist / close * 100.0 : na
costR    = dist > 0 ? costTicks * syminfo.mintick / dist : na
zRef     = na(vwapV) ? e2 : vwapV
zTop     = math.max(e2, zRef) + (atrOk ? atr * pbTol : 0.0)
zBot     = math.min(e2, zRef) - (atrOk ? atr * pbTol : 0.0)

flipL = verdict == 1 and verdict[1] != 1
flipS = verdict == -1 and verdict[1] != -1
flip  = flipL or flipS

// ── калибровка: что реально случилось после вердикта ───────────────────────────
var array<int>   bkN = array.new_int(4, 0)
var array<int>   bkW = array.new_int(4, 0)
var array<float> bkR = array.new_float(4, 0.0)
var array<int>   bkB = array.new_int(4, 0)
var float cumR  = 0.0
var float peakR = 0.0
var float ddR   = 0.0

var int   simSide = 0
var float simE    = na
var float simS    = na
var float simT    = na
var float simRisk = na
var int   simBar  = 0
var int   simBk   = 0
var int   lastOut = -99999

if calibOn and simSide != 0
    bool done = false
    float r = 0.0
    if simSide == 1
        if low <= simS
            r := -1.0
            done := true
        else if high >= simT
            r := t1R
            done := true
    else
        if high >= simS
            r := -1.0
            done := true
        else if low <= simT
            r := t1R
            done := true
    if not done and bar_index - simBar >= calBars
        r := simSide * (close - simE) / simRisk
        done := true
    if done
        float cst = simRisk > 0 ? costTicks * syminfo.mintick / simRisk : 0.0
        float rNet = r - cst
        array.set(bkN, simBk, array.get(bkN, simBk) + 1)
        array.set(bkR, simBk, array.get(bkR, simBk) + rNet)
        array.set(bkB, simBk, array.get(bkB, simBk) + (bar_index - simBar))
        if rNet > 0
            array.set(bkW, simBk, array.get(bkW, simBk) + 1)
        cumR  += rNet
        peakR := math.max(peakR, cumR)
        ddR   := math.max(ddR, peakR - cumR)
        simSide := 0
        lastOut := bar_index

if calibOn and simSide == 0 and flip and bar_index - lastOut > calCool and atrOk and dist > 0
    simSide := verdict
    simE    := planEntry
    simS    := planStop
    simT    := planT1
    simRisk := dist
    simBar  := bar_index
    simBk   := conf >= 75 ? 3 : conf >= 60 ? 2 : conf >= 45 ? 1 : 0

// ── график ─────────────────────────────────────────────────────────────────────
plot(showEma ? e1 : na, "EMA быстрая",   color = color.new(color.gray, 60), linewidth = 1)
plot(showEma ? e2 : na, "EMA средняя",   color = color.new(color.gray, 30), linewidth = 1)
plot(showEma ? e3 : na, "EMA медленная", color = color.new(color.gray, 5),  linewidth = 2)
plot(showEma ? vwapV : na, "VWAP", color = color.new(cWait, 15), linewidth = 2)

vCol = verdict == 1 ? cLong : verdict == -1 ? cShort : cWait
bgcolor(paintBg and verdict != 0 ? color.new(vCol, int(math.max(95.0 - conf * 0.18, 70.0))) : na, title = "Фон вердикта")
barcolor(paintBars ? (verdict == 1 ? cLong : verdict == -1 ? cShort : color.new(color.gray, 45)) : na, title = "Свечи по вердикту")

plotshape(flipL, "Смена на ЛОНГ",  shape.triangleup,   location.belowbar, color = cLong,  size = size.small)
plotshape(flipS, "Смена на ШОРТ",  shape.triangledown, location.abovebar, color = cShort, size = size.small)

plot(score, "Скор",         color = color.new(color.gray, 100), display = display.data_window)
plot(tau,   "τ режим",      color = color.new(color.gray, 100), display = display.data_window)
plot(conf,  "Уверенность",  color = color.new(color.gray, 100), display = display.data_window)
plot(zV,    "σ от VWAP",    color = color.new(color.gray, 100), display = display.data_window)
plot(diP - diM,     "DI+ − DI−",     color = color.new(color.gray, 100), display = display.data_window)
plot(mLine - mSig,  "MACD − сигнал", color = color.new(color.gray, 100), display = display.data_window)

// ── план на графике ────────────────────────────────────────────────────────────
var line  lnE = na
var line  lnS = na
var line  lnA = na
var line  lnB = na
var label lbP = na

if showPlan and flip
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnA)
    line.delete(lnB)
    label.delete(lbP)
    lnE := line.new(bar_index, planEntry, bar_index + 1, planEntry, color = vCol, width = 2)
    lnS := line.new(bar_index, planStop,  bar_index + 1, planStop,  color = cShort, style = line.style_dashed)
    lnA := line.new(bar_index, planT1,    bar_index + 1, planT1,    color = cLong,  style = line.style_dashed)
    lnB := line.new(bar_index, planT2,    bar_index + 1, planT2,    color = cLong,  style = line.style_dotted)
    lbP := label.new(bar_index, verdict == 1 ? low : high,
         text = str.format("{0} · {1}\nскор {2,number,#.#} · уверенность {3,number,#}% · {4}\nвход {5}  стоп {6}\nT1 {7}  T2 {8}  риск {9,number,#.##}%",
             verdict == 1 ? "ЛОНГ" : "ШОРТ", playbook, score, conf, regimeTxt,
             str.tostring(planEntry, format.mintick), str.tostring(planStop, format.mintick),
             str.tostring(planT1, format.mintick), str.tostring(planT2, format.mintick), riskPct),
         style = verdict == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(vCol, 86), textcolor = chart.fg_color, size = size.small,
         textalign = text.align_left)

if showPlan and verdict != 0 and not flip and not na(lnE)
    line.set_x2(lnE, bar_index + 1)
    line.set_x2(lnS, bar_index + 1)
    line.set_x2(lnA, bar_index + 1)
    line.set_x2(lnB, bar_index + 1)

var box bxZ = na
if showZone and barstate.islast
    box.delete(bxZ)
    if verdict != 0 and not na(zTop) and not na(zBot)
        bxZ := box.new(math.max(bar_index - 40, 0), zTop, bar_index + 6, zBot,
             border_color = color.new(vCol, 60), bgcolor = color.new(vCol, 90),
             border_style = line.style_dotted)

// ── панель вердикта ────────────────────────────────────────────────────────────
pPos = posPanel == "Справа сверху" ? position.top_right :
       posPanel == "Справа снизу"  ? position.bottom_right :
       posPanel == "Слева сверху"  ? position.top_left : position.bottom_left

var table tP = table.new(pPos, 4, 21, border_width = 1)

f_row(table t, int r, string a, string b, string c, string d, color bg, color fg) =>
    table.cell(t, 0, r, a, text_color = fg, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, b, text_color = fg, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 2, r, c, text_color = fg, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 3, r, d, text_color = fg, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

f_comp(table t, int r, string nm, float v, float w) =>
    color cc = v > 0.15 ? cLong : v < -0.15 ? cShort : color.gray
    table.cell(t, 0, r, nm, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left)
    table.cell(t, 1, r, f_mini(v), text_color = cc, text_size = size.tiny, text_halign = text.align_center)
    table.cell(t, 2, r, f_sig(v, "#.00"), text_color = cc, text_size = size.tiny, text_halign = text.align_right)
    table.cell(t, 3, r, f_sig(w * v * 100.0 / wSum, "#.0"), text_color = color.gray, text_size = size.tiny, text_halign = text.align_right)
    r

// Слитые ячейки создаются и сливаются ровно один раз: повторный merge_cells —
// ошибка времени выполнения, а запись в «поглощённую» ячейку ничего не делает.
// Поэтому дальше пишем только в левую верхнюю ячейку каждой слитой области.
// varip, а не var: var откатывается на каждом тике живого бара, и слияние
// вызвалось бы повторно.
varip bool tInit = false
if showPanel and barstate.islast and not tInit
    for rr = 0 to 20
        for cc = 0 to 3
            table.cell(tP, cc, rr, "")
    table.merge_cells(tP, 0, 0,  3, 0)    // вердикт
    table.merge_cells(tP, 0, 1,  3, 1)    // шкала скора
    table.merge_cells(tP, 1, 4,  3, 4)    // плейбук
    table.merge_cells(tP, 0, 14, 3, 14)   // заголовок плана
    table.merge_cells(tP, 1, 18, 3, 18)   // зона отката
    table.merge_cells(tP, 0, 20, 3, 20)   // причина блокировки
    tInit := true

if showPanel and barstate.islast
    bgH = color.new(color.gray, 85)
    fgN = chart.fg_color
    vTxt = verdict == 1 ? "▲   Л О Н Г" : verdict == -1 ? "▼   Ш О Р Т" : "■   Ж Д А Т Ь"
    vBg  = color.new(vCol, verdict == 0 ? 80 : int(math.max(70.0 - conf * 0.25, 35.0)))

    table.cell(tP, 0, 0, vTxt, text_color = fgN, text_size = size.normal,
         text_halign = text.align_center, bgcolor = vBg)
    table.cell(tP, 0, 1, f_gauge(score) + "   " + f_sig(score, "#.0"),
         text_color = sgn > 0 ? cLong : sgn < 0 ? cShort : color.gray,
         text_size = size.small, text_halign = text.align_center)

    f_row(tP, 2, "Уверенность", str.tostring(conf, "#") + "%", "Согласие", str.tostring(agreeN) + "/6", na, fgN)
    f_row(tP, 3, "Режим", regimeTxt + "  " + str.tostring(tau, "#.00"), "ADX / Chop",
         str.tostring(nz(adxV), "#") + " / " + str.tostring(chop, "#"), na, fgN)

    table.cell(tP, 0, 4, "Что делать", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tP, 1, 4, playbook, text_color = fgN, text_size = size.tiny, text_halign = text.align_right)

    f_row(tP, 5, "КОМПОНЕНТ", "ШКАЛА", "ЗНАЧ", "ВКЛАД", bgH, color.gray)
    f_comp(tP, 6,  "H старший ТФ", cH, wHe)
    f_comp(tP, 7,  "T тренд",      cT, wT)
    f_comp(tP, 8,  "M структура",  cM, wM)
    f_comp(tP, 9,  "V VWAP",       cV, wV)
    f_comp(tP, 10, "I импульс",    cI, wI)
    f_comp(tP, 11, "D давление",   cD, wD)

    f_row(tP, 12, "Σ тренд", f_mini(trendRaw / 100.0), f_sig(trendRaw, "#.0"),
         "×" + str.tostring(tau, "#.00"), na, fgN)
    f_row(tP, 13, "Σ фейд", f_mini(cF), f_sig(fadeAdj, "#.0"),
         (fadeCut ? "срезан " : "") + "×" + str.tostring(1.0 - tau, "#.00"), na, fadeCut ? cWait : fgN)

    table.cell(tP, 0, 14, "ПЛАН  ·  " + (verdict == 1 ? "ЛОНГ" : verdict == -1 ? "ШОРТ" :
         "гипотеза " + (side == 1 ? "ЛОНГ" : "ШОРТ")),
         text_color = color.gray, text_size = size.tiny, text_halign = text.align_left, bgcolor = bgH)
    f_row(tP, 15, "Вход", str.tostring(planEntry, format.mintick), "Стоп", str.tostring(planStop, format.mintick), na, fgN)
    f_row(tP, 16, "T1 (" + str.tostring(t1R, "#.#") + "R)", str.tostring(planT1, format.mintick),
         "T2 (" + str.tostring(t2R, "#.#") + "R)", str.tostring(planT2, format.mintick), na, fgN)
    f_row(tP, 17, "Риск", str.tostring(dist, format.mintick) + "  (" + str.tostring(riskPct, "#.##") + "%)",
         "Издержки", str.tostring(costR, "#.###") + "R", na, nz(costR, 0.0) > 0.15 ? cShort : fgN)

    table.cell(tP, 0, 18, "Зона отката", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tP, 1, 18, str.tostring(zBot, format.mintick) + "  –  " + str.tostring(zTop, format.mintick),
         text_color = fgN, text_size = size.tiny, text_halign = text.align_right)

    f_row(tP, 19, "ФИЛЬТРЫ", gAll ? "пройдены" : "БЛОК", "ATR ранг",
         str.tostring(nz(atrRank), "#") + "   RVOL " + str.tostring(nz(rvolS, 1.0), "#.0"),
         bgH, gAll ? color.gray : cShort)
    table.cell(tP, 0, 20, gAll ? "торговать разрешено" : "стоп: " + str.replace_all(reason, " · ", "; "),
         text_color = gAll ? color.gray : cShort, text_size = size.tiny, text_halign = text.align_left)


// ── таблица калибровки ─────────────────────────────────────────────────────────
var table tK = table.new(position.bottom_right, 6, 7, border_width = 1)

f_krow(table t, int r, string a, string b, string c, string d, string e, string f, color bg) =>
    table.cell(t, 0, r, a, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, b, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 2, r, c, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 3, r, d, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 4, r, e, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    table.cell(t, 5, r, f, text_color = color.gray,     text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

if calibOn and showCal and barstate.islast
    bgH = color.new(color.gray, 85)
    f_krow(tK, 0, "УВЕРЕННОСТЬ", "СДЕЛОК", "ВИНРЕЙТ", "СРЕДНИЙ R", "БАРОВ", "", bgH)
    names = array.from("< 45", "45–60", "60–75", "≥ 75")
    float bestR = -1e9
    for i = 0 to 3
        if array.get(bkN, i) > 0
            bestR := math.max(bestR, array.get(bkR, i) / array.get(bkN, i))
    int totN = 0
    int totW = 0
    for i = 0 to 3
        int n = array.get(bkN, i)
        float rr = n > 0 ? array.get(bkR, i) / n : na
        float wr = n > 0 ? 100.0 * array.get(bkW, i) / n : na
        float bs = n > 0 ? array.get(bkB, i) * 1.0 / n : na
        bool hot = n > 0 and not na(rr) and math.abs(rr - bestR) < 1e-9
        totN += n
        totW += array.get(bkW, i)
        f_krow(tK, i + 1, array.get(names, i), str.tostring(n),
             n > 0 ? str.tostring(wr, "#.0") + "%" : "—",
             n > 0 ? f_sig(rr, "#.000") : "—",
             n > 0 ? str.tostring(bs, "#.0") : "—",
             hot ? "лучший" : "", hot ? color.new(cWait, 82) : na)
    f_krow(tK, 5, "всего", str.tostring(totN),
         totN > 0 ? str.tostring(100.0 * totW / totN, "#.0") + "%" : "—",
         totN > 0 ? f_sig(cumR / totN, "#.000") : "—",
         "", "", bgH)
    f_krow(tK, 6, "сумма R", f_sig(cumR, "#.1"), "просадка",
         str.tostring(ddR, "#.1") + "R", "издержки", str.tostring(costTicks, "#.#") + " тика", bgH)

// ── алерты ─────────────────────────────────────────────────────────────────────
alertcondition(flipL, "COMPASS · ЛОНГ",  "COMPASS: смещение ЛОНГ")
alertcondition(flipS, "COMPASS · ШОРТ",  "COMPASS: смещение ШОРТ")
alertcondition(verdict == 0 and verdict[1] != 0, "COMPASS · нейтраль", "COMPASS: смещение снято, ЖДАТЬ")
alertcondition(flipL or flipS, "COMPASS · любая смена", "COMPASS: смена смещения")

msg = str.format("COMPASS {0} {1} · {2} · скор {3,number,#.#} · уверенность {4,number,#}% · {5} · {6} | вход {7} стоп {8} T1 {9} T2 {10} | риск {11,number,#.##}% издержки {12,number,#.###}R",
     syminfo.ticker, timeframe.period, verdict == 1 ? "ЛОНГ" : "ШОРТ", score, conf, regimeTxt, playbook,
     str.tostring(planEntry, format.mintick), str.tostring(planStop, format.mintick),
     str.tostring(planT1, format.mintick), str.tostring(planT2, format.mintick), riskPct, nz(costR, 0.0))

if flip
    if confirmed
        if barstate.isconfirmed
            alert(msg, alert.freq_once_per_bar_close)
    else
        alert(msg, alert.freq_once_per_bar)
