//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  MARKUP · авторазметка графика: каналы, горизонтальные уровни, MTF-средние
//
//  Повторяет ручную технику разметки:
//    • каналы тренда — линия тренда от экстремума через следующие свинги того же типа,
//      параллель через противоположную сторону, пунктир посередине;
//      нисходящий — оранжевый, восходящий — зелёный, несколько масштабов сразу
//    • белые горизонтальные уровни от значимых свингов: тянутся вправо и живут
//      после пробоя — поддержка становится сопротивлением
//    • лента средних рабочего ТФ и те же периоды со старших ТФ тонкими линиями
//      с подписями «200 (15м)»; совпавшие средние подписываются через «=»
//      Цвет — по периоду: 20 оранжевый, 50 синий, 100 фиолетовый, 200 жёлтый.
//
//  Без перерисовки — всё решается только на закрытых барах, на истории и в реальном
//  времени одинаково, нарисованное не двигается:
//    • канал фиксируется в момент подтверждения (точка) и больше не меняется. Пунктир
//      от якоря до точки — как канал строился, торговать можно сплошную часть после неё;
//    • изменение структуры — это новый канал, старый остаётся как был и обрывается
//      на баре слома;
//    • уровень появляется, когда подтвердился свинг, и не пропадает от движения цены;
//    • средние старших ТФ — по их закрытым барам.
//  Цена этого — запаздывание: свинг подтверждается через N баров, канал — после свинга.
//
//  Наклонки (правила сверены с авторскими линиями на скриншотах):
//    якорь — экстремум, с которого начался ход (у нисходящего — максимум);
//    линия тренда идёт от якоря через один из свингов после него. Из всех таких линий
//      берётся та, которой касается больше свингов: касание самой линии весит вдвое
//      больше касания параллели, прокол штрафуется, тень может проколоть линию
//      не глубже доли ширины;
//    параллель — по наибольшему числу касаний с другой стороны. Проливы-шпильки
//      до четверти ширины остаются за каналом (нефть: два пролива, семь касаний);
//    касания считаются по свингам втрое мельче масштаба канала, каркас — по крупным;
//    слом — закрытие за линией тренда дальше доли ширины И за последним свингом,
//      который касался линии, либо выход за якорь: новый канал в другую сторону
//      от экстремума внутри сломанного;
//    веер — линия пробита, а структура цела: новый канал от того же якоря
//      через свинг, который её пробил;
//    ускорение — закрытие за параллелью дальше доли ширины: новый канал
//      в ту же сторону от последнего свинга.
// ═══════════════════════════════════════════════════════════════════════════════

indicator("MARKUP · каналы, уровни, MTF-средние", "MARKUP", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ── входные параметры ──────────────────────────────────────────────────────────
gCh = "Каналы"
chOn    = input.bool(true, "Рисовать каналы", group = gCh)
brkK    = input.float(0.15, "Слом: закрытие за линией тренда, доля ширины", minval = 0, step = 0.05, group = gCh)
accK    = input.float(0.35, "Ускорение: закрытие за противоположной границей, доля ширины", minval = 0, step = 0.05, group = gCh)
tolK    = input.float(0.08, "Касание: свинг ближе к линии, доля ширины", minval = 0.01, step = 0.01, group = gCh)
flushK  = input.float(0.25, "Пролив за параллель, не глубже доли ширины", minval = 0, step = 0.05, group = gCh,
     tooltip = "Шпильки за противоположную границу, которые не расширяют канал. 0 — параллель строго по самому дальнему свингу.")
pierceK = input.float(0.35, "Прокол линии тренда, не глубже доли ширины", minval = 0, step = 0.05, group = gCh,
     tooltip = "Насколько тень может проколоть линию, которую подтвердили касания, прежде чем линию придётся перестроить.")
fDiv    = input.int(3, "Касания считать по свингам мельче в N раз", minval = 1, maxval = 10, group = gCh)
extOld  = input.bool(false, "Продлевать сломанные каналы вправо", group = gCh,
     tooltip = "Выключено — сломанный канал обрывается на баре слома.")
showBuild = input.bool(true, "Показывать построение: пунктир от якоря до подтверждения", group = gCh,
     tooltip = "Канал становится известен в момент подтверждения (точка). Пунктир до точки — как он строился, торговать можно только сплошную часть после неё.")
cUp     = input.color(#4CAF50, "Восходящий", group = gCh, inline = "cc")
cDn     = input.color(#FF9800, "Нисходящий", group = gCh, inline = "cc")
fillTr  = input.int(93, "Заливка, прозрачность", minval = 0, maxval = 100, group = gCh)

gSc = "Масштабы каналов: свинг, толщина, сколько прошлых каналов держать"
s1On  = input.bool(true, "Старший ", group = gSc, inline = "s1")
s1Len = input.int(130, "", minval = 2, maxval = 500, group = gSc, inline = "s1")
s1W   = input.int(2, "", minval = 1, maxval = 5, group = gSc, inline = "s1")
s1Old = input.int(3, "", minval = 0, maxval = 10, group = gSc, inline = "s1")
s2On  = input.bool(true, "Рабочий ", group = gSc, inline = "s2")
s2Len = input.int(40, "", minval = 2, maxval = 500, group = gSc, inline = "s2")
s2W   = input.int(2, "", minval = 1, maxval = 5, group = gSc, inline = "s2")
s2Old = input.int(3, "", minval = 0, maxval = 10, group = gSc, inline = "s2")
s3On  = input.bool(false, "Локальный", group = gSc, inline = "s3")
s3Len = input.int(12, "", minval = 2, maxval = 500, group = gSc, inline = "s3")
s3W   = input.int(1, "", minval = 1, maxval = 5, group = gSc, inline = "s3",
     tooltip = "Свинг — сколько баров слева и справа должны быть ниже максимума (выше минимума). Чем больше, тем крупнее каналы. Каналы со скриншотов на 1м — это свинг около 130 баров.")
s3Old = input.int(3, "", minval = 0, maxval = 10, group = gSc, inline = "s3")

gLv = "Горизонтальные уровни"
lvOn    = input.bool(true, "Рисовать уровни", group = gLv)
lvLen   = input.int(30, "Свинг для уровня, баров слева и справа", minval = 2, maxval = 500, group = gLv)
lvGap   = input.float(4.0, "Свинг ближе к уровню — касание, а не новый уровень, ATR(200)", minval = 0, step = 0.5, group = gLv)
lvMax   = input.int(16, "Уровней на графике", minval = 1, maxval = 60, group = gLv,
     tooltip = "Уровень появляется, когда подтвердился свинг, и дальше не исчезает. Сверх лимита убирается тот, которого цена дольше всех не касалась.")
lvCol   = input.color(color.white, "Цвет", group = gLv, inline = "lv")
lvW     = input.int(2, "толщина", minval = 1, maxval = 5, group = gLv, inline = "lv")
lvPrice = input.bool(false, "Подписывать цену и число касаний", group = gLv)

gMa = "Средние: периоды и цвета"
maType = input.string("EMA", "Тип", options = ["EMA", "SMA"], group = gMa)
mL1 = input.int(20,  "Период 1", minval = 1, group = gMa, inline = "m1")
cL1 = input.color(#FF9800, "", group = gMa, inline = "m1")
mL2 = input.int(50,  "Период 2", minval = 1, group = gMa, inline = "m2")
cL2 = input.color(#2962FF, "", group = gMa, inline = "m2")
mL3 = input.int(100, "Период 3", minval = 1, group = gMa, inline = "m3")
cL3 = input.color(#7E57C2, "", group = gMa, inline = "m3")
mL4 = input.int(200, "Период 4", minval = 1, group = gMa, inline = "m4")
cL4 = input.color(#FFEB3B, "", group = gMa, inline = "m4")

gRib = "Лента на рабочем ТФ"
ribOn = input.bool(true, "Периоды 1–4", group = gRib)
r0On  = input.bool(true, "Быстрая", group = gRib, inline = "r0")
r0    = input.int(9, "", minval = 1, group = gRib, inline = "r0")
c0    = input.color(#F23645, "", group = gRib, inline = "r0")
ribW  = input.int(2, "Толщина", minval = 1, maxval = 5, group = gRib)

gMtf = "Средние старших ТФ (ТФ не выше рабочего скрываются сами)"
mtfOn = input.bool(true, "Рисовать", group = gMtf)
mtfClosed = input.bool(true, "Только закрытые бары старших ТФ", group = gMtf,
     tooltip = "Включено — значение старшего ТФ меняется только когда его бар закрылся, на истории и в реальном времени одинаково. Выключено — текущий бар старшего ТФ меняется до закрытия, и после перезагрузки история выглядит иначе, чем в реальном времени.")
tf1 = input.timeframe("5", "", group = gMtf, inline = "t1")
t1a = input.bool(false, "п1", group = gMtf, inline = "t1")
t1b = input.bool(false, "п2", group = gMtf, inline = "t1")
t1c = input.bool(true,  "п3", group = gMtf, inline = "t1")
t1d = input.bool(true,  "п4", group = gMtf, inline = "t1")
tf2 = input.timeframe("15", "", group = gMtf, inline = "t2")
t2a = input.bool(true, "п1", group = gMtf, inline = "t2")
t2b = input.bool(true, "п2", group = gMtf, inline = "t2")
t2c = input.bool(true, "п3", group = gMtf, inline = "t2")
t2d = input.bool(true, "п4", group = gMtf, inline = "t2")
tf3 = input.timeframe("60", "", group = gMtf, inline = "t3")
t3a = input.bool(true, "п1", group = gMtf, inline = "t3")
t3b = input.bool(true, "п2", group = gMtf, inline = "t3")
t3c = input.bool(true, "п3", group = gMtf, inline = "t3")
t3d = input.bool(true, "п4", group = gMtf, inline = "t3",
     tooltip = "п1…п4 — периоды 1–4 из блока «Средние: периоды и цвета».")
mtfTr  = input.int(70, "Прозрачность линий", minval = 0, maxval = 100, group = gMtf)
lbOff  = input.int(15, "Подписи: отступ от последнего бара, баров", minval = 0, maxval = 200, group = gMtf)
lbStep = input.int(25, "Подписи: шаг между ТФ, баров", minval = 0, maxval = 100, group = gMtf)
lbTol  = input.float(0.3, "Объединять подписи ближе, ATR(14)", minval = 0, step = 0.05, group = gMtf)
lbSize = input.string(size.normal, "Размер подписей", options = [size.small, size.normal, size.large], group = gMtf)

// ── константы ─────────────────────────────────────────────────────────────────
BUF       = 5000   // глубина собственного буфера цен для поиска экстремумов
PIV_MAX   = 300    // свингов одного типа на масштаб
CAP       = 16     // свингов с каждой стороны, по которым подбирается линия
W_BASE    = 2.0    // касание линии тренда весит вдвое больше касания параллели
PEN       = 2.0    // прокол стоит двух касаний
REF_TOUCH = 0.15   // свинг ближе этой доли ширины к линии тренда — её касание, ориентир для слома

// ── буфер цен ─────────────────────────────────────────────────────────────────
// Кольцевой буфер вместо high[i]: поиск экстремума идёт только в момент слома,
// и так не нужно раздувать историю всех рядов через max_bars_back.
var array<float> hBuf = array.new_float(BUF, na)
var array<float> lBuf = array.new_float(BUF, na)
hBuf.set(bar_index % BUF, high)
lBuf.set(bar_index % BUF, low)

// самый высокий (самый низкий) бар от fromBar до текущего включительно → [бар, цена]
f_extreme(int fromBar, bool wantHigh) =>
    int n = math.min(bar_index - fromBar, BUF - 1)
    int bx = bar_index
    float best = wantHigh ? high : low
    if n > 0
        for i = 1 to n
            int b = bar_index - i
            float v = wantHigh ? hBuf.get(b % BUF) : lBuf.get(b % BUF)
            if wantHigh ? v > best : v < best
                bx := b
                best := v
    [bx, best]

// ── каналы ────────────────────────────────────────────────────────────────────
type Pt
    int   x
    float y

type Chan
    int      dir = 0       // +1 восходящий, −1 нисходящий, 0 ещё не начат
    int      ax            // якорь: бар и цена экстремума, с которого начался ход
    float    ay
    float    slope         // наклон линии тренда за бар; na, пока канал не подобран
    float    off           // сдвиг параллели от линии тренда (знак — направление канала)
    int      ex            // бегущий экстремум с другой стороны — будущий якорь разворота
    float    ey
    bool     fixed = false // подтверждён: геометрия больше не меняется
    bool     painted = false
    int      tc            // бар подтверждения
    int      minX          // линия тренда должна пройти через свинг не раньше этого бара (веер)
    float    refY          // ориентир слома, унаследованный от пробитой линии (веер)
    line     lb            // рабочая часть: от подтверждения вправо
    line     lo
    line     lm
    linefill lf
    line     bb            // построение: от якоря до подтверждения
    line     bo
    label    mk            // точка подтверждения

type Scale
    int         len        // каркас: свинги этого размера задают якоря и слом
    int         flen       // касания: свинги мельче, по ним подбираются линии
    array<Pt>   hs
    array<Pt>   ls
    array<Pt>   fh
    array<Pt>   fl
    Chan        cur
    array<Chan> old

method yAt(Chan c, int x) => c.ay + c.slope * (x - c.ax)

method ready(Chan c) => c.dir != 0 and not na(c.slope) and not na(c.off) and c.off * c.dir > 0

method kill(Chan c) =>
    line.delete(c.lb)
    line.delete(c.lo)
    line.delete(c.lm)
    linefill.delete(c.lf)
    line.delete(c.bb)
    line.delete(c.bo)
    label.delete(c.mk)
    c

f_push(array<Pt> a, int x, float y) =>
    a.push(Pt.new(x, y))
    if a.size() > PIV_MAX
        a.shift()
    x

// свинги после якоря, не больше CAP последних
f_recent(array<Pt> a, int ax) =>
    array<Pt> out = array.new<Pt>()
    int n = a.size()
    if n > 0
        for i = n - 1 to 0
            Pt p = a.get(i)
            if p.x <= ax or out.size() >= CAP
                break
            out.unshift(p)
    out

// ширина канала по глубинам свингов с другой стороны: больше касаний, проколы штрафуются,
// шпильки глубже flushK не допускаются → [ширина, касаний, проколов]
f_width(array<float> d) =>
    float bestW = na
    float bestS = na
    int bestT = 0
    int bestP = 0
    if d.size() > 0
        float dmax = d.max()
        for W in d
            if dmax <= W * (1 + flushK)
                int t = 0
                int p = 0
                for v in d
                    if math.abs(v - W) <= tolK * W
                        t := t + 1
                    else if v > W * (1 + tolK)
                        p := p + 1
                float sc = t - PEN * p
                if na(bestS) or sc > bestS or (sc == bestS and (p < bestP or (p == bestP and W > bestW)))
                    bestW := W
                    bestS := sc
                    bestT := t
                    bestP := p
    [bestW, bestT, bestP]

// подбор канала: линия тренда от якоря через каждый мелкий свинг того же типа,
// для каждой — параллель по касаниям; побеждает канал с лучшим счётом касаний
method fit(Scale s) =>
    Chan c = s.cur
    array<Pt> tl = f_recent(c.dir < 0 ? s.fh : s.fl, c.ax)
    array<Pt> op = f_recent(c.dir < 0 ? s.fl : s.fh, c.ax)
    float bestSl = na
    float bestW = na
    float bestS = na
    int bestPen = 0
    for b in tl
        if b.x >= c.minX
            float sl = (b.y - c.ay) / (b.x - c.ax)
            // глубина свингов с другой стороны, считая от линии тренда вглубь канала
            array<float> d = array.new_float()
            for p in op
                float v = (p.y - (c.ay + sl * (p.x - c.ax))) * c.dir
                if v > 0
                    d.push(v)
            [W, ot, opn] = f_width(d)
            if not na(W)
                int bt = 0
                int bp = 0
                bool ok = true
                for q in tl
                    // выход свинга за линию тренда: > 0 — прокол
                    float e = (q.y - (c.ay + sl * (q.x - c.ax))) * -c.dir
                    if e > pierceK * W
                        ok := false
                    if math.abs(e) <= tolK * W
                        bt := bt + 1
                    else if e > tolK * W
                        bp := bp + 1
                if ok
                    float sc = W_BASE * bt + ot - PEN * (bp + opn)
                    int pen = bp + opn
                    if na(bestS) or sc > bestS or (sc == bestS and (pen < bestPen or (pen == bestPen and W > bestW)))
                        bestS := sc
                        bestSl := sl
                        bestW := W
                        bestPen := pen
    c.slope := bestSl
    c.off := na(bestSl) ? na : bestW * c.dir
    c.off

f_prune(array<Pt> a, int ax) =>
    while a.size() > 0
        if a.first().x > ax
            break
        a.shift()
    ax

method restart(Scale s, int dir, int ax, float ay, int minX, float refY) =>
    Chan c = Chan.new(dir, ax, ay)
    [exX, exY] = f_extreme(ax, dir > 0)
    c.ex := exX
    c.ey := exY
    c.minX := minX
    c.refY := refY
    s.cur := c
    // свинги до якоря новому каналу не нужны
    f_prune(s.hs, ax)
    f_prune(s.ls, ax)
    f_prune(s.fh, ax)
    f_prune(s.fl, ax)
    ax

// канал закончился: рабочая часть обрывается на этом баре (или тянется дальше — по настройке),
// сам канал уходит в историю; геометрия не меняется
method archive(Scale s, int keep) =>
    Chan c = s.cur
    if c.fixed and not na(c.lb)
        if not extOld
            c.lb.set_xy2(bar_index, c.yAt(bar_index))
            c.lo.set_xy2(bar_index, c.yAt(bar_index) + c.off)
            c.lm.set_xy2(bar_index, c.yAt(bar_index) + c.off / 2)
            c.lb.set_extend(extend.none)
            c.lo.set_extend(extend.none)
            c.lm.set_extend(extend.none)
        s.old.push(c)
        if s.old.size() > keep
            s.old.shift().kill()
    keep

// канал подтверждён, но цена уже за линией — ждать следующего свинга
method brokenNow(Chan c) =>
    bool dn = c.dir < 0
    float base = c.yAt(bar_index)
    float w = math.abs(c.off)
    bool lineBrk = dn ? close > base + brkK * w : close < base - brkK * w
    bool acc = dn ? close < base + c.off - accK * w : close > base + c.off + accK * w
    lineBrk or acc

// один закрытый бар. Событие: ±1 слом (новое направление), ±2 ускорение, ±3 канал подтверждён,
// ±4 веер (линия пробита без слома структуры), 0 — ничего
method update(Scale s, float ph, float pl, float fph, float fpl, int keepOld) =>
    int ev = 0
    bool newSkel = not na(ph) or not na(pl)
    bool newFine = not na(fph) or not na(fpl)
    if not na(ph)
        f_push(s.hs, bar_index - s.len, ph)
    if not na(pl)
        f_push(s.ls, bar_index - s.len, pl)
    if not na(fph)
        f_push(s.fh, bar_index - s.flen, fph)
    if not na(fpl)
        f_push(s.fl, bar_index - s.flen, fpl)
    Chan c = s.cur
    if c.dir == 0
        if not na(ph)
            s.restart(-1, bar_index - s.len, ph, bar_index - s.len, na)
        else if not na(pl)
            s.restart(1, bar_index - s.len, pl, bar_index - s.len, na)
    else
        bool dn = c.dir < 0
        if dn ? low < c.ey : high > c.ey
            c.ex := bar_index
            c.ey := dn ? low : high
        bool flipA = dn ? high > c.ay : low < c.ay
        if not c.fixed
            // кандидат: подбирается на новых свингах, пока не подтвердится
            if (newFine or newSkel) and not flipA
                array<Pt> sk = dn ? s.hs : s.ls
                if sk.size() > 0 and sk.last().x > c.ax
                    s.fit()
                    if c.ready() and not c.brokenNow()
                        c.fixed := true
                        c.tc := bar_index
                        ev := 3 * c.dir
            if not c.fixed
                bool sb = not na(c.refY) and (dn ? close > c.refY : close < c.refY)
                if flipA or sb
                    s.restart(-c.dir, c.ex, c.ey, c.ex, na)
                    ev := -c.dir
        else
            float base = c.yAt(bar_index)
            float w = math.abs(c.off)
            float opp = base + c.off
            bool lineBrk = dn ? close > base + brkK * w : close < base - brkK * w
            // ориентир слома — последний крупный свинг, который касался линии тренда
            float refY = c.ay
            array<Pt> sk = dn ? s.hs : s.ls
            int n = sk.size()
            if n > 0
                for i = n - 1 to 0
                    Pt p = sk.get(i)
                    if p.x <= c.ax
                        break
                    if math.abs(p.y - c.yAt(p.x)) <= REF_TOUCH * w
                        refY := p.y
                        break
            bool structBrk = dn ? close > refY : close < refY
            bool accel = dn ? close < opp - accK * w : close > opp + accK * w
            if flipA or (lineBrk and structBrk)
                s.archive(keepOld)
                s.restart(-c.dir, c.ex, c.ey, c.ex, na)
                ev := -c.dir
            else if accel
                if sk.size() > 0
                    [nx, ny] = f_extreme(sk.last().x, dn)
                    s.archive(keepOld)
                    s.restart(c.dir, nx, ny, nx, na)
                    ev := 2 * c.dir
            else if lineBrk
                // веер: линия пробита, структура цела — новая линия от того же якоря через новый свинг
                s.archive(keepOld)
                s.restart(c.dir, c.ax, c.ay, bar_index - s.flen, refY)
                ev := 4 * c.dir
    ev

// рисуется один раз — в момент подтверждения; дальше линии не трогаются
method paint(Scale s, int w, bool hide) =>
    Chan c = s.cur
    if c.fixed and not c.painted
        c.painted := true
        if not hide
            color col = c.dir > 0 ? cUp : cDn
            int t = c.tc
            float yb = c.yAt(t)
            c.lb := line.new(t, yb, t + 1, c.yAt(t + 1), color = col, width = w, extend = extend.right)
            c.lo := line.new(t, yb + c.off, t + 1, c.yAt(t + 1) + c.off, color = col, width = w, extend = extend.right)
            c.lm := line.new(t, yb + c.off / 2, t + 1, c.yAt(t + 1) + c.off / 2, color = col, width = 1,
                 style = line.style_dashed, extend = extend.right)
            c.lf := linefill.new(c.lb, c.lo, color.new(col, fillTr))
            if showBuild
                int x1 = math.max(c.ax, bar_index - BUF + 1)
                c.bb := line.new(x1, c.yAt(x1), t, yb, color = color.new(col, 30), width = 1, style = line.style_dotted)
                c.bo := line.new(x1, c.yAt(x1) + c.off, t, yb + c.off, color = color.new(col, 30), width = 1,
                     style = line.style_dotted)
                c.mk := label.new(t, yb, "", color = col, style = label.style_circle, size = size.tiny)
    w

// младший масштаб не рисует канал, если в момент подтверждения он повторяет старший:
// тот же ход и почти тот же наклон
f_same(Chan a, Chan b) =>
    a.ready() and b.fixed and b.ready() and a.dir == b.dir and (a.ax == b.ax or math.abs(a.slope - b.slope) <= 0.25 * math.abs(b.slope))

f_newScale(int len, int flen) =>
    Scale.new(len, flen, array.new<Pt>(), array.new<Pt>(), array.new<Pt>(), array.new<Pt>(), Chan.new(), array.new<Chan>())

f1 = math.max(2, math.floor(s1Len / fDiv))
f2 = math.max(2, math.floor(s2Len / fDiv))
f3 = math.max(2, math.floor(s3Len / fDiv))

var Scale sc1 = f_newScale(s1Len, f1)
var Scale sc2 = f_newScale(s2Len, f2)
var Scale sc3 = f_newScale(s3Len, f3)

ph1  = ta.pivothigh(high, s1Len, s1Len)
pl1  = ta.pivotlow(low, s1Len, s1Len)
fph1 = ta.pivothigh(high, f1, f1)
fpl1 = ta.pivotlow(low, f1, f1)
ph2  = ta.pivothigh(high, s2Len, s2Len)
pl2  = ta.pivotlow(low, s2Len, s2Len)
fph2 = ta.pivothigh(high, f2, f2)
fpl2 = ta.pivotlow(low, f2, f2)
ph3  = ta.pivothigh(high, s3Len, s3Len)
pl3  = ta.pivotlow(low, s3Len, s3Len)
fph3 = ta.pivothigh(high, f3, f3)
fpl3 = ta.pivotlow(low, f3, f3)

// всё решается и рисуется только на закрытом баре: на истории и в реальном времени одинаково
int ev1 = 0
int ev2 = 0
int ev3 = 0
if chOn and barstate.isconfirmed
    if s1On
        ev1 := sc1.update(ph1, pl1, fph1, fpl1, s1Old)
        sc1.paint(s1W, false)
    if s2On
        ev2 := sc2.update(ph2, pl2, fph2, fpl2, s2Old)
        sc2.paint(s2W, s1On and f_same(sc2.cur, sc1.cur))
    if s3On
        ev3 := sc3.update(ph3, pl3, fph3, fpl3, s3Old)
        sc3.paint(s3W, (s2On and f_same(sc3.cur, sc2.cur)) or (s1On and f_same(sc3.cur, sc1.cur)))

// ── горизонтальные уровни ─────────────────────────────────────────────────────
// Уровень рисуется в момент подтверждения свинга и дальше не двигается. Какие уровни
// видны, не зависит от текущей цены — только от истории касаний.
type Level
    float price
    int   x
    int   hits
    int   lastT      // бар последнего касания
    line  ln
    label lb

var array<Level> lvAll = array.new<Level>()

phL   = ta.pivothigh(high, lvLen, lvLen)
plL   = ta.pivotlow(low, lvLen, lvLen)
atrLv = nz(ta.atr(200), high - low)

f_lvText(Level l) => str.tostring(l.price, format.mintick) + (l.hits > 1 ? "  ×" + str.tostring(l.hits) : "")

// свинг рядом с известным уровнем — ещё одно касание, иначе новый уровень
f_level(array<Level> lv, float p, int x, float gap) =>
    int best = -1
    float bestD = gap
    for [i, l] in lv
        float d = math.abs(l.price - p)
        if d <= bestD
            best := i
            bestD := d
    if best >= 0
        Level hit = lv.get(best)
        hit.hits := hit.hits + 1
        hit.lastT := bar_index
        if not na(hit.lb)
            hit.lb.set_text(f_lvText(hit))
    else
        Level nl = Level.new(p, x, 1, bar_index)
        nl.ln := line.new(math.max(x, bar_index - BUF + 1), p, bar_index, p, color = lvCol, width = lvW, extend = extend.right)
        if lvPrice
            nl.lb := label.new(x, p, f_lvText(nl), color = color(na), style = label.style_label_lower_left,
                 textcolor = lvCol, size = size.small)
        lv.push(nl)
        if lv.size() > lvMax
            int oi = 0
            for [i, l] in lv
                if l.lastT < lv.get(oi).lastT
                    oi := i
            Level o = lv.remove(oi)
            line.delete(o.ln)
            label.delete(o.lb)
    best

if lvOn and barstate.isconfirmed
    if not na(phL)
        f_level(lvAll, phL, bar_index - lvLen, atrLv * lvGap)
    if not na(plL)
        f_level(lvAll, plL, bar_index - lvLen, atrLv * lvGap)

// ── средние: лента рабочего ТФ ────────────────────────────────────────────────
f_ma(float src, simple int len) =>
    float e = ta.ema(src, len)
    float s = ta.sma(src, len)
    maType == "SMA" ? s : e

rb0 = f_ma(close, r0)
rb1 = f_ma(close, mL1)
rb2 = f_ma(close, mL2)
rb3 = f_ma(close, mL3)
rb4 = f_ma(close, mL4)
plot(ribOn and r0On ? rb0 : na, "Лента · быстрая", c0, ribW)
plot(ribOn ? rb1 : na, "Лента · п1", cL1, ribW)
plot(ribOn ? rb2 : na, "Лента · п2", cL2, ribW)
plot(ribOn ? rb3 : na, "Лента · п3", cL3, ribW)
plot(ribOn ? rb4 : na, "Лента · п4", cL4, ribW)

// ── средние старших ТФ ────────────────────────────────────────────────────────
f_tfName(simple string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 60 ? str.tostring(sec) + "с" :
     sec < 3600 ? str.tostring(math.round(sec / 60)) + "м" :
     sec < 86400 ? str.tostring(math.round(sec / 3600)) + "ч" :
     sec < 604800 ? str.tostring(math.round(sec / 86400)) + "Д" :
     sec < 2419200 ? str.tostring(math.round(sec / 604800)) + "Н" :
     str.tostring(math.round(sec / 2628003)) + "М"

tfOk1 = mtfOn and timeframe.in_seconds(tf1) > timeframe.in_seconds()
tfOk2 = mtfOn and timeframe.in_seconds(tf2) > timeframe.in_seconds()
tfOk3 = mtfOn and timeframe.in_seconds(tf3) > timeframe.in_seconds()
n1 = f_tfName(tf1)
n2 = f_tfName(tf2)
n3 = f_tfName(tf3)

// без перерисовки: значение предыдущего, уже закрытого бара старшего ТФ (штатный приём [1] + lookahead_on)
f_maB(float src, simple int len, simple int back) =>
    float e = ta.ema(src, len)
    float s = ta.sma(src, len)
    maType == "SMA" ? s[back] : e[back]

bk = mtfClosed ? 1 : 0
la = mtfClosed ? barmerge.lookahead_on : barmerge.lookahead_off
[a1, b1, c1, d1] = request.security(syminfo.tickerid, tf1, [f_maB(close, mL1, bk), f_maB(close, mL2, bk), f_maB(close, mL3, bk), f_maB(close, mL4, bk)], lookahead = la)
[a2, b2, c2, d2] = request.security(syminfo.tickerid, tf2, [f_maB(close, mL1, bk), f_maB(close, mL2, bk), f_maB(close, mL3, bk), f_maB(close, mL4, bk)], lookahead = la)
[a3, b3, c3, d3] = request.security(syminfo.tickerid, tf3, [f_maB(close, mL1, bk), f_maB(close, mL2, bk), f_maB(close, mL3, bk), f_maB(close, mL4, bk)], lookahead = la)

plot(tfOk1 and t1a ? a1 : na, "ТФ1 · п1", color.new(cL1, mtfTr), 1, plot.style_stepline)
plot(tfOk1 and t1b ? b1 : na, "ТФ1 · п2", color.new(cL2, mtfTr), 1, plot.style_stepline)
plot(tfOk1 and t1c ? c1 : na, "ТФ1 · п3", color.new(cL3, mtfTr), 1, plot.style_stepline)
plot(tfOk1 and t1d ? d1 : na, "ТФ1 · п4", color.new(cL4, mtfTr), 1, plot.style_stepline)
plot(tfOk2 and t2a ? a2 : na, "ТФ2 · п1", color.new(cL1, mtfTr), 1, plot.style_stepline)
plot(tfOk2 and t2b ? b2 : na, "ТФ2 · п2", color.new(cL2, mtfTr), 1, plot.style_stepline)
plot(tfOk2 and t2c ? c2 : na, "ТФ2 · п3", color.new(cL3, mtfTr), 1, plot.style_stepline)
plot(tfOk2 and t2d ? d2 : na, "ТФ2 · п4", color.new(cL4, mtfTr), 1, plot.style_stepline)
plot(tfOk3 and t3a ? a3 : na, "ТФ3 · п1", color.new(cL1, mtfTr), 1, plot.style_stepline)
plot(tfOk3 and t3b ? b3 : na, "ТФ3 · п2", color.new(cL2, mtfTr), 1, plot.style_stepline)
plot(tfOk3 and t3c ? c3 : na, "ТФ3 · п3", color.new(cL3, mtfTr), 1, plot.style_stepline)
plot(tfOk3 and t3d ? d3 : na, "ТФ3 · п4", color.new(cL4, mtfTr), 1, plot.style_stepline)

// подписи справа от цены: каждый ТФ в своей колонке, совпавшие средние — одной строкой через «=»
var array<label> mtfLbls = array.new<label>()
atr14 = ta.atr(14)

f_put(array<float> vs, array<string> ts, array<color> cs, array<int> xs, bool on, float v, string t, color c, int x) =>
    if on and not na(v)
        vs.push(v)
        ts.push(t)
        cs.push(c)
        xs.push(x)
    on

if barstate.islast
    for lb in mtfLbls
        lb.delete()
    mtfLbls.clear()
    if mtfOn
        array<float>  vs = array.new_float()
        array<string> ts = array.new_string()
        array<color>  cs = array.new_color()
        array<int>    xs = array.new_int()
        int x1 = bar_index + lbOff
        int x2 = x1 + lbStep
        int x3 = x2 + lbStep
        f_put(vs, ts, cs, xs, tfOk1 and t1a, a1, str.tostring(mL1) + " (" + n1 + ")", cL1, x1)
        f_put(vs, ts, cs, xs, tfOk1 and t1b, b1, str.tostring(mL2) + " (" + n1 + ")", cL2, x1)
        f_put(vs, ts, cs, xs, tfOk1 and t1c, c1, str.tostring(mL3) + " (" + n1 + ")", cL3, x1)
        f_put(vs, ts, cs, xs, tfOk1 and t1d, d1, str.tostring(mL4) + " (" + n1 + ")", cL4, x1)
        f_put(vs, ts, cs, xs, tfOk2 and t2a, a2, str.tostring(mL1) + " (" + n2 + ")", cL1, x2)
        f_put(vs, ts, cs, xs, tfOk2 and t2b, b2, str.tostring(mL2) + " (" + n2 + ")", cL2, x2)
        f_put(vs, ts, cs, xs, tfOk2 and t2c, c2, str.tostring(mL3) + " (" + n2 + ")", cL3, x2)
        f_put(vs, ts, cs, xs, tfOk2 and t2d, d2, str.tostring(mL4) + " (" + n2 + ")", cL4, x2)
        f_put(vs, ts, cs, xs, tfOk3 and t3a, a3, str.tostring(mL1) + " (" + n3 + ")", cL1, x3)
        f_put(vs, ts, cs, xs, tfOk3 and t3b, b3, str.tostring(mL2) + " (" + n3 + ")", cL2, x3)
        f_put(vs, ts, cs, xs, tfOk3 and t3c, c3, str.tostring(mL3) + " (" + n3 + ")", cL3, x3)
        f_put(vs, ts, cs, xs, tfOk3 and t3d, d3, str.tostring(mL4) + " (" + n3 + ")", cL4, x3)
        int n = vs.size()
        if n > 0
            array<int> ord = vs.sort_indices(order.ascending)
            float tol = nz(atr14, high - low) * lbTol
            int i = 0
            while i < n
                int k0 = ord.get(i)
                float sum = vs.get(k0)
                string txt = ts.get(k0)
                int xm = xs.get(k0)
                int j = i + 1
                while j < n
                    int kj = ord.get(j)
                    if vs.get(kj) - vs.get(ord.get(j - 1)) > tol
                        break
                    sum := sum + vs.get(kj)
                    txt := txt + " = " + ts.get(kj)
                    xm := math.min(xm, xs.get(kj))
                    j := j + 1
                mtfLbls.push(label.new(xm, sum / (j - i), txt, color = color(na), style = label.style_label_left,
                     textcolor = cs.get(k0), size = lbSize))
                i := j

// ── алерты ────────────────────────────────────────────────────────────────────
// Все события — на закрытом баре. «Новый канал» — момент, с которого канал можно торговать.
alertcondition(ev1 == 3,  "Старший: новый канал вверх", "{{ticker}} {{interval}}: подтверждён старший восходящий канал")
alertcondition(ev1 == -3, "Старший: новый канал вниз",  "{{ticker}} {{interval}}: подтверждён старший нисходящий канал")
alertcondition(ev1 == 1,  "Старший: слом вверх", "{{ticker}} {{interval}}: старший нисходящий канал сломан вверх")
alertcondition(ev1 == -1, "Старший: слом вниз",  "{{ticker}} {{interval}}: старший восходящий канал сломан вниз")
alertcondition(ev2 == 3,  "Рабочий: новый канал вверх", "{{ticker}} {{interval}}: подтверждён рабочий восходящий канал")
alertcondition(ev2 == -3, "Рабочий: новый канал вниз",  "{{ticker}} {{interval}}: подтверждён рабочий нисходящий канал")
alertcondition(ev2 == 1,  "Рабочий: слом вверх", "{{ticker}} {{interval}}: рабочий нисходящий канал сломан вверх")
alertcondition(ev2 == -1, "Рабочий: слом вниз",  "{{ticker}} {{interval}}: рабочий восходящий канал сломан вниз")
alertcondition(ev3 == 3,  "Локальный: новый канал вверх", "{{ticker}} {{interval}}: подтверждён локальный восходящий канал")
alertcondition(ev3 == -3, "Локальный: новый канал вниз",  "{{ticker}} {{interval}}: подтверждён локальный нисходящий канал")
alertcondition(ev3 == 1,  "Локальный: слом вверх", "{{ticker}} {{interval}}: локальный нисходящий канал сломан вверх")
alertcondition(ev3 == -1, "Локальный: слом вниз",  "{{ticker}} {{interval}}: локальный восходящий канал сломан вниз")
