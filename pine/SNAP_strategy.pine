//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SNAP · стратегия для бэктеста
//
//  Тот же движок, что и в индикаторе SNAP (ядро скопировано один в один), но
//  сделки исполняет движок TradingView — нативный отчёт с эквити, просадкой и
//  списком сделок. Винрейт из отчёта — это и есть честная проверка обещания:
//  таблица индикатора и вкладка «Тестер стратегии» должны показать одно и то же.
//
//  Теневой симулятор из ядра оставлен нетронутым: он ведёт контроллер R:R и гейт
//  (на то, какие сигналы вообще появляются), а стратегия исполняет уже готовые.
//
//  Вход по закрытию бара-триггера, стоп за свингом, цель = R:R × риск, тайм-стоп.
//  Комиссию и проскальзывание задайте во вкладке «Свойства» и продублируйте в поле
//  «Комиссия и проскальзывание, тиков» — контроллер должен видеть те же издержки,
//  что и отчёт, иначе он будет держать цель, которой на самом деле нет.
// ═══════════════════════════════════════════════════════════════════════════════

strategy("SNAP · стратегия", "SNAP S", overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 100000, commission_type = strategy.commission.percent,
     commission_value = 0.005, slippage = 2, pyramiding = 0,
     calc_on_every_tick = false, process_orders_on_close = true,
     max_lines_count = 500, max_labels_count = 500)

// ── входные параметры ──────────────────────────────────────────────────────────
// ── ядро ───────────────────────────────────────────────────────────────────────
gCore = "Ядро"
meanLen   = input.int(20, "Средняя, к которой возвращается цена", minval = 3, group = gCore)
atrLen    = input.int(14, "ATR", minval = 2, group = gCore)
ctxLen    = input.int(8, "Окно контекста (максимум X/E/V)", minval = 1, group = gCore)
gain      = input.float(1.25, "gain — нормировка скора", minval = 0.5, maxval = 3.0, step = 0.01, group = gCore)
thrEntry  = input.float(82.0, "Порог входа", minval = 1, maxval = 130, step = 0.5, group = gCore,
     tooltip = "Качество отбора. Винрейт держит контроллер, а порог решает, какой ценой: чем выше порог, тем дальше цель при том же винрейте. Ставится по таблице калибровки.")
thrWatch  = input.float(66.0, "Порог наблюдения", minval = 1, maxval = 130, step = 0.5, group = gCore)
confirmed = input.bool(true, "Сигналы только по закрытым барам", group = gCore,
     tooltip = "Выключить — сигнал появится внутри формирующегося бара и может исчезнуть.")

gW = "Веса компонентов"
wX = input.float(0.26, "X · растяжение", minval = 0, maxval = 1, step = 0.01, group = gW)
wE = input.float(0.22, "E · истощение",  minval = 0, maxval = 1, step = 0.01, group = gW)
wB = input.float(0.30, "B · реклейм",    minval = 0, maxval = 1, step = 0.01, group = gW)
wV = input.float(0.22, "V · магнит VWAP",minval = 0, maxval = 1, step = 0.01, group = gW)

gX = "X · растяжение"
zFull = input.float(2.2, "Полное растяжение, σ",   minval = 0.2, step = 0.1, group = gX)
aFull = input.float(1.6, "Полное растяжение, ATR", minval = 0.2, step = 0.1, group = gX)

gE = "E · истощение"
volLen  = input.int(20, "Окно среднего объёма", minval = 2, group = gE)
volFull = input.float(2.2, "Климакс объёма, × среднего", minval = 1.1, step = 0.1, group = gE)
fadeLen = input.int(8, "Окно затухания импульса", minval = 2, group = gE)
ewVol   = input.float(0.40, "Вес климакса объёма", minval = 0, maxval = 1, step = 0.01, group = gE)
ewFade  = input.float(0.30, "Вес затухания",       minval = 0, maxval = 1, step = 0.01, group = gE)
ewWick  = input.float(0.30, "Вес хвоста",          minval = 0, maxval = 1, step = 0.01, group = gE)

gB = "B · прокол полосы и реклейм (триггер)"
kMult      = input.float(1.9, "Полоса Кельтнера, × ATR", minval = 0.5, step = 0.1, group = gB)
pierceLook = input.int(3, "Окно, в котором ищем прокол", minval = 1, group = gB)
pierceFull = input.float(0.60, "Полный прокол, ATR", minval = 0.05, step = 0.05, group = gB)

gV = "V · магнит VWAP"
vFull    = input.float(1.2, "Полное отклонение от VWAP, ATR", minval = 0.1, step = 0.1, group = gV)
vFbkLen  = input.int(60, "Замена VWAP без объёма: средняя hlc3", minval = 5, group = gV)

gQ = "Q · среда"
erLen     = input.int(20, "Окно эффективности хода", minval = 3, group = gQ)
erLo      = input.float(0.22, "Тренда ещё нет, ER", minval = 0, maxval = 1, step = 0.01, group = gQ)
erHi      = input.float(0.62, "Тренд в полную силу, ER", minval = 0.05, maxval = 1, step = 0.01, group = gQ)
emaSlowLen= input.int(200, "Медленная EMA", minval = 10, group = gQ)
slopeLen  = input.int(10, "Окно наклона EMA", minval = 1, group = gQ)
volRegLen = input.int(50, "Окно нормы волатильности", minval = 5, group = gQ)
volCalm   = input.float(1.6, "Спокойная вола, ATR/норма", minval = 0.5, step = 0.1, group = gQ)
volWild   = input.float(3.2, "Разгон волы, ATR/норма",    minval = 0.6, step = 0.1, group = gQ)
qMin      = input.float(0.30, "Минимум множителя", minval = 0.0, maxval = 1, step = 0.05, group = gQ)
minAtrTk  = input.float(6.0, "Минимальный ATR, тиков", minval = 0, step = 0.5, group = gQ,
     tooltip = "Ниже этого ATR минутка не окупает спред и комиссию — Q обнуляется и сигналов нет.")
useSess   = input.bool(false, "Торговать только в окне сессии", group = gQ)
sessStr   = input.session("0930-1600", "Окно сессии", group = gQ)

gPlan = "План сделки"
stopLen    = input.int(3, "Окно свинга для стопа", minval = 1, group = gPlan)
stopATR    = input.float(0.25, "Запас за свинг, ATR", minval = 0, step = 0.05, group = gPlan)
riskMinATR = input.float(0.35, "Минимальный риск, ATR", minval = 0.05, step = 0.05, group = gPlan)
riskMaxATR = input.float(1.60, "Максимальный риск, ATR", minval = 0.1, step = 0.05, group = gPlan)
maxBars    = input.int(10, "Тайм-стоп, баров", minval = 1, group = gPlan)
cooldown   = input.int(2, "Пауза после сделки, баров", minval = 0, group = gPlan)

gWR = "Контроль винрейта"
targetWR  = input.float(66.0, "Цель по винрейту, %", minval = 30, maxval = 95, step = 0.5, group = gWR,
     tooltip = "Контроллер приводит факт к цели снизу, поэтому цель 66% даёт устойчивые 66-68%. Хотите 70% — ставьте 70 и смотрите, что станет с запасом над безубытком.")
rollLen   = input.int(40, "Окно контроля, сделок", minval = 10, group = gWR)
minSample = input.int(25, "Прогрев: сделок до первого сигнала", minval = 5, group = gWR)
adaptOn   = input.bool(true, "Подстраивать R:R под цель", group = gWR)
kUp       = input.float(0.70, "Скорость, когда винрейт выше цели", minval = 0, maxval = 5, step = 0.05, group = gWR)
kDn       = input.float(1.80, "Скорость, когда винрейт ниже цели", minval = 0, maxval = 5, step = 0.05, group = gWR)
rrStart   = input.float(0.55, "Стартовый R:R", minval = 0.05, step = 0.05, group = gWR)
rrMin     = input.float(0.20, "Минимальный R:R", minval = 0.05, step = 0.05, group = gWR)
rrMax     = input.float(2.00, "Максимальный R:R", minval = 0.1, step = 0.05, group = gWR)
rrEdge    = input.float(0.15, "Цель дальше издержек минимум на, R", minval = 0, step = 0.05, group = gWR,
     tooltip = "Пол по издержкам: цель ближе комиссии закрывается в минус даже при касании.")
gateOn    = input.bool(true, "Молчать, когда цель недостижима", group = gWR,
     tooltip = "Контроллер упёрся в пол по издержкам, а винрейт всё равно ниже цели — значит инструмент не даёт такой сделки. Сигналы гаснут, симулятор продолжает считать и включит их обратно сам.")
gateSlack = input.float(5.0, "Допустимая просадка винрейта, пп", minval = 0, maxval = 30, step = 0.5, group = gWR)
costTicks = input.float(2.0, "Комиссия и проскальзывание, тиков на сделку", minval = 0, step = 0.5, group = gWR)

gVw = "Вид"
cLong  = input.color(#0B7A69, "Лонг",   group = gVw, inline = "c")
cShort = input.color(#B8412F, "Шорт",   group = gVw, inline = "c")
cBrass = input.color(#A9701C, "Акцент", group = gVw, inline = "c")
showWR = input.bool(true, "Таблица контроля винрейта", group = gVw)

gT = "Торговля"
useLong  = input.bool(true, "Торговать лонги", group = gT, inline = "s")
useShort = input.bool(true, "Торговать шорты", group = gT, inline = "s")
riskPct  = input.float(0.5, "Риск на сделку, % депозита", minval = 0.01, step = 0.05, group = gT,
     tooltip = "Размер позиции считается от расстояния до стопа, а не фиксированным лотом.")
minQty   = input.float(1.0, "Минимальный размер позиции", minval = 0.0, step = 0.001, group = gT,
     tooltip = "Для фьючерсов 1 контракт, для крипты можно 0.001.")
tradeMuted = input.bool(false, "Торговать погашенные сигналы", group = gT,
     tooltip = "Включите, чтобы увидеть в отчёте, что именно отсекает гейт. По умолчанию гашёные сетапы только считаются теневым симулятором.")

gD = "Период теста"
fromDate = input.time(timestamp("01 Jan 2015 00:00 +0000"), "С", group = gD)
toDate   = input.time(timestamp("01 Jan 2099 00:00 +0000"), "По", group = gD)
inWindow = time >= fromDate and time <= toDate

// ── утилиты ────────────────────────────────────────────────────────────────────
f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_01(float x) => f_clamp(x, 0.0, 1.0)

// ── ряды ───────────────────────────────────────────────────────────────────────
rng    = math.max(high - low, syminfo.mintick)
vol    = nz(volume, 0.0)
volMa  = ta.sma(vol, volLen)
hasVol = volMa > 0

atr   = ta.atr(atrLen)
basis = ta.ema(close, meanLen)
sd    = ta.stdev(close, meanLen)

imp   = math.abs(close - close[1])
impPk = ta.highest(imp, fadeLen)

upBand = basis + kMult * atr
dnBand = basis - kMult * atr
pLo    = ta.lowest(low, pierceLook)
pHi    = ta.highest(high, pierceLook)

// VWAP сессии считаем руками — ta.vwap падает на инструментах без объёма
var float cumPV = 0.0
var float cumV  = 0.0
if timeframe.change("D")
    cumPV := 0.0
    cumV  := 0.0
cumPV += hlc3 * vol
cumV  += vol
vwapSess = cumV > 0 ? cumPV / cumV : na
vwapFbk  = ta.sma(hlc3, vFbkLen)
anchor   = hasVol and not na(vwapSess) ? vwapSess : vwapFbk

// среда
er       = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(close - close[1]), erLen), 1e-9)
emaSlow  = ta.ema(close, emaSlowLen)
trendDir = close > emaSlow and emaSlow > emaSlow[slopeLen] ? 1 : close < emaSlow and emaSlow < emaSlow[slopeLen] ? -1 : 0
volRat   = atr / math.max(ta.sma(atr, volRegLen), 1e-9)
inSess   = not useSess or not na(time(timeframe.period, sessStr))
atrOk    = atr >= minAtrTk * syminfo.mintick

// свинги для стопа
swLo = ta.lowest(low, stopLen)
swHi = ta.highest(high, stopLen)

// ── компоненты для одной стороны ───────────────────────────────────────────────
f_dir(int d) =>
    // X · растяжение — только «в свою сторону»: лонг ждёт цену под средней
    dev = close - basis
    sz  = math.max(0.0, -d * dev) / math.max(sd, 1e-12)
    sa  = math.max(0.0, -d * dev) / math.max(atr, 1e-12)
    X   = f_01(math.min(sz / zFull, sa / aFull))

    // E · истощение
    eV = hasVol ? f_01((vol / volMa - 1.0) / math.max(volFull - 1.0, 0.1)) : 0.5
    eF = impPk > 0 ? f_01(1.0 - imp / impPk) : 0.0
    eW = f_01((d == 1 ? close - low : high - close) / rng)
    E  = f_01(ewVol * eV + ewFade * eF + ewWick * eW)

    // B · прокол полосы и реклейм — строго текущий бар
    band  = d == 1 ? dnBand : upBand
    deep  = d == 1 ? band - pLo : pHi - band
    depth = f_01(math.max(0.0, deep) / math.max(pierceFull * atr, 1e-12))
    inBand= d == 1 ? close > band : close < band
    cpos  = f_01((d == 1 ? close - low : high - close) / rng)
    B     = inBand and depth > 0 ? f_01(0.55 * cpos + 0.45 * depth) : 0.0

    // V · магнит VWAP
    V = f_01(d * (anchor - close) / math.max(vFull * atr, 1e-12))

    // Q · среда
    against = (d == 1 and trendDir < 0) or (d == -1 and trendDir > 0)
    qT = against ? f_clamp(1.0 - (er - erLo) / math.max(erHi - erLo, 1e-9), qMin, 1.0) : 1.0
    qV = f_clamp(1.0 - (volRat - volCalm) / math.max(volWild - volCalm, 1e-9), qMin, 1.0)
    Q  = inSess and atrOk ? f_clamp(math.min(qT, qV), qMin, 1.0) : 0.0

    [X, E, B, V, Q]

[Xl0, El0, Bl, Vl0, Ql] = f_dir(1)
[Xs0, Es0, Bs, Vs0, Qs] = f_dir(-1)

// контекст: X/E/V — максимум за окно, B — строго текущий бар
Xl = ta.highest(Xl0, ctxLen)
El = ta.highest(El0, ctxLen)
Vl = ta.highest(Vl0, ctxLen)
Xs = ta.highest(Xs0, ctxLen)
Es = ta.highest(Es0, ctxLen)
Vs = ta.highest(Vs0, ctxLen)

f_score(float X, float E, float B, float V, float Q) => 100.0 * gain * Q * (wX * X + wE * E + wB * B + wV * V)

scL  = f_score(Xl, El, Bl, Vl, Ql)
scS  = f_score(Xs, Es, Bs, Vs, Qs)
potL = f_score(Xl, El, 1.0, Vl, Ql)
potS = f_score(Xs, Es, 1.0, Vs, Qs)

side  = scL >= scS ? 1 : -1
score = math.max(scL, scS)
pot   = side == 1 ? potL : potS

cX = side == 1 ? Xl : Xs
cE = side == 1 ? El : Es
cB = side == 1 ? Bl : Bs
cV = side == 1 ? Vl : Vs
cQ = side == 1 ? Ql : Qs

// ── состояние контроллера ──────────────────────────────────────────────────────
var float rrMult = rrStart
var array<float> wrWin = array.new_float(0)

tgt   = targetWR / 100.0
ready = array.size(wrWin) >= minSample
rollWR = ready ? array.avg(wrWin) : na

// ── план сделки по текущему бару ───────────────────────────────────────────────
planEntry = close
rawStop   = side == 1 ? swLo - stopATR * atr : swHi + stopATR * atr
planRisk  = f_clamp(math.abs(planEntry - rawStop), riskMinATR * atr, riskMaxATR * atr)
planStop  = planEntry - side * planRisk
costR     = costTicks * syminfo.mintick / math.max(planRisk, syminfo.mintick)
rrFloor   = costR + rrEdge
planRR    = math.min(math.max(rrMult, rrFloor), rrMax)
planTake  = planEntry + side * planRR * planRisk
planBE    = (1.0 + costR) / (planRR + 1.0)       // безубыточный винрейт при этом R:R

// упор: контроллер уже на полу по издержкам, а винрейт всё равно ниже цели
stalled = gateOn and ready and rollWR < tgt - gateSlack / 100.0 and rrMult <= rrFloor * 1.001
gateOpen = not gateOn or (ready and not stalled)

state = score >= thrEntry ? (gateOpen ? "СИГНАЛ" : "ПОГАШЕН") : pot >= thrEntry ? "ГОТОВ" : pot >= thrWatch ? "ЖДЁМ" : "ПУСТО"

// ── симулятор сделок: он же источник калибровки и обратной связи ───────────────
var int   tSide  = 0
var float tEntry = na
var float tStop  = na
var float tTake  = na
var float tRisk  = na
var float tRR    = na
var float tScore = na
var int   tBar   = na
var bool  tLive  = false
var int   lastExit = -100000

var array<int>   calN    = array.new_int(6, 0)
var array<int>   calWin  = array.new_int(6, 0)
var array<float> calR    = array.new_float(6, 0.0)
var array<float> calPos  = array.new_float(6, 0.0)
var array<float> calNeg  = array.new_float(6, 0.0)
var array<float> calRR   = array.new_float(6, 0.0)

var int   liveN  = 0
var int   liveW  = 0
var float liveR  = 0.0
var int   liveB  = 0
var float liveRR = 0.0
var float cumR   = 0.0
var float peakR  = 0.0
var float ddR    = 0.0
var int   muteN  = 0
var int   muteW  = 0
var int   muteBars = 0

f_bucket(float sc) => sc < 70 ? 0 : sc < 80 ? 1 : sc < 90 ? 2 : sc < 100 ? 3 : sc < 110 ? 4 : 5

f_rec(float r, float rr, float sc) =>
    b = f_bucket(sc)
    array.set(calN,  b, array.get(calN, b) + 1)
    array.set(calR,  b, array.get(calR, b) + r)
    array.set(calRR, b, array.get(calRR, b) + rr)
    if r > 0
        array.set(calWin, b, array.get(calWin, b) + 1)
        array.set(calPos, b, array.get(calPos, b) + r)
    else
        array.set(calNeg, b, array.get(calNeg, b) - r)
    b

if stalled
    muteBars += 1

inTrade = tSide != 0
barsOk  = not confirmed or barstate.isconfirmed

float exitR   = na
bool  justOut = false

if inTrade and bar_index > tBar
    float cost = costTicks * syminfo.mintick / tRisk
    bool stopHit = tSide == 1 ? low  <= tStop : high >= tStop
    bool takeHit = tSide == 1 ? high >= tTake : low  <= tTake
    if stopHit                                    // стоп и цель на одном баре — засчитываем стоп
        exitR := -1.0 - cost
    else if takeHit
        exitR := tRR - cost
    else if bar_index - tBar >= maxBars
        exitR := (close - tEntry) * tSide / tRisk - cost
    if not na(exitR)
        f_rec(exitR, tRR, tScore)
        cumR  += exitR
        peakR := math.max(peakR, cumR)
        ddR   := math.min(ddR, cumR - peakR)
        if tLive
            liveN  += 1
            liveR  += exitR
            liveRR += tRR
            liveB  += bar_index - tBar
            liveW  += exitR > 0 ? 1 : 0
        else
            muteN += 1
            muteW += exitR > 0 ? 1 : 0
        array.push(wrWin, exitR > 0 ? 1.0 : 0.0)
        if array.size(wrWin) > rollLen
            array.shift(wrWin)
        if adaptOn and array.size(wrWin) >= minSample
            float err = array.avg(wrWin) - tgt
            float k   = err > 0 ? kUp : kDn
            rrMult := f_clamp(rrMult * (1.0 + k * err), rrMin, rrMax)
        tSide    := 0
        lastExit := bar_index
        justOut  := true

cdOk    = bar_index - lastExit >= cooldown
warmOk  = bar_index >= math.max(math.max(emaSlowLen, volRegLen), meanLen) + ctxLen
canFire = not inTrade and not justOut and cdOk and barsOk and warmOk and score >= thrEntry and not na(atr) and atr > 0
fired   = false
live    = false

if canFire
    tSide  := side
    tEntry := planEntry
    tStop  := planStop
    tTake  := planTake
    tRisk  := planRisk
    tRR    := planRR
    tScore := score
    tBar   := bar_index
    tLive  := gateOpen
    fired  := true
    live   := gateOpen

liveLong  = fired and live and tSide == 1
liveShort = fired and live and tSide == -1
muted     = fired and not live

// ── вход ───────────────────────────────────────────────────────────────────────
sideOk = (side == 1 and useLong) or (side == -1 and useShort)
takeIt = fired and (live or tradeMuted) and inWindow and sideOk and strategy.position_size == 0

// размер позиции: риск в деньгах / риск в пунктах
riskMoney = strategy.equity * riskPct / 100.0
qtyRaw    = riskMoney / math.max(planRisk * syminfo.pointvalue, 1e-9)
qty       = math.max(qtyRaw, minQty)

var float eStop = na
var float eTake = na
var int   eBar  = na

if takeIt
    eStop := tStop
    eTake := tTake
    eBar  := bar_index
    if tSide == 1
        strategy.entry("L", strategy.long, qty = qty, comment = "SNAP L " + str.tostring(tScore, "#"))
    else
        strategy.entry("S", strategy.short, qty = qty, comment = "SNAP S " + str.tostring(tScore, "#"))

// ── выход ──────────────────────────────────────────────────────────────────────
inPos = strategy.position_size != 0
if inPos
    strategy.exit("LX", "L", stop = eStop, limit = eTake)
    strategy.exit("SX", "S", stop = eStop, limit = eTake)
    // тайм-стоп: сетап не отработал за отведённые бары — выходим по рынку
    if bar_index - eBar >= maxBars
        strategy.close_all(comment = "тайм-стоп")

// ── картинка ───────────────────────────────────────────────────────────────────
plot(basis, "Средняя", color = color.new(color.gray, 25))
plot(inPos ? eStop : na, "Стоп", color = cShort, style = plot.style_linebr)
plot(inPos ? eTake : na, "Цель", color = cLong,  style = plot.style_linebr)
plotshape(takeIt and tSide == 1,  "LONG",  shape.triangleup,   location.belowbar, cLong,  size = size.small)
plotshape(takeIt and tSide == -1, "SHORT", shape.triangledown, location.abovebar, cShort, size = size.small)
bgcolor(fired and not live ? color.new(color.gray, 90) : na)

// ── таблица контроля винрейта ──────────────────────────────────────────────────
f_row2(table t, int r, string k, string v, color bg, color tc) =>
    table.cell(t, 0, r, k, text_color = chart.fg_color, text_size = size.tiny, text_halign = text.align_left,  bgcolor = bg)
    table.cell(t, 1, r, v, text_color = tc,             text_size = size.tiny, text_halign = text.align_right, bgcolor = bg)
    r

var table tW = table.new(position.top_right, 2, 8, border_width = 1)

if showWR and barstate.islast
    bgH    = color.new(color.gray, 85)
    engN   = strategy.closedtrades
    engWR  = engN > 0 ? 100.0 * strategy.wintrades / engN : na
    shdWR  = liveN > 0 ? 100.0 * liveW / liveN : na
    avgRR  = liveN > 0 ? liveRR / liveN : planRR
    beWR   = 100.0 * (1.0 + costR) / (avgRR + 1.0)
    stName = not ready ? "ПРОГРЕВ " + str.tostring(array.size(wrWin)) + "/" + str.tostring(minSample) :
             stalled  ? "МОЛЧИТ · упор в издержки" : "РАБОТАЕТ"
    f_row2(tW, 0, "КОНТРОЛЬ ВИНРЕЙТА", stName, bgH, not ready ? color.gray : stalled ? cShort : cLong)
    f_row2(tW, 1, "Цель", str.tostring(targetWR, "#.0") + "%", na, chart.fg_color)
    f_row2(tW, 2, "Скользящий винрейт (" + str.tostring(rollLen) + ")",
         ready ? str.tostring(rollWR * 100.0, "#.0") + "%" : "—", na,
         ready and rollWR >= tgt ? cLong : cShort)
    f_row2(tW, 3, "Винрейт отчёта (" + str.tostring(engN) + ")",
         na(engWR) ? "—" : str.tostring(engWR, "#.0") + "%", na,
         na(engWR) ? color.gray : engWR >= targetWR ? cLong : cShort)
    f_row2(tW, 4, "Винрейт теневых (" + str.tostring(liveN) + ")",
         na(shdWR) ? "—" : str.tostring(shdWR, "#.0") + "%", na, color.gray)
    f_row2(tW, 5, "R:R сейчас", str.tostring(planRR, "#.00"), na, chart.fg_color)
    f_row2(tW, 6, "Безубыточный винрейт", str.tostring(beWR, "#.0") + "%", na, chart.fg_color)
    f_row2(tW, 7, "Таймфрейм", timeframe.isminutes and timeframe.multiplier == 1 ? "1 мин" :
         timeframe.period + " · калибровка под 1 мин", na,
         timeframe.isminutes and timeframe.multiplier == 1 ? chart.fg_color : cShort)
