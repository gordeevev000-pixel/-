//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SPRING · стратегия для бэктеста
//
//  Тот же движок, что и в индикаторе SPRING (ядро скопировано один в один),
//  но вместо симулятора внутри скрипта сделки исполняет движок TradingView —
//  чтобы получить нативный отчёт: эквити, просадку, профит-фактор, список сделок.
//
//  Вход по закрытию бара-триггера, стоп за свингом, T1 на средней, T2 = 2.6R,
//  тайм-стоп. Комиссию и проскальзывание задайте во вкладке «Свойства» —
//  без них любой отскоковый бэктест врёт в свою пользу.
// ═══════════════════════════════════════════════════════════════════════════════

strategy("SPRING · стратегия", "SPRING S", overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 100000, commission_type = strategy.commission.percent,
     commission_value = 0.005, slippage = 2, pyramiding = 0,
     calc_on_every_tick = false, process_orders_on_close = true,
     max_lines_count = 500, max_labels_count = 500)

// ── входные параметры ──────────────────────────────────────────────────────────
gCore = "Ядро"
meanLen   = input.int(20, "Средняя, к которой возвращается цена", minval = 3, group = gCore)
meanType  = input.string("EMA", "Тип средней", options = ["EMA", "SMA", "VWMA"], group = gCore)
atrLen    = input.int(14, "ATR", minval = 2, group = gCore)
ctxLen    = input.int(12, "Окно контекста (максимум S/P/I/N)", minval = 1, group = gCore)
gain      = input.float(1.22, "gain — нормировка скора", minval = 0.5, maxval = 3.0, step = 0.01, group = gCore)
thrEntry  = input.float(70.0, "Порог входа", minval = 1, maxval = 100, step = 0.5, group = gCore)
thrWatch  = input.float(55.0, "Порог наблюдения", minval = 1, maxval = 100, step = 0.5, group = gCore)
confirmed = input.bool(true, "Сигналы только по закрытым барам", group = gCore,
     tooltip = "Выключить — сигнал появится внутри формирующегося бара и может исчезнуть.")

gW = "Веса компонентов"
wS = input.float(0.20, "S · растяжение", minval = 0, maxval = 1, step = 0.01, group = gW)
wP = input.float(0.22, "P · истощение",  minval = 0, maxval = 1, step = 0.01, group = gW)
wR = input.float(0.28, "R · возврат",    minval = 0, maxval = 1, step = 0.01, group = gW)
wI = input.float(0.13, "I · дивергенция",minval = 0, maxval = 1, step = 0.01, group = gW)
wN = input.float(0.17, "N · уровни",     minval = 0, maxval = 1, step = 0.01, group = gW)

gS = "S · растяжение"
sFullZ = input.float(2.5, "Полное растяжение, σ",   minval = 0.2, step = 0.1, group = gS)
sFullA = input.float(2.5, "Полное растяжение, ATR", minval = 0.2, step = 0.1, group = gS)

gP = "P · истощение"
volLen   = input.int(20, "Окно среднего объёма", minval = 2, group = gP)
volFull  = input.float(2.5, "Климакс объёма, × среднего", minval = 1.1, step = 0.1, group = gP)
fadeLen  = input.int(8, "Окно затухания импульса", minval = 2, group = gP)
pwVol    = input.float(0.42, "Вес климакса объёма", minval = 0, maxval = 1, step = 0.01, group = gP)
pwFade   = input.float(0.30, "Вес затухания",       minval = 0, maxval = 1, step = 0.01, group = gP)
pwWick   = input.float(0.28, "Вес хвоста",          minval = 0, maxval = 1, step = 0.01, group = gP)

gR = "R · возврат (триггер)"
sweepLen   = input.int(10, "Окно свипа ликвидности", minval = 2, group = gR)
pierceATR  = input.float(0.5, "Полный прокол уровня, ATR", minval = 0.05, step = 0.05, group = gR)

gI = "I · дивергенция"
rsiLen   = input.int(14, "RSI", minval = 2, group = gI)
divLen   = input.int(20, "Окно дивергенции", minval = 3, group = gI)
divRsi   = input.float(8.0, "Полная дивергенция RSI, пунктов", minval = 1, step = 0.5, group = gI)
divVol   = input.float(3.0, "Полная дивергенция CVD, × среднего объёма", minval = 0.2, step = 0.1, group = gI)
useCorr  = input.bool(false, "Учитывать коррелирующий инструмент", group = gI)
corrSym  = input.string("", "Коррелирующий инструмент (тикер целиком)", group = gI,
     tooltip = "Например NQ1! для ES1!. Пусто — коррелят не учитывается.")
divCorr  = input.float(0.5, "Полная дивергенция коррелята, %", minval = 0.01, step = 0.01, group = gI)

gN = "N · уровни"
tolATR    = input.float(0.28, "Допуск конфлюэнса, ATR", minval = 0.02, step = 0.01, group = gN)
levEmaLen = input.int(200, "Медленная EMA", minval = 10, group = gN)
swingLen  = input.int(60, "Окно свинга для фибо", minval = 5, group = gN)
fibRatio  = input.float(0.786, "Уровень фибо", minval = 0.1, maxval = 0.99, step = 0.001, group = gN)
roundStep = input.float(0.0, "Шаг круглых уровней (0 = авто)", minval = 0, group = gN)
wEma      = input.float(0.30, "Вес EMA",            minval = 0, maxval = 1, step = 0.01, group = gN)
wVwap     = input.float(0.27, "Вес VWAP сессии",    minval = 0, maxval = 1, step = 0.01, group = gN)
wPd       = input.float(0.25, "Вес хай/лоу дня",    minval = 0, maxval = 1, step = 0.01, group = gN)
wRound    = input.float(0.20, "Вес круглого числа", minval = 0, maxval = 1, step = 0.01, group = gN)
wFib      = input.float(0.23, "Вес фибо",           minval = 0, maxval = 1, step = 0.01, group = gN)
nFull     = input.float(0.90, "Полный конфлюэнс, сумма весов", minval = 0.1, step = 0.05, group = gN)

gG = "G · режим"
erLen     = input.int(20, "Окно эффективности хода", minval = 3, group = gG)
erLo      = input.float(0.20, "Тренда ещё нет, ER", minval = 0, maxval = 1, step = 0.01, group = gG)
erHi      = input.float(0.60, "Тренд в полную силу, ER", minval = 0.05, maxval = 1, step = 0.01, group = gG)
slopeLen  = input.int(10, "Окно наклона EMA", minval = 1, group = gG)
volRegLen = input.int(50, "Окно нормы волатильности", minval = 5, group = gG)
volCalm   = input.float(1.5, "Спокойная вола, ATR/норма", minval = 0.5, step = 0.1, group = gG)
volWild   = input.float(3.0, "Разгон волы, ATR/норма",    minval = 0.6, step = 0.1, group = gG)
gMin      = input.float(0.35, "Минимум множителя", minval = 0.0, maxval = 1, step = 0.05, group = gG)

gPlan = "План сделки"
stopLen    = input.int(5, "Окно свинга для стопа", minval = 1, group = gPlan)
stopATR    = input.float(0.50, "Запас за свинг, ATR", minval = 0, step = 0.05, group = gPlan)
t2R        = input.float(2.60, "Цель T2, в R", minval = 0.2, step = 0.1, group = gPlan)
retestATR  = input.float(0.30, "Лимитка на ретесте: от стопа, ATR", minval = 0, step = 0.05, group = gPlan)
minRR      = input.float(0.50, "Минимальный R:R до T1", minval = 0, step = 0.05, group = gPlan)
maxBars    = input.int(12, "Тайм-стоп, баров", minval = 1, group = gPlan)
cooldown   = input.int(3, "Пауза после сделки, баров", minval = 0, group = gPlan)
useT2      = input.bool(false, "Половина на T1, остаток на T2 (стоп в безубыток)", group = gPlan)

gV = "Вид"
showPlan  = input.bool(true, "План сделки на графике", group = gV)
cLong     = input.color(#0B7A69, "Лонг",  group = gV, inline = "c")
cShort    = input.color(#B8412F, "Шорт",  group = gV, inline = "c")
cBrass    = input.color(#A9701C, "Акцент", group = gV, inline = "c")

// ── утилиты ────────────────────────────────────────────────────────────────────
f_clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_01(float x) => f_clamp(x, 0.0, 1.0)
f_hit(float lvl, float probe, float tol) => na(lvl) ? 0.0 : math.abs(probe - lvl) <= tol ? 1.0 : 0.0

// ── общие ряды ─────────────────────────────────────────────────────────────────
rng    = math.max(high - low, syminfo.mintick)
vol    = nz(volume, 0.0)
volMa  = ta.sma(vol, volLen)
hasVol = volMa > 0

atr   = ta.atr(atrLen)
bEma  = ta.ema(close, meanLen)
bSma  = ta.sma(close, meanLen)
bVwma = ta.vwma(close, meanLen)
basis = meanType == "SMA" ? bSma : meanType == "VWMA" ? bVwma : bEma
sd = ta.stdev(close, meanLen)

imp   = math.abs(close - close[1])
impPk = ta.highest(imp, fadeLen)

refL = ta.lowest(low, sweepLen)[1]
refH = ta.highest(high, sweepLen)[1]

rsi   = ta.rsi(close, rsiLen)
delta = vol * ((close - low) - (high - close)) / rng
cvd   = ta.cum(delta)

loW    = ta.lowest(low, divLen)[1]
hiW    = ta.highest(high, divLen)[1]
rsiLoW = ta.lowest(rsi, divLen)[1]
rsiHiW = ta.highest(rsi, divLen)[1]
cvdLoW = ta.lowest(cvd, divLen)[1]
cvdHiW = ta.highest(cvd, divLen)[1]

corrTicker = corrSym == "" ? syminfo.tickerid : corrSym
corrP      = request.security(corrTicker, timeframe.period, close, lookahead = barmerge.lookahead_off)
corrLoW    = ta.lowest(corrP, divLen)[1]
corrHiW    = ta.highest(corrP, divLen)[1]

// уровни
emaLvl = ta.ema(close, levEmaLen)

// VWAP сессии считаем руками — ta.vwap падает на инструментах без объёма
var float cumPV = 0.0
var float cumV  = 0.0
if timeframe.change("D")
    cumPV := 0.0
    cumV  := 0.0
cumPV += hlc3 * vol
cumV  += vol
avwap = cumV > 0 ? cumPV / cumV : na

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

swHi     = ta.highest(high, swingLen)
swLo     = ta.lowest(low, swingLen)
fibLong  = swHi - (swHi - swLo) * fibRatio
fibShort = swLo + (swHi - swLo) * fibRatio
rstep    = roundStep > 0 ? roundStep : math.pow(10, math.floor(math.log10(math.max(close, 1.0))) - 2) * 5

// режим
er       = math.abs(close - close[erLen]) / math.max(math.sum(math.abs(close - close[1]), erLen), 1e-9)
trendDir = close > emaLvl and emaLvl > emaLvl[slopeLen] ? 1 : close < emaLvl and emaLvl < emaLvl[slopeLen] ? -1 : 0
volRat   = atr / math.max(ta.sma(atr, volRegLen), 1e-9)

// свинги для стопа
swStopLo = ta.lowest(low, stopLen)
swStopHi = ta.highest(high, stopLen)

// ── компоненты для одной стороны ───────────────────────────────────────────────
f_dir(int d) =>
    // S · растяжение: считается только «в свою сторону» — лонг ждёт цену под средней
    devZ = sd  > 0 ? (close - basis) / sd  : 0.0
    devA = atr > 0 ? (close - basis) / atr : 0.0
    sZ   = d == 1 ? math.max(0.0, -devZ) : math.max(0.0, devZ)
    sA   = d == 1 ? math.max(0.0, -devA) : math.max(0.0, devA)
    S    = f_01(math.min(sZ / sFullZ, sA / sFullA))

    // P · истощение
    pV = hasVol ? f_01((vol / volMa - 1.0) / math.max(volFull - 1.0, 0.1)) : 0.5
    pF = impPk > 0 ? f_01(1.0 - imp / impPk) : 0.0
    pW = f_01((d == 1 ? close - low : high - close) / rng)
    P  = f_01(pwVol * pV + pwFade * pF + pwWick * pW)

    // R · возврат — только текущий бар
    ref    = d == 1 ? refL : refH
    pierce = d == 1 ? math.max(0.0, refL - low) : math.max(0.0, high - refH)
    pN     = atr > 0 ? f_01(pierce / (pierceATR * atr)) : 0.0
    back   = d == 1 ? close > ref : close < ref
    cpos   = f_01((d == 1 ? close - low : high - close) / rng)
    R      = back ? f_01(0.55 * cpos + 0.45 * pN) : 0.0

    // I · дивергенция — только на новом экстремуме
    newExt = d == 1 ? low < loW : high > hiW
    iR = d == 1 ? f_01((rsi - rsiLoW) / divRsi) : f_01((rsiHiW - rsi) / divRsi)
    iC = not hasVol ? 0.0 :
       d == 1 ? f_01((cvd - cvdLoW) / math.max(volMa * divVol, 1e-9))
              : f_01((cvdHiW - cvd) / math.max(volMa * divVol, 1e-9))
    iX = not useCorr ? 0.0 :
       d == 1 ? f_01((corrP - corrLoW) / math.max(math.abs(corrLoW) * divCorr / 100.0, 1e-9))
              : f_01((corrHiW - corrP) / math.max(math.abs(corrHiW) * divCorr / 100.0, 1e-9))
    iBase = hasVol ? 0.6 * iR + 0.4 * iC : iR
    I     = newExt ? f_01(useCorr ? 0.75 * iBase + 0.25 * iX : iBase) : 0.0

    // N · конфлюэнс уровней вокруг экстремума бара
    probe = d == 1 ? low : high
    tol   = tolATR * atr
    rnd   = rstep > 0 ? math.round(probe / rstep) * rstep : na
    fib   = d == 1 ? fibLong : fibShort
    wsum  = f_hit(emaLvl, probe, tol) * wEma
          + f_hit(avwap, probe, tol) * wVwap
          + math.max(f_hit(pdh, probe, tol), f_hit(pdl, probe, tol)) * wPd
          + f_hit(rnd, probe, tol) * wRound
          + f_hit(fib, probe, tol) * wFib
    N = f_01(wsum / nFull)

    // G · режим: против сильного тренда и в разгоне волы скор душится
    against = (d == 1 and trendDir < 0) or (d == -1 and trendDir > 0)
    gT = against ? f_clamp(1.0 - (er - erLo) / math.max(erHi - erLo, 1e-9), gMin, 1.0) : 1.0
    gV = f_clamp(1.0 - (volRat - volCalm) / math.max(volWild - volCalm, 1e-9), gMin, 1.0)
    G  = f_clamp(math.min(gT, gV), gMin, 1.0)

    [S, P, R, I, N, G]

[Sl0, Pl0, Rl, Il0, Nl0, Gl] = f_dir(1)
[Ss0, Ps0, Rs, Is0, Ns0, Gs] = f_dir(-1)

// контекст: S/P/I/N — максимум за окно, R — строго текущий бар
Sl = ta.highest(Sl0, ctxLen)
Pl = ta.highest(Pl0, ctxLen)
Il = ta.highest(Il0, ctxLen)
Nl = ta.highest(Nl0, ctxLen)
Ss = ta.highest(Ss0, ctxLen)
Ps = ta.highest(Ps0, ctxLen)
Is = ta.highest(Is0, ctxLen)
Ns = ta.highest(Ns0, ctxLen)

f_score(float S, float P, float R, float I, float N, float G) =>
    100.0 * gain * G * (wS * S + wP * P + wR * R + wI * I + wN * N)

scL  = f_score(Sl, Pl, Rl, Il, Nl, Gl)
scS  = f_score(Ss, Ps, Rs, Is, Ns, Gs)
potL = f_score(Sl, Pl, 1.0, Il, Nl, Gl)
potS = f_score(Ss, Ps, 1.0, Is, Ns, Gs)

side  = scL >= scS ? 1 : -1
score = math.max(scL, scS)
pot   = side == 1 ? potL : potS

cS = side == 1 ? Sl : Ss
cP = side == 1 ? Pl : Ps
cR = side == 1 ? Rl : Rs
cI = side == 1 ? Il : Is
cN = side == 1 ? Nl : Ns
cG = side == 1 ? Gl : Gs

state = score >= thrEntry ? "TRIGGER" : pot >= thrEntry ? "ARMED" : pot >= thrWatch ? "WATCH" : "FLAT"
withTrend = (side == 1 and trendDir > 0) or (side == -1 and trendDir < 0)
playbook  = withTrend ? "TREND_DIP" : er < erLo ? "RANGE_FADE" : "COUNTER_CLIMAX"

// ── план сделки по текущему бару ───────────────────────────────────────────────
planEntry  = close
planStop   = side == 1 ? swStopLo - stopATR * atr : swStopHi + stopATR * atr
planRisk   = math.max(math.abs(planEntry - planStop), syminfo.mintick)
planT1     = basis
planT2     = side == 1 ? planEntry + t2R * planRisk : planEntry - t2R * planRisk
planRR     = (side == 1 ? planT1 - planEntry : planEntry - planT1) / planRisk
planRetest = side == 1 ? planStop + retestATR * atr : planStop - retestATR * atr
planSize   = math.round(math.min(100.0, score / math.max(planRisk / atr, 0.1)))


// ── торговые параметры ─────────────────────────────────────────────────────────
gT = "Исполнение"
useLong  = input.bool(true,  "Торговать лонги",  group = gT, inline = "s")
useShort = input.bool(true,  "Торговать шорты",  group = gT, inline = "s")
riskPct  = input.float(0.5, "Риск на сделку, % депозита", minval = 0.01, step = 0.05, group = gT,
     tooltip = "Размер позиции считается от расстояния до стопа, а не фиксированным лотом.")
scaleBySize = input.bool(true, "Масштабировать размер скором (score / риск в ATR)", group = gT)
useRetest   = input.bool(false, "Входить лимиткой на ретесте, а не по рынку", group = gT,
     tooltip = "Лимитка ставится на уровень «стоп ∓ 0.3 ATR» и живёт заданное число баров.")
retestLife  = input.int(3, "Время жизни лимитки, баров", minval = 1, group = gT)
minQty      = input.float(1.0, "Минимальный размер позиции", minval = 0.0, step = 0.001, group = gT,
     tooltip = "Для фьючерсов 1 контракт. Для крипты можно 0.001. Если расчётный размер меньше — берётся этот.")

gD = "Период теста"
fromDate = input.time(timestamp("01 Jan 2015 00:00 +0000"), "С", group = gD)
toDate   = input.time(timestamp("01 Jan 2099 00:00 +0000"), "По", group = gD)
inWindow = time >= fromDate and time <= toDate

// ── вход ───────────────────────────────────────────────────────────────────────
sideOk  = (side == 1 and useLong) or (side == -1 and useShort)
barsOk  = not confirmed or barstate.isconfirmed
canFire = inWindow and sideOk and barsOk and strategy.position_size == 0 and
     score >= thrEntry and planRR >= minRR and not na(atr)

// размер позиции: риск в деньгах / риск в пунктах, при желании взвешенный скором
riskMoney = strategy.equity * riskPct / 100.0
sizeMult  = scaleBySize ? f_clamp(score / math.max(planRisk / atr, 0.1) / 100.0, 0.1, 1.0) : 1.0
qtyRaw    = riskMoney * sizeMult / math.max(planRisk * syminfo.pointvalue, 1e-9)
qty       = math.max(qtyRaw, minQty)

var float ePrice = na
var float eStop  = na
var float eT1    = na
var float eT2    = na
var int   eBar   = na

if canFire
    ePrice := useRetest ? planRetest : planEntry
    eStop  := planStop
    eT1    := planT1
    eT2    := planT2
    eBar   := bar_index
    if side == 1
        if useRetest
            strategy.entry("L", strategy.long, qty = qty, limit = ePrice, comment = "SPRING L " + str.tostring(score, "#"))
        else
            strategy.entry("L", strategy.long, qty = qty, comment = "SPRING L " + str.tostring(score, "#"))
    else
        if useRetest
            strategy.entry("S", strategy.short, qty = qty, limit = ePrice, comment = "SPRING S " + str.tostring(score, "#"))
        else
            strategy.entry("S", strategy.short, qty = qty, comment = "SPRING S " + str.tostring(score, "#"))

// снимаем непойманную лимитку
if useRetest and strategy.position_size == 0 and not na(eBar) and bar_index - eBar >= retestLife
    strategy.cancel("L")
    strategy.cancel("S")

// ── выход ──────────────────────────────────────────────────────────────────────
inPos = strategy.position_size != 0
var bool t1Done = false
if not inPos
    t1Done := false
if inPos
    dirPos = strategy.position_size > 0 ? 1 : -1
    t1Done := t1Done or (dirPos == 1 ? high >= eT1 : low <= eT1)
    stop2  = t1Done ? strategy.position_avg_price : eStop
    if useT2
        strategy.exit("L1", "L", qty_percent = 50, stop = eStop, limit = eT1)
        strategy.exit("L2", "L", stop = stop2, limit = eT2)
        strategy.exit("S1", "S", qty_percent = 50, stop = eStop, limit = eT1)
        strategy.exit("S2", "S", stop = stop2, limit = eT2)
    else
        strategy.exit("LX", "L", stop = eStop, limit = eT1)
        strategy.exit("SX", "S", stop = eStop, limit = eT1)
    // тайм-стоп: сетап не отработал за отведённые бары — выходим по рынку
    if bar_index - eBar >= maxBars
        strategy.close_all(comment = "тайм-стоп")

// ── картинка ───────────────────────────────────────────────────────────────────
plot(basis, "Средняя", color = color.new(color.gray, 25))
plot(inPos ? eStop : na, "Стоп", color = cShort, style = plot.style_linebr)
plot(inPos ? eT1 : na,  "T1",   color = cLong,  style = plot.style_linebr)
plot(inPos ? eT2 : na,  "T2",   color = color.new(cLong, 45), style = plot.style_linebr)
plotshape(canFire and side == 1,  "LONG",  shape.triangleup,   location.belowbar, cLong,  size = size.small)
plotshape(canFire and side == -1, "SHORT", shape.triangledown, location.abovebar, cShort, size = size.small)
bgcolor(state == "TRIGGER" ? color.new(side == 1 ? cLong : cShort, 88) : state == "ARMED" ? color.new(cBrass, 93) : na)
