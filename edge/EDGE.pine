// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("EDGE · самокалибрующийся скальпер", shorttitle = "EDGE", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ════════════════════════════════════════════════════════════════════════════
//  EDGE — сигналы для торговли на 1м с учётом старших таймфреймов.
//
//  Главная идея: индикатор не верит своим же сетапам на слово. Каждый найденный
//  сетап он «отыгрывает» виртуально (вход, стоп, тейк, издержки) и ведёт
//  статистику по каждому типу ситуации. На графике появляются только те сигналы,
//  у которых на ЭТОМ инструменте уже доказан перевес после комиссий.
//  Нет перевеса — индикатор молчит.
//
//  Без перерисовки: всё считается по закрытым барам, старшие ТФ — по последнему
//  закрытому бару старшего ТФ.
// ════════════════════════════════════════════════════════════════════════════

// ───────────────────────────── Настройки ─────────────────────────────
const string G_HTF  = "Старшие таймфреймы"
const string G_SET  = "Сетапы"
const string G_RISK = "Риск и цели"
const string G_COST = "Издержки (важно!)"
const string G_LRN  = "Самообучение"
const string G_VIEW = "Отображение"

tf1     = input.timeframe("5",  "ТФ 1", group = G_HTF, inline = "t1")
w1      = input.float(0.25, "вес", minval = 0, step = 0.05, group = G_HTF, inline = "t1")
tf2     = input.timeframe("15", "ТФ 2", group = G_HTF, inline = "t2")
w2      = input.float(0.35, "вес", minval = 0, step = 0.05, group = G_HTF, inline = "t2")
tf3     = input.timeframe("60", "ТФ 3", group = G_HTF, inline = "t3")
w3      = input.float(0.40, "вес", minval = 0, step = 0.05, group = G_HTF, inline = "t3")
biasThr = input.float(0.2, "Порог «по тренду / против»", minval = 0, maxval = 1, step = 0.05, group = G_HTF,
          tooltip = "Сводная оценка старших ТФ лежит в диапазоне −1…+1. Выше порога — сделка по тренду, ниже −порога — против, между ними — нейтрально.")

usePb    = input.bool(true, "Откат по тренду", group = G_SET)
useSw    = input.bool(true, "Снятие ликвидности", group = G_SET)
useSq    = input.bool(true, "Пробой сжатия", group = G_SET)
cooldown = input.int(5, "Пауза между однотипными сетапами, баров", minval = 1, group = G_SET)

rr      = input.float(1.5, "Тейк, R", minval = 0.5, step = 0.1, group = G_RISK, tooltip = "R — размер риска (расстояние до стопа). Тейк 1.5R = цель в полтора стопа.")
slMin   = input.float(0.5, "Стоп мин., ×ATR", minval = 0.1, step = 0.1, group = G_RISK)
slMax   = input.float(2.5, "Стоп макс., ×ATR", minval = 0.5, step = 0.1, group = G_RISK)
maxBars = input.int(30, "Макс. длительность сделки, баров", minval = 1, group = G_RISK)

costMode  = input.string("авто", "Издержки задаются в", options = ["авто", "%", "тиках"], group = G_COST,
             tooltip = "Авто: для фьючерсов — в тиках, для остального — в процентах.")
costPct   = input.float(0.04, "Комиссия + проскальзывание за вход и выход, %", minval = 0, step = 0.01, group = G_COST,
             tooltip = "Для акций. Сумма за ОБЕ стороны сделки: комиссия брокера и биржи плюс спред. Пример: 0.02% за сторону → 0.04%.")
costTicks = input.float(2, "Издержки за вход и выход, тиков", minval = 0, step = 0.5, group = G_COST,
             tooltip = "Для фьючерсов. Комиссия за вход и выход в пересчёте на тики плюс проскальзывание. Пример ES: комиссия ~$4.5 ≈ 0.4 тика + 1 тик проскальзывания ≈ 1.5 тика.")
maxCostR  = input.float(0.25, "Макс. доля издержек в риске, R", minval = 0.01, step = 0.05, group = G_COST,
             tooltip = "Если комиссия съедает больше этой доли стопа, сетап отбрасывается сразу.")

memory  = input.int(150, "Память, сделок", minval = 20, group = G_LRN, tooltip = "Сколько последних виртуальных сделок каждого типа влияют на оценку. Меньше — быстрее подстраивается, но шумнее.")
minN    = input.int(20, "Мин. сделок для доверия", minval = 1, group = G_LRN)
minEdge = input.float(0.05, "Мин. перевес, R", step = 0.01, group = G_LRN)
zK      = input.float(0.5, "Строгость", minval = 0, step = 0.1, group = G_LRN, tooltip = "0 — верить среднему. 1 — требовать запас на статистическую погрешность. Выше — меньше сигналов, но надёжнее.")

oneAtATime = input.bool(true, "Один сигнал за раз", group = G_VIEW)
showLevels = input.bool(true, "Линии стопа и тейка", group = G_VIEW)
showGray   = input.bool(false, "Серые метки: сетап без перевеса", group = G_VIEW)
showPanel  = input.bool(false, "Панель статистики", group = G_VIEW)
useSess    = input.bool(false, "Сигналы только в торговое время", group = G_VIEW, inline = "s")
sess       = input.session("0900-2300", "", group = G_VIEW, inline = "s")

// Внутренние константы (подобраны один раз, не под историю)
const int   ATR_LEN   = 14
const int   ATR_LONG  = 100
const int   EMA_F     = 20
const int   EMA_S     = 50
const int   PB_LOOK   = 5
const float PB_TOUCH  = 0.2
const int   PIV_L     = 5
const int   PIV_R     = 2
const int   LVL_AGE   = 90
const float SW_WICK   = 0.4
const float SW_RVOL   = 1.2
const int   SQ_LEN    = 15
const float SQ_K      = 2.5
const float SQ_RVOL   = 1.3
const float SL_BUF    = 0.1
const float PRIOR_K   = 10.0
const float PRIOR_MU  = -0.05
const int   WARMUP    = 105
const int   GAP_BARS  = 4      // пропуск дольше 4 баров = разрыв сессии
const int   AFTER_GAP = 3      // после разрыва 3 бара только наблюдаем
const float TOD_ALPHA = 0.1    // сглаживание «обычного объёма в эту минуту»
const int   TOD_MIN   = 3      // сколько дней наблюдений нужно для этой минуты

// Цвета
color C_LONG  = #16a34a
color C_SHORT = #dc2626
color C_TP    = color.new(#16a34a, 35)
color C_SL    = color.new(#dc2626, 35)
color C_GRAY  = color.new(#9ca3af, 30)
color C_PANEL = color.new(#111827, 15)
color C_TEXT  = #e5e7eb

// ───────────────────────────── Старшие ТФ ─────────────────────────────
f_er(float src, int n) =>
    float path = math.sum(math.abs(src - src[1]), n)
    path > 0 ? math.abs(src - src[n]) / path : 0.0

f_tanh(float x) =>
    float e2 = math.exp(2 * math.max(math.min(x, 20.0), -20.0))
    (e2 - 1) / (e2 + 1)

// Тренд на старшем ТФ в диапазоне −1…+1: наклон EMA, положение цены и «чистота» движения.
// Возвращает значение ЗАКРЫТОГО бара ([1] + lookahead_on = без перерисовки).
f_htfBias() =>
    float e     = ta.ema(close, 21)
    float a     = ta.atr(14)
    float slope = (e - e[3]) / (3 * a)
    float pos   = (close - e) / a
    float score = f_tanh(1.5 * slope + 0.5 * pos) * (0.5 + 0.5 * f_er(close, 10))
    score[1]

float b1   = request.security(syminfo.tickerid, tf1, f_htfBias(), lookahead = barmerge.lookahead_on)
float b2   = request.security(syminfo.tickerid, tf2, f_htfBias(), lookahead = barmerge.lookahead_on)
float b3   = request.security(syminfo.tickerid, tf3, f_htfBias(), lookahead = barmerge.lookahead_on)
float bias = (w1 * b1 + w2 * b2 + w3 * b3) / math.max(w1 + w2 + w3, 1e-9)

// ───────────────────────────── Рабочий ТФ ─────────────────────────────
// ATR по диапазону свечи: гэп на открытии или после клиринга его не раздувает
float atr1   = ta.rma(high - low, ATR_LEN)
float atrL   = ta.rma(high - low, ATR_LONG)
float emaF   = ta.ema(close, EMA_F)
float emaS   = ta.ema(close, EMA_S)
float rng    = high - low
float clv    = rng > 0 ? (close - low) / rng : 0.5
float volMa  = ta.sma(volume, 50)
bool  hasVol = nz(volMa) > 0
float rvolMa = hasVol ? volume / volMa : 1.0
float pl     = ta.pivotlow(low, PIV_L, PIV_R)
float ph     = ta.pivothigh(high, PIV_L, PIV_R)
float loPb   = ta.lowest(low, PB_LOOK)
float hiPb   = ta.highest(high, PB_LOOK)
float cMin   = ta.lowest(close, PB_LOOK)
float cMax   = ta.highest(close, PB_LOOK)
float boxHi  = ta.highest(high, SQ_LEN)[1]
float boxLo  = ta.lowest(low, SQ_LEN)[1]
bool  inSess = not useSess or not na(time(timeframe.period, sess))
// Разрыв сессии: ночь, клиринг, выходные
bool  brk    = time - nz(time[1], time) > GAP_BARS * timeframe.in_seconds() * 1000
bool  useTicks = costMode == "тиках" or (costMode == "авто" and syminfo.type == "futures")
float costPx = useTicks ? costTicks * syminfo.mintick : close * costPct / 100

// ───────────────────────────── Память ─────────────────────────────
// Виртуальная сделка: так индикатор проверяет каждый свой сетап.
type VTrade
    float entry
    float sl
    float tp
    int   dir
    int   bucket
    int   bar
    float costR
    bool  shown = false
    label lbl
    line  slLn
    line  tpLn

// Корзины статистики: 3 сетапа × 3 состояния старших ТФ (по тренду / нейтрально / против).
var array<VTrade> vts      = array.new<VTrade>()
var array<float>  stN      = array.new<float>(9, 0.0)   // число сделок (с затуханием)
var array<float>  stS      = array.new<float>(9, 0.0)   // сумма R
var array<float>  stS2     = array.new<float>(9, 0.0)   // сумма R²
var array<float>  stW      = array.new<float>(9, 0.0)   // прибыльные
var array<int>    lastTrig = array.new<int>(6, -1000000)
var float lvlLo       = na
var int   lvlLoBar    = na
var float lvlHi       = na
var int   lvlHiBar    = na
var bool  shownActive = false
var int   sinceBreak  = 1000000
var array<float> todV = array.new<float>(1440, na)   // обычный объём в каждую минуту суток
var array<int>   todC = array.new<int>(1440, 0)
var int   shN         = 0
var int   shW         = 0
var float shR         = 0.0
float lam = 1.0 - 1.0 / memory

// Оценка перевеса корзины: среднее R, стянутое к скептическому априори, минус запас на погрешность.
f_edge(int b) =>
    float n    = array.get(stN, b)
    float s    = array.get(stS, b)
    float s2   = array.get(stS2, b)
    float mean = (s + PRIOR_K * PRIOR_MU) / (n + PRIOR_K)
    float v    = n > 0 ? math.max(s2 / n - math.pow(s / n, 2), 0.25) : 1.0
    float lcb  = mean - zK * math.sqrt(v / (n + PRIOR_K))
    float wr   = (array.get(stW, b) + 1) / (n + 2)
    [lcb, mean, wr, n]

f_setupName(int s) =>
    s == 0 ? "Откат по тренду" : s == 1 ? "Снятие ликвидности" : "Пробой сжатия"

f_ctxName(int c) =>
    c == 0 ? "по старшим ТФ" : c == 1 ? "старшие ТФ нейтральны" : "против старших ТФ"

f_r(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + "R"

f_arrow(float b) =>
    na(b) ? "·" : b > biasThr ? "▲" : b < -biasThr ? "▼" : "◆"

// Кандидаты текущего бара
array<int>   cS  = array.new<int>()
array<int>   cD  = array.new<int>()
array<float> cSL = array.new<float>()

f_add(int s, int d, float sl) =>
    array.push(cS, s)
    array.push(cD, d)
    array.push(cSL, sl)
    true

bool sigLong  = false
bool sigShort = false

// ───────────────────────────── Движок ─────────────────────────────
if barstate.isconfirmed
    // 1) Итоги виртуальных сделок → статистика.
    //    На разрыве сессии всё открытое закрывается по последней цене перед ним.
    sinceBreak := brk ? 0 : sinceBreak + 1
    int xEnd  = brk ? bar_index - 1 : bar_index
    int nOpen = array.size(vts)
    if nOpen > 0
        for i = nOpen - 1 to 0
            VTrade t = array.get(vts, i)
            if bar_index > t.bar or brk
                bool  hitSL = t.dir > 0 ? low <= t.sl : high >= t.sl
                bool  hitTP = t.dir > 0 ? high >= t.tp : low <= t.tp
                float dist  = math.abs(t.entry - t.sl)
                float r     = na
                if brk
                    r := t.dir * (close[1] - t.entry) / dist
                else if hitSL     // стоп и тейк в одном баре — считаем стоп
                    r := -1.0
                else if hitTP
                    r := rr
                else if bar_index - t.bar >= maxBars
                    r := t.dir * (close - t.entry) / dist
                if not na(r)
                    r -= t.costR
                    array.set(stN,  t.bucket, array.get(stN,  t.bucket) * lam + 1)
                    array.set(stS,  t.bucket, array.get(stS,  t.bucket) * lam + r)
                    array.set(stS2, t.bucket, array.get(stS2, t.bucket) * lam + r * r)
                    array.set(stW,  t.bucket, array.get(stW,  t.bucket) * lam + (r > 0 ? 1 : 0))
                    if t.shown
                        shN += 1
                        shW += r > 0 ? 1 : 0
                        shR += r
                        shownActive := false
                        if not na(t.lbl)
                            label.set_text(t.lbl, label.get_text(t.lbl) + "\n" + (r > 0 ? "✓ " : "✗ ") + f_r(r))
                        if not na(t.slLn)
                            line.set_x2(t.slLn, xEnd)
                            line.set_x2(t.tpLn, xEnd)
                    array.remove(vts, i)
                else if t.shown and not na(t.slLn)
                    line.set_x2(t.slLn, bar_index)
                    line.set_x2(t.tpLn, bar_index)

    // 2) Уровни ликвидности — подтверждённые локальные минимумы и максимумы
    if not na(pl)
        lvlLo    := pl
        lvlLoBar := bar_index
    if not na(ph)
        lvlHi    := ph
        lvlHiBar := bar_index

    // 3) Относительный объём — к обычному объёму в ЭТУ минуту суток
    //    (открытие и закрытие сессии не путаются с тихой серединой дня)
    int   slot    = hour(time) * 60 + minute(time)
    float todPrev = array.get(todV, slot)
    float rvol    = rvolMa
    if hasVol and array.get(todC, slot) >= TOD_MIN and nz(todPrev) > 0
        rvol := volume / todPrev
    if hasVol and not na(volume)
        array.set(todV, slot, na(todPrev) ? volume : todPrev + TOD_ALPHA * (volume - todPrev))
        array.set(todC, slot, array.get(todC, slot) + 1)

    if bar_index >= WARMUP and sinceBreak >= AFTER_GAP and not na(bias) and not na(atr1) and not na(atrL)
        // 4) Поиск сетапов
        bool trendUp = emaF > emaS and emaS > emaS[5]
        bool trendDn = emaF < emaS and emaS < emaS[5]

        if usePb
            if trendUp and loPb <= emaF + PB_TOUCH * atr1 and cMin > emaS and close > high[1] and clv > 0.6 and close > emaF
                f_add(0, 1, loPb - SL_BUF * atr1)
            if trendDn and hiPb >= emaF - PB_TOUCH * atr1 and cMax < emaS and close < low[1] and clv < 0.4 and close < emaF
                f_add(0, -1, hiPb + SL_BUF * atr1)

        if useSw and rng > 0
            if not na(lvlLo) and bar_index - lvlLoBar <= LVL_AGE and low < lvlLo and close > lvlLo and math.min(open, close) - low >= SW_WICK * rng and (not hasVol or rvol >= SW_RVOL)
                f_add(1, 1, low - SL_BUF * atr1)
                lvlLo := na
            if not na(lvlHi) and bar_index - lvlHiBar <= LVL_AGE and high > lvlHi and close < lvlHi and high - math.max(open, close) >= SW_WICK * rng and (not hasVol or rvol >= SW_RVOL)
                f_add(1, -1, high + SL_BUF * atr1)
                lvlHi := na

        float bw = boxHi - boxLo
        if useSq and bw <= SQ_K * atrL and (not hasVol or rvol >= SQ_RVOL) and rng > 0 and math.abs(close - open) >= 0.5 * rng
            float mid = (boxHi + boxLo) / 2
            if close > boxHi
                f_add(2, 1, mid - SL_BUF * atr1)
            else if close < boxLo
                f_add(2, -1, mid + SL_BUF * atr1)

        // 5) Каждый сетап — в виртуальную проверку; к показу — лучший с доказанным перевесом
        VTrade best     = na
        float  bestLcb  = na
        float  bestMean = na
        float  bestWr   = na
        float  bestN    = na
        int    bestS    = na
        int    bestCtx  = na
        int    nC       = array.size(cS)
        if nC > 0
            for k = 0 to nC - 1
                int s   = array.get(cS, k)
                int d   = array.get(cD, k)
                int key = s * 2 + (d > 0 ? 0 : 1)
                if bar_index - array.get(lastTrig, key) >= cooldown
                    float dist  = math.max(d * (close - array.get(cSL, k)), slMin * atr1)
                    float costR = costPx / dist
                    if dist <= slMax * atr1 and costR <= maxCostR
                        array.set(lastTrig, key, bar_index)
                        float ctxRaw = bias * d
                        int   ctx    = ctxRaw > biasThr ? 0 : ctxRaw < -biasThr ? 2 : 1
                        int   b      = s * 3 + ctx
                        [lcb, mean, wr, n] = f_edge(b)
                        VTrade t = VTrade.new(close, close - d * dist, close + d * dist * rr, d, b, bar_index, costR)
                        array.push(vts, t)
                        if n >= minN and lcb > minEdge
                            if na(bestLcb) or lcb > bestLcb
                                best     := t
                                bestLcb  := lcb
                                bestMean := mean
                                bestWr   := wr
                                bestN    := n
                                bestS    := s
                                bestCtx  := ctx
                        else if showGray and inSess
                            label.new(bar_index, d > 0 ? low : high, "", style = d > 0 ? label.style_triangleup : label.style_triangledown,
                                 color = C_GRAY, size = size.tiny,
                                 tooltip = f_setupName(s) + ", " + f_ctxName(ctx) + "\nПеревес не доказан: " + f_r(mean) + " на сделку, выборка " + str.tostring(n, "0"))

        // 6) Сигнал
        if not na(best) and inSess and not (oneAtATime and shownActive)
            best.shown  := true
            shownActive := true
            bool   isLong = best.dir > 0
            string side   = isLong ? "▲ BUY" : "▼ SELL"
            string txt    = side + "  " + f_r(bestMean) + "\nSL " + str.tostring(best.sl, format.mintick) + " · TP " + str.tostring(best.tp, format.mintick)
            string tip    = f_setupName(bestS) + ", " + f_ctxName(bestCtx) +
                 "\nВход: " + str.tostring(best.entry, format.mintick) +
                 "\nСтоп: " + str.tostring(best.sl, format.mintick) +
                 "\nТейк: " + str.tostring(best.tp, format.mintick) +
                 "\nОжидание: " + f_r(bestMean) + " на сделку после издержек" +
                 "\nДоля прибыльных: " + str.tostring(bestWr * 100, "0") + "%" +
                 "\nВыборка: " + str.tostring(bestN, "0") + " похожих сделок"
            best.lbl := label.new(bar_index, isLong ? low : high, txt, style = isLong ? label.style_label_up : label.style_label_down,
                 color = isLong ? C_LONG : C_SHORT, textcolor = color.white, size = size.small, tooltip = tip)
            if showLevels
                best.slLn := line.new(bar_index, best.sl, bar_index + 1, best.sl, color = C_SL, style = line.style_dashed)
                best.tpLn := line.new(bar_index, best.tp, bar_index + 1, best.tp, color = C_TP, style = line.style_dashed)
            sigLong  := isLong
            sigShort := not isLong
            alert("EDGE " + side + " " + syminfo.ticker + " @ " + str.tostring(best.entry, format.mintick) +
                 " | SL " + str.tostring(best.sl, format.mintick) + " | TP " + str.tostring(best.tp, format.mintick) +
                 " | " + f_setupName(bestS) + ", " + f_ctxName(bestCtx) + " | " + f_r(bestMean), alert.freq_once_per_bar_close)

alertcondition(sigLong,  "EDGE: покупка", "EDGE ▲ BUY {{ticker}} @ {{close}}")
alertcondition(sigShort, "EDGE: продажа", "EDGE ▼ SELL {{ticker}} @ {{close}}")

// ───────────────────────────── Панель (по желанию) ─────────────────────────────
var table panel = table.new(position.top_right, 2, 7, bgcolor = C_PANEL, border_width = 0, frame_width = 0)
if showPanel and barstate.islast
    // Лучшая корзина сейчас
    float topLcb = na
    int   topB   = -1
    for b = 0 to 8
        [lcb, mean, wr, n] = f_edge(b)
        if n >= minN and (na(topLcb) or lcb > topLcb)
            topLcb := lcb
            topB   := b
    string topTxt = "мало данных"
    if topB >= 0
        [lcb, mean, wr, n] = f_edge(topB)
        topTxt := f_setupName(int(topB / 3)) + ", " + f_ctxName(topB % 3) + ": " + f_r(mean)
    string status = shownActive ? "сигнал в работе" : (topB >= 0 and topLcb > minEdge ? "ждёт сетап" : "перевеса нет — молчит")
    table.cell(panel, 0, 0, "EDGE", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 0, status, text_color = C_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 1, "Старшие ТФ", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 1, tf1 + " " + f_arrow(b1) + "  " + tf2 + " " + f_arrow(b2) + "  " + tf3 + " " + f_arrow(b3), text_color = C_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 2, "Показано сигналов", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 2, str.tostring(shN), text_color = C_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 3, "Прибыльных", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 3, shN > 0 ? str.tostring(100.0 * shW / shN, "0") + "%" : "—", text_color = C_TEXT, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 4, "Итог по сигналам", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 4, shN > 0 ? f_r(shR) : "—", text_color = shR >= 0 ? C_LONG : C_SHORT, text_size = size.small, text_halign = text.align_right)
    table.cell(panel, 0, 5, "Лучший сетап", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 5, topTxt, text_color = C_TEXT, text_size = size.small, text_halign = text.align_right)
    float costShare = atr1 > 0 ? 100 * costPx / atr1 : na
    table.cell(panel, 0, 6, "Издержки / средняя свеча", text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, 6, na(costShare) ? "—" : str.tostring(costShare, "0") + "%", text_color = nz(costShare) <= 15 ? C_LONG : nz(costShare) <= 30 ? C_TEXT : C_SHORT, text_size = size.small, text_halign = text.align_right)
