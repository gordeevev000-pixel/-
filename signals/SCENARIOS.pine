//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  СЦЕНАРИИ ДНЯ — внутридневные сигналы для товаров и индексов (1–15 минут)
//
//  На графике только итог: ЛОНГ или ШОРТ, вход, стоп и выход. Анализ спрятан.
//
//  Как индикатор думает. Каждая сессия может пойти по одному из сценариев:
//    • трендовый день вверх или вниз — цена уходит от диапазона открытия и
//      держится там до закрытия;
//    • двусторонний день (ротация) — пробой одной стороны, затем возврат
//      и пробой другой; трендовые входы в такие дни теряют.
//  Минутные данные 2018–2026 и исследования (Крэбел, Zarattini–Aziz, Baltussen и др.)
//  показали: направление остатка дня по свечам не угадывается, а вот ВЕРОЯТНОСТЬ
//  трендового сценария поднимают четыре условия, известные к моменту пробоя:
//      1. сжатие накануне — вчерашний диапазон самый узкий из 4 или из 7 дней;
//      2. гэп в сторону пробоя;
//      3. открытие за вчерашним максимумом (минимумом) в сторону пробоя;
//      4. дневной тренд — вчерашнее закрытие по ту же сторону от средней 20 закрытий.
//  Сигнал: первое закрытие за диапазоном первых 15/30 минут, если сценарий
//  «трендовый день» набрал нужное число условий и издержки не съедают риск.
//  Стоп — противоположная граница диапазона открытия, выход — в конце сессии.
//
//  Сжатие и дневной тренд считаются по 30-минутным барам через request.security:
//  у них своя длинная история, поэтому индикатор работает и на минутке, где
//  TradingView грузит всего несколько дней. Значения берутся с закрытого бара.
//
//  Проверка (SCENARIOS.md): средний результат после издержек около +0.03…+0.08R
//  на сделку в обоих периодах, но доверительные интервалы захватывают ноль —
//  преимущество статистически НЕ доказано. На нефти на 2023–2026 — минус.
//  Без перерисовки: всё решается на закрытой свече.
// ═════════════════════════════════════════════════════════════════════════════
indicator("Сценарии дня — внутридневные сигналы", shorttitle = "Сценарии дня", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// НАСТРОЙКИ
// ─────────────────────────────────────────────────────────────────────────────
const string G1 = "Рынок"
const string G2 = "Сценарий"
const string G3 = "Отображение"

const string M_AUTO = "Авто"
const string M_OWN  = "Своя сессия"

string mktIn   = input.string(M_AUTO, "Рынок", options = [M_AUTO, "S&P 500", "Nasdaq 100", "Dow", "DAX", "Золото", "Серебро", "Нефть WTI", "Нефть Brent", "Газ", M_OWN], group = G1, tooltip = "Авто — по тикеру: фьючерсы ES, MES, NQ, MNQ, YM, FDAX, GC, MGC, SI, CL, MCL, BZ, BRN, NG и CFD вроде US500, SPX500, NAS100, US100, US30, GER40, DE40, XAUUSD, XAGUSD, USOIL, WTI, UKOIL, BRENT, BCO, NATGAS.\nОт рынка зависят часы основной сессии и типичные издержки.")
string ownSess = input.session("0930-1600", "Своя сессия", group = G1, tooltip = "Для «Своя сессия» и нераспознанных тикеров. Сессия должна умещаться в одни сутки. Для своей сессии обязательно укажите издержки.")
string ownTz   = input.string("America/New_York", "Часовой пояс своей сессии", group = G1)
float  costIn  = input.float(0.0, "Издержки на круг, пункты", minval = 0.0, step = 0.01, group = G1, tooltip = "Спред + комиссия + проскальзывание за вход и выход вместе, в пунктах цены. Лучше указать свои.\n0 — типичные для CFD и микрофьючерсов, как доля цены. При ценах 2026 года это: S&P 500 ≈ 0.9 · Nasdaq ≈ 2.5 · Dow ≈ 4.5 · DAX ≈ 2.5 · золото ≈ 0.60 $ · серебро ≈ 0.05 $ · WTI ≈ 0.06 $ · Brent ≈ 0.065 $ · газ ≈ 0.012 $.")

string orIn     = input.string("30 минут", "Диапазон открытия", options = ["15 минут", "30 минут"], group = G2)
string strictIn = input.string("Сбалансированный", "Строгость отбора", options = ["Агрессивный", "Сбалансированный", "Консервативный"], group = G2, tooltip = "Сколько из 4 условий трендового дня нужно для сигнала: 2 / 3 / 4.")
float  costPct  = input.float(10.0, "Издержки не больше, % риска", minval = 1.0, maxval = 50.0, step = 1.0, group = G2, tooltip = "Если спред и комиссия больше этой доли от расстояния до стопа — сигнал пропускается. Главный фильтр для маленьких таймфреймов.")
int    cutoff   = input.int(240, "Пробой не позже, минут после открытия", minval = 30, step = 30, group = G2)
bool   allowL   = input.bool(true, "Лонги", inline = "dir", group = G2)
bool   allowS   = input.bool(true, "Шорты", inline = "dir", group = G2)

bool   showLv   = input.bool(true, "Вход и стоп открытой сделки", group = G3)
bool   showExit = input.bool(true, "Метки выхода", group = G3)
bool   showDay  = input.bool(false, "Разбор дня (панель)", group = G3, tooltip = "Маленькая панель: какой сценарий сейчас складывается и почему есть или нет сигнала.")
bool   showStat = input.bool(false, "Статистика по истории", group = G3)
string sizeIn   = input.string("Обычный", "Размер меток", options = ["Мелкий", "Обычный", "Крупный"], group = G3)
color  cBuy     = input.color(#089981, "Лонг", inline = "col", group = G3)
color  cSell    = input.color(#F23645, "Шорт", inline = "col", group = G3)

// ─────────────────────────────────────────────────────────────────────────────
// РЫНОК: часы основной сессии в часовом поясе биржи и типичные издержки
// ─────────────────────────────────────────────────────────────────────────────
has(string s, string sub) =>
    str.contains(s, sub)

detectMarket() =>
    string t  = str.upper(syminfo.ticker)
    string r  = str.upper(syminfo.root)
    string ty = syminfo.type
    string res = M_OWN
    if ty == "futures"
        // у фьючерсов — только по корню контракта
        res := r == "ES" or r == "MES" ? "S&P 500" : r == "NQ" or r == "MNQ" ? "Nasdaq 100" : r == "YM" or r == "MYM" ? "Dow" : r == "FDAX" or r == "FDXM" or r == "FDXS" ? "DAX" : r == "GC" or r == "MGC" ? "Золото" : r == "SI" or r == "SIL" ? "Серебро" : r == "CL" or r == "MCL" or r == "QM" ? "Нефть WTI" : r == "BZ" or r == "BRN" ? "Нефть Brent" : r == "NG" or r == "QG" or r == "MNG" ? "Газ" : M_OWN
    else if ty == "cfd" or ty == "index" or ty == "commodity" or ty == "forex" or ty == "spot"
        // CFD, индексы, спот: по названию; акции и фонды не распознаются вовсе
        if (has(t, "XAU") and t != "XAU") or has(t, "GOLD")
            res := "Золото"
        else if has(t, "XAG") or has(t, "SILVER")
            res := "Серебро"
        else if has(t, "BRENT") or has(t, "UKOIL") or has(t, "XBR") or has(t, "BCO")
            res := "Нефть Brent"
        else if has(t, "WTI") or has(t, "USOIL") or has(t, "XTI") or has(t, "CRUDE")
            res := "Нефть WTI"
        else if has(t, "NATGAS") or has(t, "NATURALGAS") or (has(t, "XNG") and t != "XNG") or has(t, "NGAS")
            res := "Газ"
        else if has(t, "NAS100") or has(t, "NDX") or has(t, "US100") or has(t, "USTEC") or has(t, "NSX") or has(t, "NASDAQ")
            res := "Nasdaq 100"
        else if has(t, "US30") or has(t, "DJI") or has(t, "WS30") or has(t, "DJ30")
            res := "Dow"
        else if (has(t, "DAX") and not has(t, "MDAX") and not has(t, "SDAX") and not has(t, "TECDAX")) or has(t, "DE40") or has(t, "GER40") or has(t, "DE30") or has(t, "GER30") or has(t, "DEU40") or has(t, "DEU30") or has(t, "GRX")
            res := "DAX"
        else if has(t, "SPX") or has(t, "US500") or has(t, "SP500")
            res := "S&P 500"
    res

mktParams(string m) =>
    string s = ownSess
    string z = ownTz
    float  k = 0.0
    string cur = ""
    switch m
        "S&P 500" =>
            s := "0930-1600"
            z := "America/New_York"
            k := 0.9 / 7400
            cur := "USD"
        "Nasdaq 100" =>
            s := "0930-1600"
            z := "America/New_York"
            k := 2.5 / 28600
            cur := "USD"
        "Dow" =>
            s := "0930-1600"
            z := "America/New_York"
            k := 4.5 / 45000
            cur := "USD"
        "DAX" =>
            s := "0900-1730"
            z := "Europe/Berlin"
            k := 2.5 / 25000
            cur := "EUR"
        "Золото" =>
            s := "0820-1330"
            z := "America/New_York"
            k := 0.60 / 4500
            cur := "USD"
        "Серебро" =>
            s := "0825-1325"
            z := "America/New_York"
            k := 0.05 / 73
            cur := "USD"
        "Нефть WTI" =>
            s := "0900-1430"
            z := "America/New_York"
            k := 0.06 / 84
            cur := "USD"
        "Нефть Brent" =>
            s := "0900-1430"
            z := "America/New_York"
            k := 0.065 / 91
            cur := "USD"
        "Газ" =>
            s := "0900-1430"
            z := "America/New_York"
            k := 0.012 / 3.5
            cur := "USD"
    // k — типичные издержки на круг в долях цены; годятся, только если цена в валюте рынка
    // (XAUEUR, XAUJPY — нет)
    [s, z, cur == "" or syminfo.currency == cur ? k : 0.0]

string mkt = mktIn == M_AUTO ? detectMarket() : mktIn
[sessStr, tzStr, defPct] = mktParams(mkt)

int   openMin  = int(str.tonumber(str.substring(sessStr, 0, 2))) * 60 + int(str.tonumber(str.substring(sessStr, 2, 4)))
int   closeMin = int(str.tonumber(str.substring(sessStr, 5, 7))) * 60 + int(str.tonumber(str.substring(sessStr, 7, 9)))
int   orW      = orIn == "15 минут" ? 15 : 30
int   minScore = strictIn == "Агрессивный" ? 2 : strictIn == "Консервативный" ? 4 : 3
bool  costOk   = costIn > 0 or defPct > 0
int   slotsExp = (int(math.ceil(closeMin / 30.0)) * 30 - int(openMin / 30) * 30) / 30
bool  tested   = mkt != "Dow" and mkt != "Газ" and mkt != M_OWN
int   step     = math.max(1, int(timeframe.in_seconds() / 60))
bool  tfOk     = timeframe.isintraday and not timeframe.isseconds and timeframe.in_seconds() <= 900
string lblSize = sizeIn == "Мелкий" ? size.small : sizeIn == "Крупный" ? size.large : size.normal

// ─────────────────────────────────────────────────────────────────────────────
// ДНЕВНОЙ КОНТЕКСТ ПО 30-МИНУТНЫМ БАРАМ: сжатие (NR4/NR7) и средняя 20 закрытий
// Сессия — все 30-минутные бары, пересекающие её часы. Считаются только
// завершённые и полные сессии (не меньше 90 % слотов: короткие дни и дыры в данных
// не идут в расчёт); на график берётся значение последнего закрытого бара.
// ─────────────────────────────────────────────────────────────────────────────
htfContext() =>
    var array<float> rr = array.new<float>()
    var array<float> cc = array.new<float>()
    var int   key  = -1
    var bool  live = false
    var int   nb   = 0
    var int   lastT = na
    var float h = na
    var float l = na
    var float c = na
    int  slots = (int(math.ceil(closeMin / 30.0)) * 30 - int(openMin / 30) * 30) / 30
    int  t   = hour(time, tzStr) * 60 + minute(time, tzStr)
    int  dw  = dayofweek(time, tzStr)
    int  k   = year(time, tzStr) * 10000 + month(time, tzStr) * 100 + dayofmonth(time, tzStr)
    bool ins = t < closeMin and t + 30 > openMin and dw >= dayofweek.monday and dw <= dayofweek.friday
    // дыра в данных больше недели — история до неё не годится
    if ins and not na(lastT) and time - lastT > 6 * 86400000
        rr.clear()
        cc.clear()
        live := false
    if live and (k != key or not ins)
        if nb >= 0.9 * slots
            rr.push(h - l)
            cc.push(c)
        live := false
    if ins
        if not live
            key  := k
            h    := high
            l    := low
            live := true
            nb   := 0
        else
            h := math.max(h, high)
            l := math.min(l, low)
        c  := close
        nb += 1
        lastT := time
        if t + 30 >= closeMin
            if nb >= 0.9 * slots
                rr.push(h - l)
                cc.push(c)
            live := false
    if rr.size() > 30
        rr.shift()
        cc.shift()
    int   n    = rr.size()
    bool  comp = n >= 7 and (rr.get(n - 1) <= rr.slice(n - 4, n).min() or rr.get(n - 1) <= rr.slice(n - 7, n).min())
    float sma  = cc.size() >= 20 ? cc.slice(cc.size() - 20, cc.size()).avg() : na
    [comp[1], sma[1]]

[hComp, hSma] = request.security(syminfo.tickerid, "30", htfContext(), lookahead = barmerge.lookahead_on)

// Ролловер непрерывного фьючерса: разница между скорректированным и сырым рядом
// меняется ровно в день смены контракта. Цена открытия дня известна с его начала.
bool   contFut = syminfo.type == "futures" and str.endswith(syminfo.ticker, "!")
string tkAdj   = ticker.modify(syminfo.tickerid, backadjustment = backadjustment.on)
string tkRaw   = ticker.modify(syminfo.tickerid, backadjustment = backadjustment.off)
float  dAdj    = request.security(tkAdj, "D", open, lookahead = barmerge.lookahead_on)
float  dRaw    = request.security(tkRaw, "D", open, lookahead = barmerge.lookahead_on)
float  adjOff  = dAdj - dRaw
float  dChart  = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
// график уже с обратной корректировкой? 1 — да, -1 — нет, 0 — пока не ясно (не было ролловера)
var int chartAdj = 0
if contFut and not na(adjOff) and math.abs(adjOff) > syminfo.mintick / 2
    chartAdj := math.abs(dChart - dAdj) < syminfo.mintick / 2 ? 1 : math.abs(dChart - dRaw) < syminfo.mintick / 2 ? -1 : chartAdj

// ─────────────────────────────────────────────────────────────────────────────
// ВРЕМЯ БАРА В ЧАСОВОМ ПОЯСЕ БИРЖИ
// ─────────────────────────────────────────────────────────────────────────────
int  tod  = hour(time, tzStr) * 60 + minute(time, tzStr)
int  dow  = dayofweek(time, tzStr)
int  dKey = year(time, tzStr) * 10000 + month(time, tzStr) * 100 + dayofmonth(time, tzStr)
bool inS  = tfOk and tod >= openMin and tod < closeMin and dow >= dayofweek.monday and dow <= dayofweek.friday

// ─────────────────────────────────────────────────────────────────────────────
// СОСТОЯНИЕ
// ─────────────────────────────────────────────────────────────────────────────
var float pH = na
var float pL = na
var float pC = na
var float sOpen = na
var float sH = na
var float sL = na
var float sC = na
var int   sSlots = 0
var int   sLastSlot = -1
var int   sStart = na
var bool  pFull = false
var float orH = na
var float orL = na
var bool  orReady = false
var bool  done = false
var int   firstDir = 0
var bool  twoSided = false
var bool  rollDay = false
var float lastOff = na
var int   curKey = -1
var string dayNote = ""

var int   pos = 0
var int   eBar = na
var float entry = na
var float stop = na
var float risk = na
var float eCost = 0.0

var int   nTr = 0
var int   nWin = 0
var float sumR = 0.0
var float grW = 0.0
var float grL = 0.0

var box   bxRisk = na
var line  lnE = na
var line  lnS = na
var label lbE = na
var label lbS = na

fmt(float p) =>
    str.tostring(p, format.mintick)

hhmm(int mins) =>
    str.format("{0}:{1}", str.tostring(int(mins / 60), "00"), str.tostring(mins % 60, "00"))

mark(bool ok) =>
    ok ? "✓ " : "✗ "

// статистика сигналов по числу условий на 2018–2022 (7 рынков, ТФ 1/5/15 мин, после издержек)
histLine(int sc, int w) =>
    string res = ""
    if not tested
        res := "на этом рынке не проверялось — нет минутных данных"
    else if w == 30
        res := sc == 2 ? "в плюс 45%, средний +0.02R" : sc == 3 ? "в плюс 47%, средний +0.05R" : "в плюс 46%, средний +0.06R"
    else
        res := sc == 2 ? "в плюс 41%, средний +0.02R" : sc == 3 ? "в плюс 44%, средний +0.06R" : "в плюс 42%, средний +0.05R"
    res

// ─────────────────────────────────────────────────────────────────────────────
// ГЛАВНЫЙ ЦИКЛ — только на закрытой свече
// ─────────────────────────────────────────────────────────────────────────────
int    sig     = 0
int    exitD   = 0
float  exitR   = na
float  exitPx  = na
string exitWhy = ""

closeTrade(float px, string why) =>
    [(px - entry) * pos / risk, px, why]

if barstate.isconfirmed
    // ── 0. Сессия кончилась раньше обычного (короткий день) — выход по открытию следующего бара
    if pos != 0 and (not inS or dKey != curKey)
        [r0, p0, w0] = closeTrade(open, "Конец сессии")
        exitR   := r0
        exitPx  := p0
        exitWhy := w0
        exitD   := pos
        pos     := 0

    if inS
        // ── 1. Новая сессия: итоги вчерашней, проверка ролловера
        if dKey != curKey
            if curKey != -1
                pH    := sH
                pL    := sL
                pC    := sC
                pFull := sSlots >= 0.9 * slotsExp and time - sStart <= 6 * 86400000
            sSlots    := 0
            sLastSlot := -1
            sStart    := time
            curKey  := dKey
            sOpen   := open
            sH      := high
            sL      := low
            orH     := high
            orL     := low
            orReady  := false
            done     := false
            firstDir := 0
            twoSided := false
            rollDay := contFut and not na(adjOff) and not na(lastOff) and math.abs(adjOff - lastOff) > syminfo.mintick / 2
            lastOff := adjOff
            dayNote := rollDay ? "Ролловер фьючерса — гэп ложный, день без сигнала" : "Ждём диапазон первых " + str.tostring(orW) + " минут"
        else
            sH := math.max(sH, high)
            sL := math.min(sL, low)
        sC := close
        if int(tod / 30) != sLastSlot
            sSlots    += 1
            sLastSlot := int(tod / 30)
        int  m    = tod - openMin
        bool skip = false

        // ── 2. Диапазон открытия
        if not orReady
            if m < orW
                orH := math.max(orH, high)
                orL := math.min(orL, low)
            if m + step >= orW
                orReady := true
                skip    := true                       // бар, закрывший окно, сам сигналом не бывает
                if not rollDay and not na(hSma)
                    int up = (hComp ? 1 : 0) + (sOpen > pC ? 1 : 0) + (sOpen > pH ? 1 : 0) + (pC > hSma ? 1 : 0)
                    int dn = (hComp ? 1 : 0) + (sOpen < pC ? 1 : 0) + (sOpen < pL ? 1 : 0) + (pC < hSma ? 1 : 0)
                    dayNote := "Тренд вверх: " + str.tostring(up) + " из 4 · вниз: " + str.tostring(dn) + " из 4 · ждём пробой"

        if not skip
            bool isLast = tod + step >= closeMin
            // ── 3. Сопровождение: стоп или конец сессии
            if pos != 0
                float S  = stop * pos
                float lo = pos == 1 ? low : -high
                if lo <= S
                    [r1, p1, w1] = closeTrade(math.min(S, open * pos) * pos, "Стоп")
                    exitR   := r1
                    exitPx  := p1
                    exitWhy := w1
                    exitD   := pos
                    pos     := 0
                else if isLast
                    [r2, p2, w2] = closeTrade(close, "Конец сессии")
                    exitR   := r2
                    exitPx  := p2
                    exitWhy := w2
                    exitD   := pos
                    pos     := 0
            // ── 4. Оценка сценария на первом пробое диапазона открытия
            else if not done and orReady and m <= cutoff and not isLast
                int d = close > orH ? 1 : close < orL ? -1 : 0
                if d != 0
                    done     := true
                    firstDir := d
                    string up = d == 1 ? "вверх" : "вниз"
                    if rollDay
                        dayNote := "Пробой " + up + " в день ролловера — без сигнала"
                    else if na(hSma)
                        dayNote := "Пробой " + up + " — мало истории для условий"
                    else if not pFull
                        dayNote := "Пробой " + up + " — вчерашняя сессия неполная или давняя, уровни ненадёжны, без сделки"
                    else
                        bool  gapAl   = math.sign(sOpen - pC) == d
                        bool  openAl  = d == 1 ? sOpen > pH : sOpen < pL
                        bool  trendAl = math.sign(pC - hSma) == d
                        int   score   = (hComp ? 1 : 0) + (gapAl ? 1 : 0) + (openAl ? 1 : 0) + (trendAl ? 1 : 0)
                        float st      = d == 1 ? orL : orH
                        float rk      = (close - st) * d
                        float cost    = costIn > 0 ? costIn : defPct * close
                        bool  okDir   = d == 1 ? allowL : allowS
                        if not costOk
                            dayNote := "Пробой " + up + " — укажите издержки в настройках"
                        else if score < minScore
                            dayNote := "Пробой " + up + ": условий " + str.tostring(score) + " из 4 — двусторонний день вероятнее, без сделки"
                        else if rk <= 0 or cost > costPct / 100 * rk
                            dayNote := "Пробой " + up + ": стоп слишком близко, издержки больше " + str.tostring(costPct) + "% риска"
                        else if not okDir
                            dayNote := "Пробой " + up + " — это направление выключено"
                        else
                            pos   := d
                            eBar  := bar_index
                            entry := close
                            stop  := st
                            risk  := rk
                            eCost := cost / rk
                            sig   := d
                            dayNote := "Трендовый день " + up + ": условий " + str.tostring(score) + " из 4 — сделка"
                            bool   L   = d == 1
                            string tip = "Сценарий: трендовый день " + up + " (" + mkt + ")" + "\nУсловия: " + str.tostring(score) + " из 4" + "\n  " + mark(hComp) + "сжатие накануне (NR4/NR7)" + "\n  " + mark(gapAl) + "гэп " + up + "\n  " + mark(openAl) + "открытие " + (L ? "выше вчерашнего максимума" : "ниже вчерашнего минимума") + "\n  " + mark(trendAl) + "дневной тренд " + up + "\nНа истории такие сигналы: " + histLine(score, orW) + "\n\nВход: " + fmt(entry) + "\nСтоп: " + fmt(stop) + " — граница диапазона первых " + str.tostring(orW) + " минут" + "\nВыход: в конце сессии, " + hhmm(closeMin) + " (" + tzStr + "); в короткий день — по открытию следующего бара" + "\nИздержки: " + str.tostring(eCost * 100, "0.0") + "% риска"
                            label.new(bar_index, close, L ? "ЛОНГ" : "ШОРТ", yloc = L ? yloc.belowbar : yloc.abovebar, style = L ? label.style_label_up : label.style_label_down, color = L ? cBuy : cSell, textcolor = color.white, size = lblSize, tooltip = tip)
                            if showLv
                                int x2 = bar_index + 10
                                bxRisk := box.new(bar_index, L ? entry : stop, x2, L ? stop : entry, border_width = 0, bgcolor = color.new(cSell, 85))
                                lnE := line.new(bar_index, entry, x2, entry, color = color.gray, width = 1)
                                lnS := line.new(bar_index, stop, x2, stop, color = cSell, width = 2)
                                lbE := label.new(x2, entry, "Вход " + fmt(entry), style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
                                lbS := label.new(x2, stop, "Стоп " + fmt(stop), style = label.style_label_left, color = cSell, textcolor = color.white, size = size.small)
                            alert((L ? "ЛОНГ " : "ШОРТ ") + syminfo.ticker + " | трендовый день " + up + ", условий " + str.tostring(score) + " из 4 | Вход " + fmt(entry) + " | Стоп " + fmt(stop) + " | Выход в " + hhmm(closeMin), alert.freq_once_per_bar_close)
            else if not done and orReady and m > cutoff
                done    := true
                dayNote := "Пробоя за " + str.tostring(cutoff) + " минут после открытия не было — сегодня без сделки"
            // двусторонний день: после первого пробоя цена закрылась за другой границей
            if firstDir != 0 and not twoSided and pos == 0 and ((firstDir == 1 and close < orL) or (firstDir == -1 and close > orH))
                twoSided := true
                dayNote  := "Сложился двусторонний день: пробиты обе границы диапазона"

    // ── 5. Закрытие сделки: статистика, метка, уборка уровней
    if not na(exitR)
        float net = exitR - eCost
        nTr  += 1
        nWin += net > 0 ? 1 : 0
        sumR += net
        grW  += math.max(net, 0.0)
        grL  += math.max(-net, 0.0)
        string res = str.tostring(net, "+0.0;-0.0") + "R"
        dayNote := "Сделка закрыта: " + str.lower(exitWhy) + ", " + res
        if showExit
            label.new(bar_index, exitPx, "✕ " + res, yloc = exitD == 1 ? yloc.abovebar : yloc.belowbar, style = label.style_none, textcolor = net > 0 ? cBuy : net < 0 ? cSell : color.gray, size = size.small, tooltip = "Выход: " + exitWhy + "\nЦена: " + fmt(exitPx) + "\nИтог после издержек: " + res + "\nДо издержек: " + str.tostring(exitR, "+0.00;-0.00") + "R")
        alert((exitD == 1 ? "ЛОНГ " : "ШОРТ ") + syminfo.ticker + " — выход: " + exitWhy + " " + fmt(exitPx) + ", итог " + res, alert.freq_once_per_bar_close)
        box.delete(bxRisk)
        line.delete(lnE)
        line.delete(lnS)
        label.delete(lbE)
        label.delete(lbS)

    // Уровни открытой сделки тянутся за ценой
    if pos != 0 and showLv and bar_index > eBar
        int x2 = bar_index + 10
        box.set_right(bxRisk, x2)
        line.set_x2(lnE, x2)
        line.set_x2(lnS, x2)
        label.set_x(lbE, x2)
        label.set_x(lbS, x2)

// ─────────────────────────────────────────────────────────────────────────────
// АЛЕРТЫ, ПОДСКАЗКИ, СТАТИСТИКА
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(sig == 1, "Сценарии дня: лонг", "ЛОНГ {{ticker}} {{interval}}, вход ≈ {{close}}")
alertcondition(sig == -1, "Сценарии дня: шорт", "ШОРТ {{ticker}} {{interval}}, вход ≈ {{close}}")
alertcondition(not na(exitR), "Сценарии дня: выход", "Выход {{ticker}} {{interval}} ≈ {{close}}")

if barstate.islast
    array<string> w = array.new<string>()
    if not tfOk
        w.push("Индикатор рассчитан на таймфреймы 1–15 минут")
    if mkt == M_OWN and mktIn == M_AUTO and costIn == 0
        w.push("Рынок не распознан по тикеру — выберите его в настройках или задайте свою сессию и издержки")
    else if not costOk
        w.push("Укажите издержки на круг в настройках — без них сигналов не будет")
    if tfOk and na(hSma)
        w.push("Мало истории 30-минутных баров для условий дня")
    if contFut and chartAdj == -1
        w.push("Непрерывный фьючерс без обратной корректировки: включите B-ADJ, иначе дневной тренд искажён ролловерами")
    if mkt == "Нефть WTI" or mkt == "Нефть Brent"
        w.push("Нефть: на данных 2023–2026 сигналы были в минусе")
    if not tested and mkt != M_OWN
        w.push(mkt + ": на истории не проверялось — нет минутных данных")
    if w.size() > 0
        var table tw = table.new(position.bottom_right, 1, 1)
        table.cell(tw, 0, 0, w.join("\n"), text_color = color.gray, text_size = size.small, text_halign = text.align_right)

if barstate.islast and showDay
    var table td = table.new(position.top_left, 1, 2, bgcolor = color.new(color.black, 30))
    table.cell(td, 0, 0, mkt + " · сессия " + hhmm(openMin) + "–" + hhmm(closeMin) + " (" + tzStr + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(td, 0, 1, inS ? dayNote : curKey == -1 ? "Вне сессии" : "Вне сессии. Последнее: " + dayNote, text_color = color.white, text_size = size.small, text_halign = text.align_left)

if barstate.islast and showStat
    var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
    table.cell(tb, 0, 0, "Сделок", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(nTr), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "В плюс", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, nTr > 0 ? str.tostring(100.0 * nWin / nTr, "0") + "%" : "—", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Средняя, R (после издержек)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, nTr > 0 ? str.tostring(sumR / nTr, "+0.00;-0.00") : "—", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Итого, R", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(sumR, "+0.0;-0.0"), text_color = sumR >= 0 ? cBuy : cSell, text_size = size.small)
    table.cell(tb, 0, 4, "Профит-фактор", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, grL > 0 ? str.tostring(grW / grL, "0.00") : "—", text_color = color.white, text_size = size.small)
